#!/usr/bin/env python3
"""lares-bridge -- the laptop <-> phone bridge (docs/contracts/bridge.md).

    lares-bridge watch                      one JSON line per change of the picture (devices, links, mounts, jobs) until TERM
    lares-bridge state                      the first line of `watch`, then exit

  Every other call prints ONE JSON line on stdout ({"ok": true, ...} or {"ok": false, "reason", "hint"}); <dev> is a device key:
    mirror <dev> [--mode mirror|desktop|camera|audio] [--screen-off] [--record]     stop <job id>
    mount <dev> usb|wifi      unmount <dev> usb|wifi      send <dev> [--via adb|kdeconnect] <path>...      shot <dev>
    ring <dev>   clip <dev>   key <dev> power|volup|voldown   pair|accept|reject|unpair <dev>   refresh   wifipair <dev> [cancel]   castprep <dev> [--unlock] [--hold]   castend <dev> [--sleep] | --all
    arm <dev>   disarm <dev>  set <dev> <pref> <json value>   select <dev>   facts <dev>   ack <job id>
    usbcalm <dev> [off|on]   (off: the phone keeps USB as it is at an unlock; on: File transfer at every unlock, the phone's own default)
    lockstate <dev>   pin <dev> set (the PIN as one line on stdin) | forget   unlock <dev> [--auto]   (the PIN lives in the login keyring)
    doctor [--plain]

  Internal (the tool starts these itself): _run <id> -- <argv...> (a job's wrapper), _plug <dev>, _adbidle, _pairwait <dev> <name>.

Exit status: 0 done, 1 failed, 2 usage, 3 not available (a program, the daemon or the device is not there), 4 refused.
Overrides for tests: LARES_BRIDGE_CONFIG / _STATE / _RUNTIME / _SYS, DBUS_SESSION_BUS_ADDRESS, PATH (see bridgelib/state.py).
"""
import os
import sys
import time

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from bridgelib import actions, adbctl, doctor, jobs, model, trace  # noqa: E402
from bridgelib import state as st  # noqa: E402
from bridgelib import watch as watchlib  # noqa: E402

TOOL = os.path.abspath(__file__)


def say(obj, code):
    sys.stdout.write(st.dumps(obj) + "\n")
    sys.stdout.flush()
    return code


def usage(text):
    sys.stderr.write("lares-bridge: %s\n" % text)
    return say({"ok": False, "reason": text, "hint": "see `lares-bridge` in tools/bridge/lares-bridge's header"}, actions.USAGE)


def cmd_run(paths, args):
    if len(args) < 3 or args[1] != "--":
        return usage("usage: _run <id> -- <argv...>")
    return jobs.run_wrapper(paths, args[0], args[2:])


def cmd_plug(paths, cfg, args):
    """The tool's own answer to a phone coming onto the cable: the adb server, and Keep wireless ready (arm) when it is on."""
    ctx = actions.Ctx(paths, cfg, TOOL)
    up, _err = adbctl.need(paths, cfg, TOOL)
    if not up or not args:
        return 0
    dev = next((d for d in ctx.refresh()["devices"] if d["key"] == args[0]), None)
    if dev and dev["prefs"]["keepWireless"]:
        for _ in range(25):
            dev = next((d for d in ctx.refresh()["devices"] if d["key"] == args[0]), None)
            if dev and dev["can"]["arm"]["ok"] and dev["adb"] and dev["adb"]["state"] == "device":
                actions.cmd_arm(ctx, [args[0]])
                break
            import time
            time.sleep(0.4)
    return 0


def main(argv):
    if not argv or argv[0] in ("-h", "--help", "help"):
        sys.stderr.write(__doc__)
        return 0 if argv else actions.USAGE
    cmd, args = argv[0], argv[1:]
    paths = st.Paths()
    trace.DEFAULT = paths
    cfg, _err = st.load_config(paths)
    if cmd == "watch":
        return watchlib.run(paths, TOOL)
    if cmd == "_run":
        return cmd_run(paths, args)
    if cmd == "_adbidle":
        adbctl.idle_reaper(paths)
        return 0
    if cmd == "_plug":
        return cmd_plug(paths, cfg, args)
    if cmd == "_pairwait":
        if len(args) != 2 or not os.environ.get("LARES_PAIR_PW"):
            return usage("usage: _pairwait <dev> <name> (the password in LARES_PAIR_PW)")
        return actions.pair_wait(paths, cfg, TOOL, args[0], args[1], os.environ["LARES_PAIR_PW"])
    if cmd not in ("state", "doctor") and cmd not in actions.COMMANDS:
        return usage("unknown command: %s" % cmd)
    paths.ensure()
    ctx = actions.Ctx(paths, cfg, TOOL)
    if cmd == "state":
        return say(model.public(ctx.refresh(), 1), 0)
    if cmd == "doctor":
        if args not in ([], ["--plain"]):
            return usage("usage: doctor [--plain]")
        ans, code = actions.cmd_doctor(ctx, [])
        if args:
            sys.stdout.write("\n".join(doctor.plain(ans["rows"])) + "\n")
            return 0 if ans["ok"] else 1
        return say(ans, code)
    fn = actions.COMMANDS[cmd]
    t0 = time.time()
    try:
        ans, code = fn(ctx, args)
    except actions.Stop as s:
        ans, code = {"ok": False, "reason": s.reason, "hint": s.hint}, s.code
    trace.write(paths, "call", cmd=cmd, args=args, code=code, ms=int((time.time() - t0) * 1000), answer=ans)
    if not ans.get("ok") and ans.get("reason"):
        sys.stderr.write("lares-bridge: %s\n" % ans["reason"])
    return say(ans, code)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))

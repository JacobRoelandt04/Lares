#!/usr/bin/env bash
# `iw` for tools/dev/aerial_rig_probe.sh: the real card's `iw` would read the USER's network namespace, where the rig's radios are not.
# The rig (tools/aerial/rig/rig, inner) publishes what only its namespace can see into $AERIAL_RIG_PUB every 0.5 s; this replays it:
#   iw dev <if> link          -> iw_link.txt          iw dev <if> station dump  -> iw_station.txt          iw reg get  -> iw_reg.txt
# Nothing here writes anything but the log, and nothing reaches the machine's iw.
echo "$*" >> "$AERIAL_STUB_DIR/iw.log"
show() { cat "$AERIAL_RIG_PUB/$1" 2> /dev/null; exit 0; }
if [ "$1" = dev ] && [ "$3" = link ]; then show iw_link.txt; fi
if [ "$1" = dev ] && [ "$3" = station ] && [ "$4" = dump ]; then show iw_station.txt; fi
if [ "$1" = reg ] && [ "$2" = get ]; then show iw_reg.txt; fi
echo "stub iw (rig): unexpected $*" >&2; exit 2

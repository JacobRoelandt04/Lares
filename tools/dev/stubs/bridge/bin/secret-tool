#!/usr/bin/env python3
"""A stand-in for `secret-tool` (libsecret): a file-backed store ($BRIDGE_SECRET_FILE, JSON) for tools/dev/bridge_tool_probe.sh.

    secret-tool store --label=L attr value ...   the secret is read from STDIN
    secret-tool lookup attr value ...            the secret on stdout (no newline), exit 1 when there is none
    secret-tool clear attr value ...

Logs the call's ARGV to $BRIDGE_STUB_LOG as `secret-tool <argv>` (the secret is never in an argv, so never there), and, like the real one with
a locked keyring (it would prompt), refuses with exit 1 and logs `secret-tool LOCKED-ACCESS` when the world's keyring.locked is true.
Never touches a real keyring.
"""
import json
import os
import sys

STORE = os.environ.get("BRIDGE_SECRET_FILE", "")
LOG = os.environ.get("BRIDGE_STUB_LOG", "")
WORLD = os.environ.get("BRIDGE_WORLD", "")
if not STORE:
    sys.exit("secret-tool stub: BRIDGE_SECRET_FILE is not set; refusing to run")

a = sys.argv[1:]
if LOG:
    with open(LOG, "a") as f:
        f.write("secret-tool " + " ".join(a) + "\n")
try:
    locked = bool(json.load(open(WORLD)).get("keyring", {}).get("locked"))
except (OSError, ValueError):
    locked = False
if locked:
    if LOG:
        with open(LOG, "a") as f:
            f.write("secret-tool LOCKED-ACCESS\n")
    sys.exit(1)
try:
    db = json.load(open(STORE))
except (OSError, ValueError):
    db = {}
verb, rest = (a[0] if a else ""), a[1:]
rest = [x for x in rest if not x.startswith("--label=")]
key = json.dumps(dict(zip(rest[0::2], rest[1::2])), sort_keys=True)
if verb == "store":
    db[key] = sys.stdin.read()
    json.dump(db, open(STORE, "w"))
elif verb == "lookup":
    if key not in db:
        sys.exit(1)
    sys.stdout.write(db[key])
elif verb == "clear":
    db.pop(key, None)
    json.dump(db, open(STORE, "w"))
else:
    sys.exit(2)

    { "fn": "identityOf", "args": ["$twinA", ["$twinA", "$twinB"]], "want": "Dell Inc. DELL P2419H @DP-1", "note": "two identical monitors" },
    { "fn": "identityOf", "args": ["$twinA", ["$twinA"]], "want": "Dell Inc. DELL P2419H" },
    { "fn": "setKeyOf", "args": [["b", "B", "a", "LG"]], "want": "B + LG + a + b", "note": "bytes, never locale: ARM jslocale / luastrcoll" },
    { "fn": "setOf", "args": [["$lg", "$edp", "$hop"]], "want": "Acme Displays ACME ULTRAWIDE 0x0000C0DE + Samsung Display Corp. 0x4180", "note": "the hop never counts: ARM nohop" },

    { "fn": "portKind", "args": ["DVI-I-1", "evdi"], "want": "displaylink", "lang": "js" },
    { "fn": "portKind", "args": ["DP-3", "i915"], "want": "usbc", "lang": "js" },
    { "fn": "labelOf", "args": ["$edp", null], "want": "Laptop", "lang": "js" },
    { "fn": "labelOf", "args": ["$lg", null], "want": "DisplayLink · ACME ULTRAWIDE", "lang": "js" },
    { "fn": "labelOf", "args": ["$proj", null], "want": "HDMI", "lang": "js", "note": "nothing to call it but the port" },
    { "fn": "labels", "args": [["$twinA", "$twinB"], null], "want": { "DP-1": "USB-C · DELL P2419H", "DP-2": "USB-C · DELL P2419H 2" }, "lang": "js" },

    { "fn": "snapScale", "args": [1.1, 1920, 1080], "want": 1.2, "note": "FACT F5: a tie goes upward (ARM snapdown)" },
    { "fn": "snapScale", "args": [1.3, 1920, 1080], "want": 1.3333333333333333, "note": "FACT F5" },
    { "fn": "snapScale", "args": [1.75, 1920, 1080], "want": 1.6666666666666667, "note": "FACT F5" },
    { "fn": "snapScale", "args": [1.6, 1920, 1080], "want": 1.6 },
    { "fn": "snapScale", "args": [1.25, 2880, 1620], "want": 1.25 },
    { "fn": "snapScale", "args": [1.647, 3840, 2160], "want": 1.6666666666666667 },
    { "fn": "scaleChoices", "args": [1920, 1080], "want": [1, 1.2, 1.25, 1.3333333333333333, 1.5, 1.6, 1.6666666666666667, 1.875, 2, 2.4, 2.5, 2.6666666666666665, 3] },

    { "fn": "physicalScale", "args": ["$lg", 3440, 1440, "$edp"], "want": 1, "note": "a desk monitor would match at 0.64: the floor (decision 30, ARM nofloor)" },
    { "fn": "physicalScale", "args": ["$port4k", 3840, 2160, "$edp"], "want": 1.6666666666666667, "note": "a dense 15.6-inch 4K: 1.647 snapped" },
    { "fn": "physicalScale", "args": ["$tv", 1920, 1080, "$edp"], "want": "auto", "note": "55 inches: a TV" },
    { "fn": "physicalScale", "args": ["$proj", 1280, 800, "$edp"], "want": "auto", "note": "no size" },
    { "fn": "physicalScale", "args": ["$lg", 3440, 1440, null], "want": "auto" },

    { "fn": "logicalSize", "args": [2880, 1620, 1.25, 0], "want": { "w": 2304, "h": 1296 } },
    { "fn": "logicalSize", "args": [3440, 1440, 1, 1], "want": { "w": 1440, "h": 3440 } },
    { "fn": "defaultPosition", "args": [{ "w": 3440, "h": 1440 }, { "x": 0, "y": 0, "w": 2304, "h": 1296 }, [{ "x": 0, "y": 0, "w": 2304, "h": 1296 }]], "want": [-568, -1440] },
    { "fn": "defaultPosition", "args": [{ "w": 1920, "h": 1080 }, { "x": 0, "y": 0, "w": 2304, "h": 1296 }, [{ "x": 0, "y": 0, "w": 2304, "h": 1296 }, { "x": -568, "y": -1440, "w": 3440, "h": 1440 }]], "want": [192, -2520], "note": "on top of what already stands above" },

    { "fn": "resolve", "args": [["$uw34"], null], "note": "a machine with no internal panel, a display never seen: the preferred size at its fastest refresh, its place 0,0, every workspace (ARM nofast)",
      "wantSubset": { "kind": "default", "unknown": ["Acme Displays ACME UW34 #ACME00000001"], "specs": { "DP-1": { "enabled": true, "mode": "3440x1440@120", "scale": "auto", "position": [0, 0], "mirror": "" } },
        "split": { "1": "DP-1", "2": "DP-1", "3": "DP-1", "4": "DP-1" } } },
    { "fn": "resolve", "args": [["$uw34"], "$dataUw34"], "note": "a saved mode is the user's, fast or not",
      "wantSubset": { "kind": "setup", "unknown": [], "specs": { "DP-1": { "mode": "3440x1440@100", "scale": 1 } }, "split": { "1": "DP-1", "4": "DP-1" } } },
    { "fn": "resolve", "args": [["$uw34"], "$dataUw34Off"], "note": "the safety rule with no internal panel; a mirror of nothing is dropped",
      "wantSubset": { "specs": { "DP-1": { "enabled": true, "mirror": "" } } } },
    { "fn": "resolve", "args": [["$uw34", "$dell"], null], "note": "two displays and no internal panel: the first is home (1-2), the other takes 3-4 (ARM homeextern)",
      "wantSubset": { "specs": { "HDMI-A-1": { "mode": "preferred" } }, "split": { "1": "DP-1", "2": "DP-1", "3": "HDMI-A-1", "4": "HDMI-A-1" } } },
    { "fn": "resolve", "args": [["$castOut", "$uw34"], null], "note": "a cast and no internal panel: the real display is home (1-2) whatever the order, the cast is the external (3-4)",
      "wantSubset": { "specs": { "DP-1": { "mode": "3440x1440@120" }, "LARES-CAST-1": { "enabled": true, "mode": "1920x1080@60", "scale": 1 } }, "split": { "1": "DP-1", "2": "DP-1", "3": "LARES-CAST-1", "4": "LARES-CAST-1" } } },
    { "fn": "resolve", "args": [["$edp", "$uw34"], "$dataLaptop"], "note": "beside a laptop's panel the preferred mode stands",
      "wantSubset": { "kind": "grown", "specs": { "DP-1": { "mode": "preferred", "scale": 1 } }, "split": { "1": "eDP-1", "2": "eDP-1", "3": "DP-1", "4": "DP-1" } } },
    { "fn": "resolve", "args": [["$edp"], "$dataLaptop"], "wantSubset": { "kind": "setup", "name": "Laptop", "unknown": [],
      "specs": { "eDP-1": { "enabled": true, "mode": "2880x1620@120", "position": [0, 0], "scale": 1.25, "bitdepth": 10, "mirror": "" } },
      "split": { "1": "eDP-1", "2": "eDP-1", "3": "eDP-1", "4": "eDP-1" } } },
    { "fn": "resolve", "args": [["$edp", "$lg"], "$dataLaptop"], "wantSubset": { "kind": "grown", "unknown": ["Acme Displays ACME ULTRAWIDE 0x0000C0DE"],
      "specs": { "eDP-1": { "position": [0, 0], "scale": 1.25 }, "DVI-I-1": { "enabled": true, "mode": "preferred", "position": [-568, -1440], "scale": 1, "mirror": "" } },
      "split": { "1": "eDP-1", "2": "eDP-1", "3": "DVI-I-1", "4": "DVI-I-1" } }, "note": "never seen: above, centred, floor scale, takes 3-4 (decisions 3, 30, 31)" },
    { "fn": "resolve", "args": [["$edp", "$lg"], "$dataDesk"], "wantSubset": { "kind": "setup", "name": "Desk", "unknown": [],
      "specs": { "DVI-I-1": { "position": [-280, -1440], "mode": "3440x1440@59.97" } },
      "split": { "1": "eDP-1", "2": "eDP-1", "3": "DVI-I-1", "4": "DVI-I-1" } } },
    { "fn": "resolve", "args": [["$edp", "$lg", "$tv"], "$dataDesk"], "wantSubset": { "kind": "grown", "base": "Acme Displays ACME ULTRAWIDE 0x0000C0DE + Samsung Display Corp. 0x4180",
      "unknown": ["Sony SONY TV *00"],
      "specs": { "DVI-I-1": { "position": [-280, -1440] }, "HDMI-A-1": { "scale": "auto", "position": [192, -2520] } },
      "split": { "1": "eDP-1", "2": "eDP-1", "3": "DVI-I-1", "4": "HDMI-A-1" } }, "note": "the known pair stays; the TV stacks on top and gets the free workspace" },
    { "fn": "resolve", "args": [["$edp", "$lg", "$hop"], "$dataDesk"], "wantSubset": { "kind": "setup", "name": "Desk" }, "note": "ARM nohop" },
    { "fn": "resolve", "args": [["$edp", "$lg"], "$dataOnlyExternal"], "wantSubset": {
      "specs": { "eDP-1": { "enabled": false }, "DVI-I-1": { "enabled": true } },
      "split": { "1": "DVI-I-1", "2": "DVI-I-1", "3": "DVI-I-1", "4": "DVI-I-1" } } },
    { "fn": "resolve", "args": [["$edp"], "$dataOnlyExternal"], "wantSubset": { "kind": "default", "specs": { "eDP-1": { "enabled": true, "bitdepth": 10, "position": [0, 0] } } },
      "note": "the dock unplugged: the panel comes back with its own settings" },
    {"fn": "resolve", "args": [["$edp", "$lg"], "$dataDeskOff"], "note": "a stored off is the setup's word (a PLUG switches it on: the engine's rule, not resolve's)", "wantSubset": {"kind": "setup", "specs": {"DVI-I-1": {"enabled": false}}, "split": {"3": "eDP-1", "4": "eDP-1"}}},
    {"fn": "resolve", "args": [["$edp", "$lg", "$tv"], "$dataDeskOff"], "note": "a set that grows starts with its externals on: the base's off was said of another set (ARM grownoff)", "wantSubset": {"kind": "grown", "specs": {"DVI-I-1": {"enabled": true}, "HDMI-A-1": {"enabled": true}}}},
    { "fn": "resolve", "args": [["$edp", "$lg"], "$dataDeskMirror"], "wantSubset": { "kind": "setup", "specs": { "DVI-I-1": { "mirror": "eDP-1", "enabled": true } }, "split": { "1": "eDP-1", "2": "eDP-1", "3": "eDP-1", "4": "eDP-1" } }, "note": "a mirror trial: the workspaces the mirror held all stand on the laptop; the revert's data (the Desk case above) gives them back" },
    { "fn": "resolve", "args": [["$edp", "$lg"], "$dataDeskSplit1"], "wantSubset": { "specs": { "DVI-I-1": { "mirror": "" } }, "split": { "1": "DVI-I-1", "2": "eDP-1", "3": "DVI-I-1", "4": "DVI-I-1" } }, "note": "a PARTIAL stored split {1: the external} reproduces a staged chip: the rest is the defaults (the shell stores only what differs)" },
    { "fn": "liveDiff", "args": [{ "name": "DVI-I-1", "enabled": true, "width": 3440, "height": 1440, "refresh": 59.97, "x": -280, "y": -1440, "scale": 1, "transform": 0, "mirrorOf": "eDP-1" }, { "enabled": true, "mode": "3440x1440@59.97", "position": [-280, -1440], "scale": 1, "transform": 0, "mirror": "", "vrr": 0, "bitdepth": 8, "cm": "srgb" }], "want": "mirror", "note": "a mirror that must end differs by the mirror, whatever else is equal (a revert sends the un-mirror rule)" },
    { "fn": "liveDiff", "args": [{ "name": "DVI-I-1", "enabled": true, "width": 3440, "height": 1440, "refresh": 59.97, "x": -280, "y": -1440, "scale": 1, "transform": 0, "mirrorOf": "" }, { "enabled": true, "mode": "3440x1440@59.97", "position": [-280, -1440], "scale": 1, "transform": 0, "mirror": "eDP-1", "vrr": 0, "bitdepth": 8, "cm": "srgb" }], "want": "mirror" },
    { "fn": "liveDiff", "args": [{ "name": "DVI-I-1", "enabled": true, "width": 1280, "height": 720, "refresh": 30, "x": 9, "y": 9, "scale": 2, "transform": 0, "mirrorOf": "eDP-1" }, { "enabled": true, "mode": "3440x1440@59.97", "position": [-280, -1440], "scale": 1, "transform": 0, "mirror": "eDP-1", "vrr": 0, "bitdepth": 8, "cm": "srgb" }], "want": "", "note": "an output that mirrors as asked is settled: its own mode, place and scale do not count" },
    { "fn": "resolve", "args": [["$edp", "$tv"], "$dataMirror"], "wantSubset": { "kind": "setup",
      "specs": { "HDMI-A-1": { "mirror": "eDP-1", "enabled": true } },
      "split": { "1": "eDP-1", "2": "eDP-1", "3": "eDP-1", "4": "eDP-1" } } },
    { "fn": "resolve", "args": [["$edp"], "$dataAllOff"], "wantSubset": { "specs": { "eDP-1": { "enabled": true } } }, "note": "the safety rule" },
    { "fn": "resolve", "args": [["$edp"], null], "wantSubset": { "kind": "default", "specs": { "eDP-1": { "mode": "2880x1620@120", "scale": 1.25, "bitdepth": 10 } } },
      "note": "no data: a never-seen internal keeps what it is" },

    { "fn": "bindPlaceholders", "args": ["$dataImported", ["$edp", "$lg"]], "wantSubset": { "bound": [{ "from": "port:DVI-I-1", "to": "Acme Displays ACME ULTRAWIDE 0x0000C0DE" }],
      "data": { "split": { "3": "Acme Displays ACME ULTRAWIDE 0x0000C0DE" },
                "setups": { "Acme Displays ACME ULTRAWIDE 0x0000C0DE + Samsung Display Corp. 0x4180": { "outputs": { "Acme Displays ACME ULTRAWIDE 0x0000C0DE": { "position": [-280, -1440] } } } } } } },
    { "fn": "bindPlaceholders", "args": ["$dataImported", ["$edp"]], "wantSubset": { "bound": [] } },

    { "fn": "liveDiff", "args": ["$edp", { "enabled": true, "mode": "2880x1620@120", "position": [0, 0], "scale": 1.25, "transform": 0, "mirror": "", "vrr": 0, "bitdepth": 10, "cm": "srgb" }], "want": "", "note": "ARM nodedup" },
    { "fn": "liveDiff", "args": ["$edp", { "enabled": true, "mode": "2880x1620@120", "position": [0, 0], "scale": 1.5, "transform": 0, "mirror": "", "vrr": 0, "bitdepth": 10, "cm": "srgb" }], "want": "scale" },
    { "fn": "liveDiff", "args": ["$edp", { "enabled": true, "mode": "2880x1620@60", "position": [0, 0], "scale": 1.25, "transform": 0, "mirror": "", "vrr": 0, "bitdepth": 10, "cm": "srgb" }], "want": "refresh" },
    { "fn": "liveDiff", "args": ["$edp", { "enabled": true, "mode": "preferred", "position": [0, 0], "scale": "auto", "transform": 0, "mirror": "", "vrr": 0, "bitdepth": 10, "cm": "srgb" }], "want": "" },
    { "fn": "liveDiff", "args": ["$edp", { "enabled": false }], "want": "enabled" },
    { "fn": "liveDiff", "args": [{ "name": "eDP-1", "enabled": true, "width": 2880, "height": 1620, "refresh": 120.0, "x": 0, "y": 0, "scale": 1.25, "transform": 0, "mirrorOf": "", "bitdepth": 0, "modes": [] },
      { "enabled": true, "mode": "2880x1620@120", "position": [0, 0], "scale": 1.25, "transform": 0, "mirror": "", "vrr": 0, "bitdepth": 10, "cm": "srgb" }], "want": "", "note": "the Lua reader has no bit depth: never a reason to re-send" },
    { "fn": "verify", "args": [["$edp"], { "specs": { "eDP-1": { "enabled": true, "mode": "2880x1620@120", "position": [0, 0], "scale": 1.25, "transform": 0, "mirror": "", "bitdepth": 10 } } }], "want": { "ok": true, "what": "" } },
    { "fn": "verify", "args": [["$edp"], { "specs": { "eDP-1": { "enabled": true, "mode": "2880x1620@120", "position": [0, 0], "scale": 1.25, "transform": 0, "mirror": "" }, "DP-1": { "enabled": true, "mode": "preferred", "position": [0, 0], "scale": 1 } } }], "want": { "ok": false, "what": "DP-1:gone" } },
    { "fn": "luaRule", "args": ["DVI-I-1", { "enabled": true, "mode": "preferred", "position": [-568, -1440], "scale": 1, "transform": 0, "mirror": "", "vrr": 0, "bitdepth": 8, "cm": "srgb", "sdrbrightness": 1, "sdrsaturation": 1 }],
      "want": "{ output = \"DVI-I-1\", disabled = false, mode = \"preferred\", position = \"-568x-1440\", scale = 1, transform = 0, mirror = \"\", vrr = 0, bitdepth = 8, cm = \"srgb\", sdrbrightness = 1, sdrsaturation = 1 }", "lang": "js" },

    { "fn": "diagnose", "args": [{ "now": 20000, "gpuMode": "integrated", "drm": { "connectors": [] } }], "wantSubset": [{ "id": "hdmi-nvidia" }], "lang": "js" },
    { "fn": "diagnose", "args": [{ "now": 20000, "drm": { "connectors": [], "displayLinkUsb": true, "displayLinkSince": 1000, "displayLinkActive": false } }], "wantSubset": [{ "id": "dl-service", "command": "sudo systemctl enable --now displaylink.service" }], "lang": "js" },
    { "fn": "diagnose", "args": [{ "now": 5000, "drm": { "connectors": [], "displayLinkUsb": true, "displayLinkSince": 1000, "displayLinkActive": false } }], "want": [], "lang": "js", "note": "8 s grace while the dock comes up" },
    { "fn": "diagnose", "args": [{ "now": 20000, "outputs": [], "connectedSince": { "DP-2": 1000 }, "drm": { "connectors": [{ "name": "DP-2", "driver": "i915", "status": "connected" }] } }], "wantSubset": [{ "id": "off-DP-2", "action": "enable", "output": "DP-2" }], "lang": "js" },
    { "fn": "diagnose", "args": [{ "now": 20000, "verdict": "failed:DVI-I-1:refresh", "drm": { "connectors": [] } }], "wantSubset": [{ "id": "mode-failed", "severity": "error" }], "lang": "js" },
    {"fn": "identityOf", "args": ["$castOut", ["$edp", "$castOut"]], "want": "cast:wfd:02:AE:00:00:0A:01", "note": "a cast output is its device's identity, not headless:<name>"},
    {"fn": "identityOf", "args": ["$castStray", ["$edp", "$castStray"]], "want": "headless:LARES-CAST-1", "note": "a LARES-CAST output the engine has no identity for is a plain headless one (it is swept)"},
    {"fn": "isCast", "args": ["LARES-CAST-1"], "want": true},
    {"fn": "isCast", "args": ["LARES-CAST-x"], "want": false},
    {"fn": "isCast", "args": ["LOCK-1"], "want": false},
    {"fn": "resolve", "args": [["$edp", "$castOut"], "$dataLaptop"], "note": "a never-seen cast: extended, 1080p60, scale 1, centred above the laptop, workspaces 3 and 4 like any external", "wantSubset": {"kind": "grown", "unknown": ["cast:wfd:02:AE:00:00:0A:01"], "specs": {"LARES-CAST-1": {"enabled": true, "mode": "1920x1080@60", "scale": 1, "position": [192, -1080], "mirror": ""}, "eDP-1": {"enabled": true, "position": [0, 0], "mirror": ""}}, "split": {"1": "eDP-1", "2": "eDP-1", "3": "LARES-CAST-1", "4": "LARES-CAST-1"}}},
    {"fn": "resolve", "args": [["$edp", "$lg", "$castOut"], "$dataDesk"], "note": "a real external beside the cast, nothing stored: the real one picks first", "wantSubset": {"specs": {"LARES-CAST-1": {"enabled": true, "mirror": "", "mode": "1920x1080@60", "scale": 1}}, "split": {"1": "eDP-1", "2": "eDP-1", "3": "DVI-I-1", "4": "LARES-CAST-1"}}},
    {"fn": "resolve", "args": [["$edp", "$lock3", "$castOut"], "$dataLaptop"], "note": "a real external and a cast, nothing stored: the real one picks first (3), the cast takes the next (4)", "wantSubset": {"split": {"1": "eDP-1", "2": "eDP-1", "3": "LOCK-3", "4": "LARES-CAST-1"}}},
    {"fn": "resolve", "args": [["$edp", "$castOut"], "$dataCast"], "note": "a remembered TV: its place, its quality extras", "wantSubset": {"kind": "setup", "unknown": [], "specs": {"LARES-CAST-1": {"position": [192, -1080], "cast": {"res": "1280x720", "fps": 60, "bitrate": "16M", "audio": false}, "mirror": ""}}}},
    {"fn": "resolve", "args": [["$edp", "$castOut"], "$dataCastMirror"], "note": "mirror on a cast: the spec says mirror of the laptop (the keeper's to read), and while its output still exists it is a display like before (never a mirror, never off: ARM castmirror)", "wantSubset": {"specs": {"LARES-CAST-1": {"mirror": "eDP-1"}, "eDP-1": {"mirror": ""}}, "split": {"1": "eDP-1", "2": "eDP-1", "3": "LARES-CAST-1", "4": "LARES-CAST-1"}}},
    {"fn": "resolve", "args": [["$edp", "$lock3"], "$dataLaptop"], "note": "another foreign headless output behaves as ever: a plain external with the preferred mode, auto scale, workspaces 3-4", "wantSubset": {"specs": {"LOCK-3": {"mode": "preferred", "scale": "auto", "mirror": ""}}, "split": {"1": "eDP-1", "2": "eDP-1", "3": "LOCK-3", "4": "LOCK-3"}}},
    {"fn": "liveDiff", "args": ["$castOut", {"enabled": true, "mode": "1920x1080@60", "position": [192, -1080], "scale": 1, "transform": 0, "vrr": 0, "bitdepth": 8, "cm": "srgb", "mirror": "eDP-1"}], "want": "", "note": "a cast output whose spec says mirror is as asked while it is on and no mirror (ARM castmirror)"},
    {"fn": "liveDiff", "args": ["$castOutOff", {"enabled": true, "mode": "1920x1080@60", "position": [192, -1080], "scale": 1, "transform": 0, "vrr": 0, "bitdepth": 8, "cm": "srgb", "mirror": "eDP-1"}], "want": "enabled", "note": "a cast output that is off is never as asked (it could not be removed)"},
    {"fn": "liveDiff", "args": ["$castOutOff", {"enabled": false, "mode": "1920x1080@60", "position": [192, -1080], "scale": 1, "transform": 0, "vrr": 0, "bitdepth": 8, "cm": "srgb", "mirror": ""}], "want": "enabled", "note": "a cast output is never switched off, whatever its spec says (ARM castoff)"},
    {"fn": "liveDiff", "args": ["$castOut", {"enabled": true, "mode": "1920x1080@60", "position": [192, -1080], "scale": 1, "transform": 0, "vrr": 0, "bitdepth": 8, "cm": "srgb", "mirror": ""}], "want": "", "note": "an unmirrored cast on its place is as asked"},
    {"fn": "portKind", "args": ["LARES-CAST-1", ""], "want": "cast", "lang": "js"},
    {"fn": "labelOf", "args": ["$castOut"], "want": "Cast", "lang": "js"},
    {"fn": "luaRule", "args": ["LARES-CAST-1", {"enabled": true, "mode": "1920x1080@60", "position": [192, -1080], "scale": 1, "transform": 0, "mirror": "eDP-1"}], "want": "{ output = \"LARES-CAST-1\", disabled = false, mode = \"1920x1080@60\", position = \"192x-1080\", scale = 1, transform = 0, mirror = \"\", vrr = 0, bitdepth = 8, cm = \"srgb\", sdrbrightness = 1, sdrsaturation = 1 }", "lang": "js", "note": "a cast output's rule never says disabled and never mirror"},
    {"fn": "specChanges", "args": [{"enabled": true, "mode": "a", "position": [0, 0], "scale": 1, "transform": 0, "mirror": false, "vrr": 0, "bitdepth": 8, "cm": "srgb", "sdrbrightness": 1, "sdrsaturation": 1}, {"enabled": true, "mode": "a", "position": [0, 0], "scale": 1, "transform": 0, "mirror": false, "vrr": 0, "bitdepth": 8, "cm": "srgb", "sdrbrightness": 1, "sdrsaturation": 1, "cast": {"fps": 60}}], "want": ["cast"], "lang": "js"}
  ]

// Installed by silicon's install.sh (remove it with install.sh --uninstall).
//
// user -- and only while on the active local session -- may run the silicon root helper
// (org.quickshell.silicon.helper: that one program, /usr/local/libexec/silicon-helper) without
// a password. Nobody else, no other action. The helper checks every value it is given against
// the kernel's own lists and ranges, writes only a fixed whitelist of power knobs and reads
// each write back, so what this rule hands over is: change the CPU profile and the power
// caps (lowering them only), set the charge limit to 80 or 100, queue a GPU mode change.
polkit.addRule(function(action, subject) {
    if (action.id == "org.quickshell.silicon.helper" &&
        subject.user == "user" &&
        subject.active && subject.local) {
        return polkit.Result.YES;
    }
});

{{- if .isLaptop -}}
general {
    # qs-shell deploy BEGIN lock: every lock is the Lares lock (from its snapshot), and sleep waits until the session IS locked
    lock_cmd = /home/user/.local/state/lares/lock/current/tools/lockscreen/lares-lock-session
    before_sleep_cmd = command -v screentimed >/dev/null && screentimed ctl sleep; /home/user/.local/state/lares/lock/current/tools/lockscreen/lares-lock-session
    inhibit_sleep = 3
    # qs-shell deploy END lock
    # qs-shell deploy: lock_cmd = pidof hyprlock || hyprlock
    # qs-shell deploy: before_sleep_cmd = command -v screentimed >/dev/null && screentimed ctl sleep; pidof hyprlock || hyprlock
    after_sleep_cmd = command -v screentimed >/dev/null && screentimed ctl wake
    ignore_dbus_inhibit = false
    ignore_systemd_inhibit = false
    # qs-shell deploy: inhibit_sleep = 0
}

# Screentime: no input for 120 s is "away", and those 120 s are removed (backdated).
# A video holding an inhibitor never goes idle, so it keeps counting.
listener {
    timeout = 120
    on-timeout = command -v screentimed >/dev/null && screentimed ctl idle 120
    on-resume = command -v screentimed >/dev/null && screentimed ctl active
}

# Screentime: idle that something blocks (the waybar caffeine button, a video, a long task)
# still ends after 30 min without input. Until then it counts; nothing is backdated.
listener {
    timeout = 1800
    ignore_inhibit = true
    on-timeout = command -v screentimed >/dev/null && screentimed ctl idle 0
    on-resume = command -v screentimed >/dev/null && screentimed ctl active
}

# qs-shell deploy BEGIN idle: idle "off" dims in the shell itself, like soft (120 s, 180 s), so hypridle no longer does; it still suspends at 240 s
# qs-shell deploy END idle
# qs-shell deploy: listener {
    # qs-shell deploy: timeout = 120
    # qs-shell deploy: on-timeout = bash ~/.config/hypr/scripts/brightness.sh --pre-idle
    # qs-shell deploy: on-resume = bash ~/.config/hypr/scripts/brightness.sh --resume
# qs-shell deploy: }

# qs-shell deploy: listener {
    # qs-shell deploy: timeout = 180
    # qs-shell deploy: on-timeout = bash ~/.config/hypr/scripts/brightness.sh --idle
    # qs-shell deploy: on-resume = bash ~/.config/hypr/scripts/brightness.sh --resume
# qs-shell deploy: }

listener {
    timeout = 240 
    # qs-shell deploy: on-timeout = bash ~/.config/hypr/scripts/brightness.sh --resume; systemctl suspend
    # qs-shell deploy BEGIN idle-suspend
    on-timeout = systemctl suspend
    # qs-shell deploy END idle-suspend
}
{{- else -}}
general {
    lock_cmd = notify-send "lock!"          # dbus/sysd lock command (loginctl lock-session)
    unlock_cmd = notify-send "unlock!"      # same as above, but unlock
    before_sleep_cmd = notify-send "Zzz"    # command ran before sleep
    after_sleep_cmd = notify-send "Awake!"  # command ran after sleep
    ignore_dbus_inhibit = false             # whether to ignore dbus-sent idle-inhibit requests (used by e.g. firefox or steam)
    ignore_systemd_inhibit = false          # whether to ignore systemd-inhibit --what=idle inhibitors
}

listener {
    timeout = 1000                            # in seconds
    on-timeout = systemctl suspend # command to run when timeout has passed
    on-resume = notify-send "Welcome back!"  # command to run when activity is detected after timeout has fired.
}
{{- end -}}
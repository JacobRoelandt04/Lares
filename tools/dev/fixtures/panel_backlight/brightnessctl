#!/usr/bin/env bash
# A stand-in for brightnessctl in tools/dev/panel_backlight_probe.sh over a FAKE sysfs: $PB_SYS/class/backlight/<device>/{brightness,max_brightness}.
# Every call is logged as "<ms> <args>" to $PB_SYS/calls. A call WITHOUT -d (brightnessctl's "first backlight") is logged as BARE and fails
# (exit 9): the shell names the panel's device in every call. A device that is not there is "not found" (exit 1).
sys="${PB_SYS:?}"
echo "$(date +%s%3N) $*" >> "$sys/calls"
class="" dev=""
while [ $# -gt 0 ]; do
    case "$1" in
        -c) class="$2"; shift 2 ;;
        -d) dev="$2"; shift 2 ;;
        -q) shift ;;
        *) break ;;
    esac
done
if [ -z "$dev" ]; then
    echo "BARE $*" >> "$sys/calls"
    echo "brightnessctl called without -d" >&2
    exit 9
fi
d="$sys/class/backlight/$dev"
if [ -n "$class" ] && [ "$class" != backlight ] || [ ! -d "$d" ]; then
    echo "Device '$dev' not found." >&2
    exit 1
fi
case "$1" in
    g) cat "$d/brightness" ;;
    m) cat "$d/max_brightness" ;;
    set) printf '%s\n' "$2" > "$d/brightness" ;;
    *) exit 2 ;;
esac

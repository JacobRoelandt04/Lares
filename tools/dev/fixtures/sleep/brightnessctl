#!/usr/bin/env bash
# A stand-in for brightnessctl in tools/dev/sleep_lockenv_film.sh over a FAKE sysfs: $SLEEP_FADE_DIR/sys/<device>/{brightness,max_brightness}
# for intel_backlight AND nvidia_0. Every call is logged as "<ms> <args>" to $SLEEP_FADE_DIR/calls. Understands -c <class> and -d <device>
# in any order before `g`, `m` and `set N`. Without -d it takes the FIRST backlight, as the real one does -- and here that is nvidia_0, so a
# caller that does not name its device writes the dGPU's (the probe fails on any call that touches it). A device that is not there is
# "not found" (exit 1). $SLEEP_FADE_DIR/slow (a number of ms) makes every call that long.
dir="${SLEEP_FADE_DIR:?}"
echo "$(date +%s%3N) $*" >> "$dir/calls"
[ -r "$dir/slow" ] && sleep "$(awk '{printf "%.3f", $1 / 1000}' "$dir/slow")"
class=""
dev=""
while [ $# -gt 0 ]; do
    case "$1" in
        -c) class="$2"; shift 2 ;;
        -d) dev="$2"; shift 2 ;;
        *) break ;;
    esac
done
[ -z "$dev" ] && dev=nvidia_0
d="$dir/sys/$dev"
if [ -n "$class" ] && [ "$class" != backlight ] || [ ! -d "$d" ]; then
    echo "Device '$dev' not found." >&2
    exit 1
fi
case "$1" in
    g) cat "$d/brightness" ;;
    m) cat "$d/max_brightness" ;;
    set) printf '%s\n' "$2" > "$d/brightness" ;;
    *) exit 2 ;;
esac

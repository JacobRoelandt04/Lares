#!/usr/bin/env bash
# Stub xrandr: Xwayland's listing as the spike saw it (CAST.md: LARES-CAST-1 is listed by xrandr).
# With $CAST_WORLD/xr_after = N the output LARES-CAST-1 is listed from the Nth call on (a just-created output reaches Xwayland late).
n=999
if [ -n "${CAST_WORLD:-}" ] && [ -f "$CAST_WORLD/xr_after" ]; then
    echo x >> "$CAST_WORLD/xr_calls"; n=$(wc -l < "$CAST_WORLD/xr_calls"); after=$(cat "$CAST_WORLD/xr_after")
    if [ "$n" -lt "$after" ]; then
        printf 'Screen 0: minimum 16 x 16, current 2880 x 1620, maximum 32767 x 32767\nXWAYLAND0 connected primary 2880x1620+0+0 (normal) 0mm x 0mm\n'; exit 0
    fi
fi
cat <<'X'
Screen 0: minimum 16 x 16, current 4800 x 2700, maximum 32767 x 32767
XWAYLAND0 connected primary 2880x1620+0+0 (normal left inverted right x axis y axis) 0mm x 0mm
   2880x1620    120.00*+
LARES-CAST-1 connected 1920x1080+0+-1080 (normal left inverted right x axis y axis) 0mm x 0mm
   1920x1080     60.00*+
HDMI-1 disconnected (normal left inverted right x axis y axis)
X

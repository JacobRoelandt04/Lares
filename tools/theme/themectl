def _wallpaper_set(P, args):
    src = _one_path(P, args, "set")
    if not os.path.isfile(src):
        raise Refused("%s is not a file" % src)
    if sniff_image(src) is None:
        raise Refused("%s is not an image hyprpaper can draw (jpeg, png, webp, jxl, bmp)" % os.path.basename(src))
    with locked(P):
        theme, mode, slot_path, slot = _current_slot(P)
        cfg = shell_config_file(P)
        before = _read_text(cfg)
        if before is None and os.path.exists(cfg):
            raise Refused("cannot read %s as text" % cfg)
        existed_file = before is not None
        base = before if existed_file else "{\n}\n"
        listed = slot is not None and src in [p for _, p in slot["entries"]]
        bags = load_bags(P)
        key = slot_key(theme.name, mode)
        inst = os.environ.get("HYPRLAND_INSTANCE_SIGNATURE", "")
        state = bags["slots"].get(key, bag_empty())
        shown = shown_path(P, src)
        label = "%s %s" % (shown_name(theme.name), mode)
        if listed and state["last"] == src and bags["shown"] == [theme.name, mode] and bags["instance"] == inst:
            print("ok    wallpaper    unchanged: %s is %s's wallpaper on screen already" % (shown, label))
            return 0
        if listed:
            after = base
        else:
            try:
                after = jsonc_list_add(base, slot_path, shown)
            except ValueError as e:
                raise Refused("%s: %s -- nothing written" % (cfg, e))
        names = ([p for p in slot["paths"]] if slot else []) + ([] if listed else [src])
        bag_before = _read_text(bag_file(P))
        bags["slots"][key] = bag_take(state, names, src, random.random)
        bags["shown"], bags["instance"] = [theme.name, mode], inst
        old_pictures = _active_pictures(P)
        conf_path = P.expand("${XDG_CONFIG_HOME}/hypr/hyprpaper.conf")
        conf_before = _read_text(conf_path)
        real = os.path.realpath(cfg)
        try:
            if after != before:
                write_atomic(real, after, mode=stat.S_IMODE(os.stat(real).st_mode) if existed_file else 0o644)
            save_bags(P, bags)
        except OSError as e:
            raise Refused("cannot write %s: %s" % (e.filename or real, e))
        bag_after = _read_text(bag_file(P))
        fails, said = _apply_wallpaper_target(P, theme, mode)
        print(said)
        if fails:                                         # hyprpaper refused the picture: nothing half-set
            _put_back(P, cfg, before, existed_file, bag_before)
            _apply_wallpaper_target(P, theme, mode)
            if not args.no_notify:
                _notify("Wallpaper not set", said.split("wallpaper", 1)[-1].strip()[:200])
            return 1
        count = len(names)
        rec = {"file": real, "existed_file": existed_file, "theme": theme.name, "mode": mode, "slot": slot_path, "before": before, "after": after,
               "appended": not listed, "had_slot": slot is not None, "picture": src, "bag_before": bag_before, "bag_after": bag_after,
               "pictures_before": old_pictures, "conf": conf_path, "conf_before": conf_before}
    print("themectl: wallpaper %s: %s %s (%d in the list)%s" % (label, shown, "is on screen" if listed else "added and on screen", count,
                                                                  "" if args.no_notify else " (the notification has a Revert button)"))
    if args.no_notify:
        return 0
    os.makedirs(P.state + "/theme", exist_ok=True)
    recpath = "%s/theme/wallpaper-undo-%d.json" % (P.state, os.getpid())
    with open(recpath, "w", encoding="utf-8") as f:
        json.dump(rec, f)
    subprocess.Popen([sys.executable, os.path.realpath(__file__), "wallpaper", "_prompt", recpath], stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                     stderr=subprocess.DEVNULL, start_new_session=True, close_fds=True)
    return 0


def cmd_wallpaper_prompt(P, args):
    """The detached half of `wallpaper set`: post the notification, wait for its answer (a closed or expired one ends it), undo the set on
    "Revert". The record is deleted either way."""
    try:
        with open(args.record, encoding="utf-8") as f:
            rec = json.load(f)
    except (OSError, ValueError):
        return 1
    try:
        shown = os.path.basename(rec["picture"])
        label = "%s %s" % (shown_name(rec["theme"]), rec["mode"])
        body = ("%s joined the %s wallpapers and is on screen" if rec.get("appended") else "%s (one of the %s wallpapers) is on screen") % (shown, label)
        answer = _notify("Wallpaper set", body, actions=["revert=Revert"], wait=True)
        if answer == "revert":
            try:
                msg = wallpaper_revert(P, rec)
                _notify("Wallpaper put back", msg)
            except Refused as e:
                _notify("Wallpaper not put back", str(e))
    finally:
        with contextlib.suppress(OSError):
            os.unlink(args.record)
    return 0


def wallpaper_revert(P, rec):
    """Undo `wallpaper set`: the picture leaves the list again (the file's old text BYTE FOR BYTE when it is as set left it, else only that
    item, when it is still there), the bag is as it was (when nothing drew since), and the old picture is shown. -> a sentence for the user.
    Refused: the file moved on (a slot set made from nothing and edited since is removed by hand)."""
    with locked(P):
        cfg = rec["file"]
        label = "%s %s" % (shown_name(rec["theme"]), rec["mode"])
        if rec.get("appended"):
            now = _read_text(cfg)
            if now is None:
                raise Refused("%s is gone: nothing to put back" % cfg)
            if now == rec["after"]:
                restored = rec["before"] if rec["existed_file"] else None
            else:
                if not rec["had_slot"]:
                    raise Refused("shell.jsonc was edited since: remove the %s slot by hand" % ".".join(rec["slot"]))
                try:
                    restored = jsonc_list_drop(now, rec["slot"], lambda v: os.path.normpath(P.expand(v)) == rec["picture"])
                except ValueError as e:
                    raise Refused("shell.jsonc was edited since (%s): nothing changed" % e)
            if restored is None:
                os.unlink(cfg)
            else:
                write_atomic(cfg, restored, mode=stat.S_IMODE(os.stat(cfg).st_mode))
        if _read_text(bag_file(P)) == rec["bag_after"]:
            _put_bag(P, rec["bag_before"])
        st = read_state(P)
        if (st["theme"], st["mode"]) != (rec["theme"], rec["mode"]):
            return "the %s list is back; %s %s is showing, so the screen did not change" % (label, shown_name(st["theme"]), st["mode"])
        theme = load_theme(P, rec["theme"])
        if not rec["had_slot"]:
            # there was no slot: the wallpaper target has nothing to apply, so the old picture is told to hyprpaper as it was listed, and
            # hyprpaper's own file is put back as it was
            if rec["conf_before"] is not None and _read_text(rec["conf"]) is not None:
                write_atomic(rec["conf"], rec["conf_before"])
            fit = shell_theme_block(P).get("wallpaperFit", "cover")
            told = 0
            pics = sorted({pic for _, pic in rec["pictures_before"]})
            if len(pics) == 1:
                # one picture everywhere (themectl's own way): the fallback, then by name only a monitor that did not take it (hyprpaper_show),
                # never a named set alone -- that one froze every later switch (2026-11-11)
                argv = ["hyprctl", "hyprpaper", "wallpaper", ",%s,%s" % (pics[0], fit)]
                p = run_cmd(argv, 20)
                told = p.returncode == 0 and not hyprpaper_show(argv, pics[0], 20)
            else:
                # the monitors showed different pictures: each its own, by name (the next target call names any monitor that keeps one)
                for mon, pic in rec["pictures_before"]:
                    p = run_cmd(["hyprctl", "hyprpaper", "wallpaper", "%s,%s,%s" % (mon, pic, fit)], 20)
                    told += p.returncode == 0
            _apply_wallpaper_target(P, theme, rec["mode"])            # the yazi view: the slot is empty again
            return "the slot is gone again" + ("; hyprpaper shows its old picture" if told else "; the picture on screen stays until the next apply")
        fails, said = _apply_wallpaper_target(P, theme, rec["mode"])
        if fails:
            raise Refused("the list is back but the old picture was not applied: %s" % said[:160])
        return "%s shows its old picture again" % label


def cmd_wallpaper_remove(P, args):

def cmd_install(P, args):
    src = P.repo + "/themes"
    dst = P.theme_dir + "/themes"
    names = sorted(n for n in os.listdir(src) if n.endswith(".json")) if os.path.isdir(src) else []
    if not names:
        print("themectl: no themes in %s" % src)
        return REFUSED
    verb = "would " if args.dry_run else ""
    fails = install_renames(P, args)
    for n in names:
        s, d = src + "/" + n, dst + "/" + n
        if not os.path.exists(d):
            print("%-5s %-14s %scopy to %s" % ("ok", n, verb, d))
            if not args.dry_run:
                os.makedirs(dst, exist_ok=True)
                shutil.copy2(s, d)
            continue
        if open(s, "rb").read() == open(d, "rb").read():
            print("%-5s %-14s same as %s" % ("ok", n, d))
            continue
        if os.path.getmtime(d) > os.path.getmtime(s):
            print("%-5s %-14s %skeep %s (it differs and is newer than the repo's: yours)" % ("ok", n, verb, d))
            continue
        print("%-5s %-14s %sreplace %s (older than the repo's; the old one is kept in the backup)" % ("ok", n, verb, d))
        if not args.dry_run:
            with locked(P):
                own_file(P, d)
            shutil.copy2(s, d)
    fails += install_shipped(P, args)
    fails += install_yazi(P, args)
    return min(fails, 99)


def _aside(P, path, stamp):
    """Move PATH (a file or a link) into the backup's renamed/ folder -> where it went."""
    d = P.backup_dir + "/renamed"
    os.makedirs(d, exist_ok=True)
    to = "%s/%s-%s" % (d, stamp, os.path.basename(path))
    os.replace(path, to)
    return to


def _forget(P, paths):
    """The manifest forgets PATHS (a renamed pair's old files: a `restore` must not bring a ghost back)."""
    man = load_manifest(P)
    gone = [x for x in paths if x in man]
    for x in gone:
        del man[x]
    if gone:
        write_atomic(_manifest_path(P), json.dumps(man, indent=2, sort_keys=True) + "\n")


def install_renames(P, args):
    """RENAMES carried over in the home (see RENAMES). Every step prints `ok` or `FAIL`; a dry run says what it would do. -> the number of FAILs."""
    dry = args.dry_run
    verb = "would " if dry else ""
    _, targets, _ = load_targets(P)
    stamp = datetime.datetime.now().strftime("%Y%m%d-%H%M%S")
    fails = 0

    def say(ok, msg):
        nonlocal fails
        fails += 0 if ok else 1
        print("%-5s %-14s %s" % ("ok" if ok else "FAIL", label, msg))
    for r in RENAMES:
        old, new = r["from"], r["to"]
        label = "rename %s" % old
        oldf, newf = "%s/themes/%s.json" % (P.theme_dir, old), "%s/themes/%s.json" % (P.theme_dir, new)
        files = {}
        for tname, m in r["files"].items():
            spec = next((x for x in targets if x["name"] == tname and "output" in x), None)
            if spec:
                files[tname] = (os.path.dirname(P.expand(spec["output"])), P.expand(spec["output"]), m)
        with contextlib.nullcontext() if dry else locked(P):
            # 1. the theme file: a copy the repo shipped goes; the user's own edit becomes the new name's copy
            if os.path.exists(oldf):
                data = open(oldf, "rb").read()
                if hashlib.sha256(data).hexdigest() in r["shipped"]:
                    say(True, "%smove %s into the backup (a copy the repo shipped; %s.json is the pair now)" % (verb, oldf, new))
                elif os.path.exists(newf):
                    say(True, "%smove %s into the backup (edited by you; %s exists already and stays: copy your colours over by hand)" % (verb, oldf, newf))
                else:
                    text = data.decode("utf-8", "replace")
                    text = text.replace('"name": %s' % json.dumps(old), '"name": %s' % json.dumps(new), 1)
                    for m in r["files"].values():
                        for a, b in m.items():
                            text = text.replace(json.dumps(a), json.dumps(b))
                    try:
                        ok = json.loads(text).get("name") == new
                    except ValueError:
                        ok = False
                    if not ok:
                        say(False, "%s: cannot rename it inside (its name is not %s): left as it is" % (oldf, json.dumps(old)))
                        continue
                    if not dry:
                        write_atomic(newf, text)
                    say(True, "%scarry your edited %s over as %s (the name and the btop / fastfetch files renamed inside)" % (verb, oldf, newf))
                if not dry:
                    _aside(P, oldf, stamp)
                    _forget(P, [oldf])
            # 2. state.json
            st = read_state(P)
            if st["present"] and st["theme"] == old:
                if not dry:
                    write_atomic(P.state_file, state_text(new, st["mode"]))
                say(True, "%sset state.json's theme to %s" % (verb, new))
            # 3. shell.jsonc theme.wallpapers.<old> -> <new>: the key's text alone
            cfg = shell_config_file(P)
            text = _read_text(cfg)
            if text is not None:
                try:
                    toks, ki, _ = _jsonc_locate(text, ["theme", "wallpapers", old])
                    if ki is not None:
                        if _jsonc_locate(text, ["theme", "wallpapers", new])[1] is not None:
                            say(True, "%s has wallpapers for both %s and %s: the %s ones are not read any more (merge them by hand)" % (cfg, old, new, old))
                        else:
                            out = text[:toks[ki][1]] + json.dumps(new) + text[toks[ki][2]:]
                            if _parses(text) and not _parses(out):
                                raise ValueError("the edit does not parse")
                            if not dry:
                                real = os.path.realpath(cfg)
                                write_atomic(real, out, mode=stat.S_IMODE(os.stat(real).st_mode))
                            say(True, "%srename theme.wallpapers.%s to %s in %s" % (verb, old, new, cfg))
                except (ValueError, OSError) as e:
                    say(False, "%s: cannot rename theme.wallpapers.%s (%s): rename it by hand" % (cfg, old, e))
            # 4. the wallpaper bag
            bags = load_bags(P)
            moved = [m for m in MODES if slot_key(old, m) in bags["slots"] and slot_key(new, m) not in bags["slots"]]
            if moved or (bags["shown"] or [None])[0] == old:
                for m in moved:
                    bags["slots"][slot_key(new, m)] = bags["slots"].pop(slot_key(old, m))
                if (bags["shown"] or [None])[0] == old:
                    bags["shown"] = [new, bags["shown"][1]]
                if not dry:
                    save_bags(P, bags)
                say(True, "%scarry the wallpaper bag over to %s" % (verb, new))
            # 5. the files the btop and fastfetch targets shipped under the old names, and the links that name them
            for tname, (d, link, m) in sorted(files.items()):
                for a, b in sorted(m.items()):
                    pa = os.path.join(d, a)
                    if os.path.lexists(pa):
                        if not dry:
                            _aside(P, pa, stamp)
                            _forget(P, [pa])
                        say(True, "%smove %s into the backup (%s ships %s now)" % (verb, pa, tname, b))
                if os.path.islink(link):
                    cur = os.readlink(link)
                    if os.path.basename(cur) in m and os.path.dirname(cur) in ("", d):
                        to = os.path.join(os.path.dirname(cur), m[os.path.basename(cur)])
                        if not dry:
                            tmp = tempfile.mktemp(prefix=".themectl-", dir=os.path.dirname(link))
                            os.symlink(to, tmp)
                            os.replace(tmp, link)
                        say(True, "%slink %s -> %s" % (verb, link, to))
    return min(fails, 99)


# YAZI (tools/theme/yazi/CHEATSHEET.md): the wallpapers.yazi plugin (the mark beside a listed picture), the `wallpaper-listed` opener
# ("Remove from wallpapers", after the user's own viewer: Enter still views) and the BEGIN / END marks at the top of [open] prepend_rules,
# between which the `yazi` target writes one exact-path rule per listed picture. `install` sets them up ONCE, as `migrate` edits an app's
# config: anchors found or nothing written, the original kept (own_file), every later run finds them done.
YAZI_OPENER = "wallpaper-listed"
YAZI_INIT = 'pcall(function() require("wallpapers"):setup() end)   -- themectl: the wallpaper mark (a broken plugin only loses the mark)'


def _toml_inline(d):
    """A flat dict of strings / bools as a TOML inline table."""
    parts = []
    for k, v in d.items():
        parts.append("%s = %s" % (k, ("true" if v else "false") if isinstance(v, bool) else toml_str(str(v))))
    return "{ " + ", ".join(parts) + " }"


def yazi_themectl_cmd(P, doc):
    """The themectl the user's yazi runs: the one their "Set as wallpaper" entry names, else the deployed snapshot's."""
    for entries in (doc.get("opener") or {}).values():
        for e in entries if isinstance(entries, list) else []:
            run = e.get("run") if isinstance(e, dict) else None
            m = re.match(r"""^\s*['"]?([^'"]*themectl)['"]?\s+wallpaper\s+set\b""", run or "")
            if m:
                return m.group(1)
    return P.state + "/lares/shell/current/tools/theme/themectl"


def yazi_toml_edit(P, text):
    """yazi.toml's TEXT with what the wallpapers need added -> (new text, [what was added]); [] when it is all there. Fail when an anchor is
    not where it must be (nothing is written then)."""
    import shlex
    import tomllib
    try:
        doc = tomllib.loads(text)
    except Exception as e:                              # noqa: BLE001 -- tomllib's own error type, any of its messages
        raise Fail("yazi.toml does not parse (%s): nothing written" % e)
    out, added = text, []

    def header(name):
        return [m for m in re.finditer(r"^\[%s\][ \t]*(#[^\n]*)?\n?" % re.escape(name), out, re.M)]
    if YAZI_OPENER not in (doc.get("opener") or {}):
        view = ((doc.get("opener") or {}).get("image") or [None])[0]
        if not (isinstance(view, dict) and isinstance(view.get("run"), str) and "wallpaper" not in view["run"]):
            view = {"run": "xdg-open %s", "orphan": True, "desc": "Open"}
        view = {k: v for k, v in view.items() if isinstance(v, (str, bool))}
        rm = {"run": "%s wallpaper remove %%s" % shlex.quote(yazi_themectl_cmd(P, doc)), "block": False, "orphan": True, "desc": "Remove from wallpapers"}
        entry = ("# themectl: a picture of the current theme and mode's wallpapers (the rules between the marks in [open] use it). Enter views it;\n"
                 "# O offers \"Remove from wallpapers\".\n%s = [\n    %s,\n    %s,\n]\n" % (YAZI_OPENER, _toml_inline(view), _toml_inline(rm)))
        hs = header("opener")
        if hs:
            out = out[:hs[0].end()] + entry + out[hs[0].end():]
        elif "opener" in doc:
            raise Fail("yazi.toml defines `opener` without an [opener] header: add the %s opener by hand (CHEATSHEET)" % YAZI_OPENER)
        else:
            out = out + ("" if out.endswith("\n") or not out else "\n") + "\n[opener]\n" + entry
        added.append("the %s opener" % YAZI_OPENER)
    if YAZI_BEGIN not in out:
        marks = "%s -- themectl writes the rules between these two lines on every theme switch and wallpaper change\n%s\n"
        hs = header("open")
        if not hs:
            if "open" in doc:
                raise Fail("yazi.toml defines `open` without an [open] header: add the marks by hand (CHEATSHEET)")
            out = out + ("" if out.endswith("\n") or not out else "\n") + "\n[open]\nprepend_rules = [\n    " + (marks % (YAZI_BEGIN, "    " + YAZI_END)) + "]\n"
        else:
            nxt = re.search(r"^\[", out[hs[0].end():], re.M)
            body_end = hs[0].end() + (nxt.start() if nxt else len(out) - hs[0].end())
            body = out[hs[0].end():body_end]
            if "rules" in (doc.get("open") or {}):
                raise Fail("yazi.toml's [open] sets `rules` (it replaces yazi's own): add the marks to it by hand (CHEATSHEET)")
            m = re.search(r"^([ \t]*)prepend_rules[ \t]*=[ \t]*\[[ \t]*(#[^\n]*)?\n", body, re.M)
            if m:
                rest = body[m.end():]
                ind = re.match(r"[ \t]*", rest).group(0) if rest.strip() and not rest.lstrip().startswith("]") else m.group(1) + "    "
                at = hs[0].end() + m.end()
                out = out[:at] + ind + (marks % (YAZI_BEGIN, ind + YAZI_END)) + out[at:]
            elif "prepend_rules" in (doc.get("open") or {}):
                raise Fail("yazi.toml's [open] prepend_rules is not a list that opens on its own line: break it into one rule a line (CHEATSHEET)")
            else:
                at = hs[0].end()
                out = out[:at] + "prepend_rules = [\n    " + (marks % (YAZI_BEGIN, "    " + YAZI_END)) + "]\n" + out[at:]
        added.append("the BEGIN / END marks at the top of [open] prepend_rules")
    if added:
        try:
            new = tomllib.loads(out)
        except Exception as e:                          # noqa: BLE001
            raise Fail("yazi.toml would not parse after the edit (%s): nothing written" % e)
        if YAZI_OPENER not in (new.get("opener") or {}) or not isinstance((new.get("open") or {}).get("prepend_rules"), list):
            raise Fail("yazi.toml did not read back as meant after the edit: nothing written")
    return out, added


def install_yazi(P, args):
    """The yazi side of the wallpapers (see YAZI_OPENER): the plugin copied (owned, the shipped-file rule), yazi.toml and init.lua edited once
    (originals kept), then the `yazi` target fills the rules for the theme in force. No yazi.toml is a yazi not set up here: said, no failure."""
    verb = "would " if args.dry_run else ""
    ydir = P.config + "/yazi"
    toml, init = ydir + "/yazi.toml", ydir + "/init.lua"
    label = "yazi"
    text = _read_text(toml)
    if text is None:
        print("%-5s %-14s skipped: no %s (yazi is not set up; tools/theme/yazi/CHEATSHEET.md has the lines)" % ("ok", label, toml))
        return 0
    fails = 0
    try:
        new, added = yazi_toml_edit(P, text)
    except Fail as e:
        print("%-5s %-14s %s" % ("FAIL", label, e))
        return 1
    src = P.tools + "/yazi/wallpapers.yazi/main.lua"
    dst = ydir + "/plugins/wallpapers.yazi/main.lua"
    if os.path.exists(dst) and open(src, "rb").read() == open(dst, "rb").read():
        print("%-5s %-14s same as %s" % ("ok", label, dst))
    elif os.path.exists(dst) and os.path.getmtime(dst) > os.path.getmtime(src):
        print("%-5s %-14s %skeep %s (it differs and is newer than the repo's: yours)" % ("ok", label, verb, dst))
    else:
        print("%-5s %-14s %s%s %s" % ("ok", label, verb, "replace" if os.path.exists(dst) else "copy the plugin to", dst))
        if not args.dry_run:
            try:
                with locked(P):
                    _install_shipped(P, src, dst)
            except (OSError, Refused) as e:
                fails += 1
                print("%-5s %-14s %s: %s" % ("FAIL", label, dst, e))
    edits = [(toml, text, new, added)] if added else []
    itext = _read_text(init)
    if itext is None or not re.search(r"""require\(?\s*["']wallpapers["']""", itext):
        base = itext or ""
        edits.append((init, itext, base + ("" if not base or base.endswith("\n") else "\n") + YAZI_INIT + "\n", ["the plugin's setup line"]))
    if not edits:
        print("%-5s %-14s already set up: %s and %s" % ("ok", label, toml, init))
    for path, old, newt, what in edits:
        print("%-5s %-14s %sadd %s to %s%s" % ("ok", label, verb, " and ".join(what), path, "" if old is not None else " (a new file)"))
        if args.dry_run:
            print("".join("      " + l if l.endswith("\n") else "      " + l + "\n" for l in _udiff(old, newt, path).splitlines(True)).rstrip("\n"))
            continue
        try:
            with locked(P):
                own_file(P, path)
                real = os.path.realpath(path)
                write_atomic(real, newt, mode=stat.S_IMODE(os.stat(real).st_mode) if os.path.exists(real) else None)
        except OSError as e:
            fails += 1
            print("%-5s %-14s cannot write %s: %s" % ("FAIL", label, path, e))
    if not args.dry_run and not fails:
        try:
            st = read_state(P)
            theme = load_theme(P, st["theme"])
            import io
            buf = io.StringIO()
            with locked(P):
                fails += run_targets(P, theme, st["mode"], only=["yazi"], out=buf)
            for l in buf.getvalue().splitlines():
                print("%-5s %-14s %s" % (l.split()[0], label, l.split(None, 2)[-1]))
        except Refused as e:
            print("%-5s %-14s the rules wait for the next apply (%s)" % ("ok", label, e))
    return fails


def install_shipped(P, args):
    """The files the repo ships for a link target (targets.json `shipped`: btop's custom themes, the fastfetch logos), into the directory of
    that target's link, by the rule the themes follow: a missing one is copied, a newer one is the user's and kept, an older one is
    replaced. Unlike a theme, each one is owned (`restore` takes back what install put in an app's directory)."""
    _, targets, _ = load_targets(P)
    verb = "would " if args.dry_run else ""
    fails = 0
    for t in targets:
        if not t.get("shipped") or "output" not in t:
            continue
        src_dir = os.path.join(P.tools, t["shipped"])
        dst_dir = os.path.dirname(P.expand(t["output"]))
        names = sorted(n for n in os.listdir(src_dir) if not n.startswith(".")) if os.path.isdir(src_dir) else []
        for n in names:
            s, d = os.path.join(src_dir, n), os.path.join(dst_dir, n)
            label = "%s/%s" % (t["name"], n)
            if os.path.exists(d) and open(s, "rb").read() == open(d, "rb").read():
                print("%-5s %-14s same as %s" % ("ok", label, d))
                continue
            if os.path.exists(d) and os.path.getmtime(d) > os.path.getmtime(s):
                print("%-5s %-14s %skeep %s (it differs and is newer than the repo's: yours)" % ("ok", label, verb, d))
                continue
            print("%-5s %-14s %s%s %s" % ("ok", label, verb, "replace" if os.path.exists(d) else "copy to", d))
            if args.dry_run:
                continue
            try:
                with locked(P):
                    _install_shipped(P, s, d)
            except (OSError, Refused) as e:
                fails += 1
                print("%-5s %-14s %s: %s" % ("FAIL", label, d, e))
    return min(fails, 99)


# ============================================================================================================ migrate
# The one-time edits of the apps' own configs (docs/theme.md, `migrate`). `apply` never edits an app's main config; a
# target whose output only takes effect through a line of the app's own config names that line in targets.json (`include`: the file,
# the pattern that says it is there, the line), and `doctor` asks for it. `migrate` makes every one that is missing, and nothing else,
# on the user's say. Each recipe finds ITS anchor where T.md says it is, or the whole run is refused before a byte is written. The
# original of every file it edits is kept the way the files themectl owns are (own_file), so `restore` puts each one back -- a symlink
# as the same symlink. "Done" is decided by the include's own pattern, the one `doctor` uses, so the two cannot disagree.


def _eol(line):
    return "\r\n" if line.endswith("\r\n") else "\n"


def _mig_hyprland(P, path, text):
    """pcall(require, "config/theme") on the line after require("config/appearance"): guarded, so after `restore` (the file gone) it is not a config error."""
    rx = re.compile(r'^(\s*)require\(\s*["\']config/appearance["\']\s*\)\s*(--.*)?$')
    lines = text.splitlines(keepends=True)
    hits = [i for i, l in enumerate(lines) if rx.match(l.rstrip("\r\n"))]
    if len(hits) != 1:
        raise Fail('%s has %d require("config/appearance") lines, not 1 (the include goes right after it)' % (path, len(hits)))
    i = hits[0]
    eol = _eol(lines[i])
    if not lines[i].endswith("\n"):
        lines[i] += eol
    lines.insert(i + 1, rx.match(lines[i].rstrip("\r\n")).group(1) + 'pcall(require, "config/theme")   -- themectl (guarded: a missing theme.lua is not an error)' + eol)
    return "".join(lines), 'added pcall(require, "config/theme") after line %d of %s' % (i + 1, path)


def _mig_btop(P, path, text):
    """color_theme = "current": the name of the link (~/.config/btop/themes/current.theme) themectl moves between the themes of the modes."""
    rx = re.compile(r'^(\s*color_theme\s*=\s*)"([^"\n]*)"([ \t\r]*)$', re.M)
    hits = rx.findall(text)
    if len(hits) != 1:
        raise Fail('%s has %d color_theme = "..." lines, not 1' % (path, len(hits)))
    return rx.sub(r'\1"current"\3', text), 'color_theme = "current" in %s (was "%s")' % (path, hits[0][1])


def _mig_fastfetch(P, path, text):
    """"source": the stable link archlogo_current.png, which themectl points at the logo of the mode (the old script rewrote this line each time)."""
    rx = re.compile(r'^([ \t]*"source"\s*:\s*)"([^"\n]*archlogo_[^"\n]*\.png)"', re.M)
    hits = rx.findall(text)
    if len(hits) != 1:
        raise Fail('%s has %d "source": ".../archlogo_<name>.png" lines, not 1' % (path, len(hits)))
    return rx.sub(r'\1"~/.config/fastfetch/archlogo_current.png"', text), '"source" is ~/.config/fastfetch/archlogo_current.png in %s (was %s)' % (path, hits[0][1])


MIG_LOCK_VARS = ("FIELD", "BORDER", "BACKGROUND", "FOREGROUND", "ACCENT", "INCORRECT", "CAPS")


def _mig_hyprlock(P, path, text):
    """The symlink into HyprV/hyprlock/ becomes a file: `source` of the generated colours + the body of evalight.conf without its seven colour
    variables. The LIGHT file's body for both modes: evadark.conf carries `no_fade_in` / `no_fade_out`, which hyprlock 0.9.6 answers "config
    option does not exist" to (on the lock screen)."""
    hv = os.path.realpath(P.config + "/HyprV/hyprlock")
    if not os.path.islink(path):
        raise Fail("%s is a file that does not read hyprlock-colors.conf, not the symlink into %s that T.md describes: add `source = ~/.config/hypr/hyprlock-colors.conf` "
                   "and delete its $%s lines by hand" % (path, hv, " $".join(MIG_LOCK_VARS)))
    if os.path.dirname(os.path.realpath(path)) != hv:
        raise Fail("%s links to %s, not into %s (T.md)" % (path, os.path.realpath(path), hv))
    src = hv + "/evalight.conf"
    body = _read_text(src)
    if body is None:
        raise Fail("%s is missing: it is the body of the new hyprlock.conf" % src)
    body, n = re.subn(r"^\$(%s)\s*=.*\n" % "|".join(MIG_LOCK_VARS), "", body, flags=re.M)
    if n != len(MIG_LOCK_VARS):
        raise Fail("%s has %d of the %d colour variables ($%s), not all" % (src, n, len(MIG_LOCK_VARS), " $".join(MIG_LOCK_VARS)))
    return "source = ~/.config/hypr/hyprlock-colors.conf\n\n" + body.lstrip("\n"), "source = ~/.config/hypr/hyprlock-colors.conf + the body of evalight.conf without its %d colour variables, in %s" % (n, path)


def _mig_kitty(P, path, text):
    """include current-theme.conf, last: what it sets wins over kitty.conf's own colours. (T.md: the user's kitty.conf has it already.)"""
    return text + ("" if (not text or text.endswith("\n")) else "\n") + "include current-theme.conf\n", "appended include current-theme.conf to %s" % path


MIGRATE = {"hyprland": _mig_hyprland, "btop": _mig_btop, "fastfetch": _mig_fastfetch, "hyprlock": _mig_hyprlock, "kitty": _mig_kitty}


def migrate_plan(P):
    """What `migrate` would do, read only: one entry per enabled target that names an `include`, in targets.json's order:
    {name, path, state: 'done' | 'edit' | 'fail', msg, link (what the file is a symlink to now), and for an edit old / new}."""
    _, targets, _ = load_targets(P)
    plan = []
    for spec in targets:
        inc = spec.get("include")
        if not inc or target_off(P, spec):
            continue
        name = spec["name"]
        e = {"name": name, "path": P.expand(inc["file"]), "link": None}
        if os.path.islink(e["path"]):
            e["link"] = os.readlink(e["path"])
        text = _read_text(e["path"])
        if text is not None and re.search(inc["pattern"], text, re.M):
            e.update(state="done", msg="already done: %s reads the file themectl owns" % e["path"])
        elif name not in MIGRATE:
            e.update(state="fail", msg="%s lacks %s, and migrate has no edit for it: add it by hand" % (e["path"], inc["line"]))
        elif text is None:
            e.update(state="fail", msg="%s is missing or unreadable (T.md: it needs %s)" % (e["path"], inc["line"]))
        else:
            try:
                guard_output(P, e["path"])                  # a targets.json typo must not get an edit scribbled over /etc either
                new, msg = MIGRATE[name](P, e["path"], text)
                e.update(state="edit", old=text, new=new, msg=msg)
            except (Fail, Refused) as ex:
                e.update(state="fail", msg=str(ex))
        plan.append(e)
    return plan


def migrate_paths(P):
    """The files `migrate` edits (for `restore migrate`)."""
    _, targets, _ = load_targets(P)
    return {P.expand(t["include"]["file"]) for t in targets if t.get("include") and t["name"] in MIGRATE}


def cmd_migrate(P, args):
    def refuse_if_any_fails(plan):
        bad = [e for e in plan if e["state"] == "fail"]
        if bad:
            for e in bad:
                print("%-5s %-12s %s" % ("FAIL", e["name"], e["msg"]))
            raise Refused("nothing written: %d of %d edits cannot be made where themectl doctor says they are (make them by hand, or fix the file, and run migrate again)" % (len(bad), len(plan)))

    def kept(e):
        return " (a symlink -> %s; kept in the backup)" % e["link"] if e["link"] else ""
    plan = migrate_plan(P)
    refuse_if_any_fails(plan)
    todo = [e for e in plan if e["state"] == "edit"]
    if args.dry_run or not todo:
        for e in plan:
            print("%-5s %-12s %s" % ("ok", e["name"], ("would: " + e["msg"] + kept(e)) if e["state"] == "edit" else e["msg"]))
            if e["state"] == "edit":
                diff = _udiff(e["old"], e["new"], e["path"])
                print("".join("      " + l if l.endswith("\n") else "      " + l + "\n" for l in diff.splitlines(True)).rstrip("\n"))
        print("themectl: migrate%s: %s" % (" --dry-run" if args.dry_run else "", "%d edit%s would be made" % (len(todo), "" if len(todo) == 1 else "s") if todo else "nothing to do: every edit is already done"))
        return 0
    with locked(P):
        plan = migrate_plan(P)                      # again, under the lock: another themectl may have been first
        refuse_if_any_fails(plan)
        fails = made = 0
        for e in plan:
            if e["state"] != "edit":
                print("%-5s %-12s %s" % ("ok", e["name"], e["msg"]))
                continue
            try:
                mode = stat.S_IMODE(os.stat(e["path"]).st_mode)
                try:
                    own_file(P, e["path"])
                except OSError as ex:
                    raise Fail("cannot keep the original of %s (nothing written): %s" % (e["path"], ex))
                try:
                    write_atomic(e["path"], e["new"], mode)
                except OSError as ex:
                    raise Fail("cannot write %s: %s" % (e["path"], ex))
            except Fail as ex:
                fails += 1
                print("%-5s %-12s %s" % ("FAIL", e["name"], ex))
                continue
            made += 1
            print("%-5s %-12s %s" % ("ok", e["name"], e["msg"] + kept(e)))
    print("themectl: migrate: %d edit%s made%s" % (made, "" if made == 1 else "s", "; the originals are kept in %s: `themectl restore migrate` puts them back" % P.backup_dir if made else ""))
    return min(fails, 99)


def cmd_restore(P, args):
    with locked(P):
        man = load_manifest(P)
        names = args.targets
        if names:
            _, targets, _ = load_targets(P)
            wanted = set()
            for t in targets:
                if t["name"] in names:
                    for k in ("output", "config", "file"):
                        if isinstance(t.get(k), str):
                            wanted.add(P.expand(t[k]))
                    if t.get("type") == "yazi":                     # what `install` set up for it
                        wanted |= {P.config + "/yazi/init.lua", P.config + "/yazi/plugins/wallpapers.yazi/main.lua"}
                    if t.get("shipped") and "output" in t:          # the copies its apply or `install` put next to the link
                        d = os.path.dirname(P.expand(t["output"]))
                        src = os.path.join(P.tools, t["shipped"])
                        shipped = set(os.listdir(src)) if os.path.isdir(src) else set()
                        wanted |= {path for path in man if os.path.dirname(path) == d and os.path.basename(path) in shipped}
            for n in names:
                if n == "migrate":                    # the one-time edits of the apps' own configs, not a target's output
                    wanted |= migrate_paths(P)
                elif not any(t["name"] == n for t in targets):
                    raise Refused('no target named "%s" (or "migrate")' % n)
        else:
            wanted = set(man)
        fails = 0
        for path in sorted(wanted):
            e = man.get(path)
            if e is None:
                print("%-5s %-12s nothing kept for %s (themectl never owned it)" % ("ok", "restore", path))
                continue
            try:
                if not args.dry_run:
                    if os.path.lexists(path):
                        os.remove(path)
                    if e["kind"] == "file":
                        os.makedirs(os.path.dirname(path), exist_ok=True)
                        shutil.copy2(P.backup_dir + "/" + e["backup"], path)
                    elif e["kind"] == "symlink":
                        os.makedirs(os.path.dirname(path), exist_ok=True)
                        os.symlink(e["link"], path)
                    del man[path]
                    write_atomic(_manifest_path(P), json.dumps(man, indent=2, sort_keys=True) + "\n")
                print("%-5s %-12s %s%s: %s" % ("ok", "restore", "would put back " if args.dry_run else "put back ", path, e["kind"] if e["kind"] != "symlink" else "symlink -> " + e["link"]))
            except OSError as ex:
                fails += 1
                print("%-5s %-12s %s: %s" % ("FAIL", "restore", path, ex))
        return min(fails, 99)


def cmd_resolve(P, args):
    l0 = l0_defaults(P) if not args.l0 else _l0_from(args.l0)
    if args.file:
        theme = Theme(os.path.basename(args.file)[:-5], args.file, load_json(args.file), l0)
    else:
        th = load_theme(P, args.theme or read_state(P)["theme"])
        theme = Theme(th.name, th.path, th.doc, l0)
    values, errors = theme.mode_values(args.mode)
    json.dump({"values": values, "errors": errors, "l0": l0}, sys.stdout, sort_keys=True)
    sys.stdout.write("\n")
    return 0


def _l0_from(theme_qml):
    class _P:
        pass
    p = _P()
    p.theme_qml = theme_qml
    return l0_defaults(p)


def cmd_doctor(P, args):
    fails = 0

    def line(ok, name, msg, tag=None):
        nonlocal fails
        if not ok:
            fails += 1
        print("%-5s %-12s %s" % (tag or ("ok" if ok else "FAIL"), name, msg))
    line(sys.version_info >= (3, 8), "python", "%d.%d" % sys.version_info[:2])
    l0 = l0_defaults(P)
    line(len(l0) > 0, "l0", "%d shipped tokens from %s" % (len(l0), P.theme_qml) if l0 else "%s not found: tokens a theme leaves out cannot fall back" % P.theme_qml)
    try:
        st = read_state(P)
        theme = load_theme(P, st["theme"])
        line(True, "state", "%s (%s): theme %s, mode %s" % (P.state_file, "present" if st["present"] else "absent, defaults", st["theme"], st["mode"]))
    except Refused as e:
        line(False, "state", str(e))
        return min(fails, 99)
    mode = st["mode"]
    values, errors = theme.mode_values(mode)
    if errors:
        for k, v in sorted(errors.items()):
            line(False, "theme", "%s (%s): %s" % (theme.name, mode, v))
    else:
        line(True, "theme", "%s (%s) resolves: %d keys, no errors" % (theme.name, mode, len(values)))
    options, targets, tpath = load_targets(P)
    line(True, "targets", tpath)
    ctx = Ctx(P, options, theme, mode, True)
    for spec in targets:
        name = spec["name"]
        off = target_off(P, spec)
        if off:
            line(True, name, off)
            continue
        if spec.get("themes") and theme.name not in spec["themes"]:
            line(True, name, "not for theme %s" % theme.name)
            continue
        problems, notes = [], []
        try:
            msg, _ = TYPES[spec["type"]](spec, ctx)
        except Fail as e:
            problems.append(str(e))
            msg = ""
        except Exception as e:
            problems.append("%s: %s" % (type(e).__name__, e))
            msg = ""
        progs = []
        if spec.get("type") in ("gsettings", "gnomeAccent"):
            progs.append("gsettings")
        if spec.get("type") in ("command", "wallpaper"):
            progs.append(spec["argv"][0])
        if spec.get("type") == "wallpaper":
            progs.append("hyprpaper")
        if spec.get("reload"):
            progs.append(spec["reload"]["argv"][0])
        for pr in progs:
            if shutil.which(pr) is None:
                problems.append("%s is not on the PATH" % pr)
        if "output" in spec:
            d = os.path.dirname(P.expand(spec["output"]))
            probe = d
            while probe and not os.path.exists(probe):
                probe = os.path.dirname(probe)
            if probe and not os.access(probe, os.W_OK):
                problems.append("%s is not writable" % probe)
        inc = spec.get("include")
        if inc:
            f = P.expand(inc["file"])
            text = _read_text(f)
            if text is None:
                problems.append("%s is missing; it needs: %s%s" % (f, inc["line"], " (`themectl migrate` makes it)" if name in MIGRATE else ""))
            elif not re.search(inc["pattern"], text, re.M):
                problems.append("%s does not read the file themectl owns; add: %s%s" % (f, inc["line"], " (`themectl migrate` makes it)" if name in MIGRATE else ""))
        if spec.get("name") == "hyprland" and not os.environ.get("HYPRLAND_INSTANCE_SIGNATURE"):
            problems.append("HYPRLAND_INSTANCE_SIGNATURE is not set (not in a Hyprland session: the live reload cannot run)")
        if problems:
            line(False, name, "; ".join(problems))
        else:
            line(True, name, msg)
            # the libadwaita target's stylesheet carries the pair's exact accent past any portal; without that target the named accent
            # in gsettings reaches libadwaita only when no portal answers for it
            if spec.get("type") == "gnomeAccent" and not os.environ.get("ADW_DISABLE_PORTAL") and not any(t.get("name") == "libadwaita" for t in targets):
                line(True, name, "libadwaita apps take the accent from the settings portal while one answers, and this desktop's (xdg-desktop-portal-gtk) has "
                     "no accent-color: put ADW_DISABLE_PORTAL=1 in the session's environment (hl.env in ~/.config/hypr/config/environment.lua) so loupe and "
                     "zenity read it from gsettings", tag="note")
    # a pair renamed in the repo whose old name the home still holds (install carries it over)
    for r in RENAMES:
        where = []
        if os.path.exists("%s/themes/%s.json" % (P.theme_dir, r["from"])):
            where.append("~/.config/theme/themes/%s.json" % r["from"])
        if st["theme"] == r["from"]:
            where.append("state.json")
        try:
            if _jsonc_locate(_read_text(shell_config_file(P)) or "{}", ["theme", "wallpapers", r["from"]])[1] is not None:
                where.append("shell.jsonc theme.wallpapers")
        except ValueError:
            pass
        if where:
            line(True, "rename", "%s is %s now, and %s still say%s %s: run `themectl install`" % (r["from"], r["to"], ", ".join(where),
                                                                                                "s" if len(where) == 1 else "", r["from"]), tag="note")
    # yazi's side of the wallpapers (install sets it up; the yazi target above keeps its rules)
    ydir = P.config + "/yazi"
    ytext = _read_text(ydir + "/yazi.toml")
    if ytext is not None:
        missing = []
        if not os.path.exists(ydir + "/plugins/wallpapers.yazi/main.lua"):
            missing.append("the wallpapers.yazi plugin")
        if not re.search(r"""require\(?\s*["']wallpapers["']""", _read_text(ydir + "/init.lua") or ""):
            missing.append("its init.lua line")
        if YAZI_BEGIN not in ytext:
            missing.append("the rule marks in yazi.toml")
        if not re.search(r"^\s*%s\s*=" % re.escape(YAZI_OPENER), ytext, re.M):
            missing.append("the %s opener" % YAZI_OPENER)
        if not re.search(r"wallpaper\s+set\b", ytext):
            missing.append('a "Set as wallpaper" opener entry (CHEATSHEET section 1)')
        line(True, "yazi", ("wallpapers set up: the plugin, init.lua, the rule marks, the opener" if not missing else
                            "wallpapers not set up, missing: %s (`themectl install` adds all but the Set entry; tools/theme/yazi/CHEATSHEET.md)" % ", ".join(missing)),
             tag="ok" if not missing else "note")
    for pid, since in nwglook_running():
        line(True, "nwg-look", "nwg-look is open (pid %d, since %s): it shows the GTK theme as it was when it opened, and its Apply writes that back; "
             "close it and open it again after a switch" % (pid, since), tag="note")
    pk = load_packages(P)
    by_pair = {}
    for tname, tmode, key, chosen, entries, states in package_report(P):
        by_pair.setdefault(tname, []).append((tmode, key, chosen, entries, states))
    for tname in sorted(by_pair):
        parts, gap = [], False
        for tmode, key, chosen, entries, states in by_pair[tname]:
            idx = entries.index(chosen)
            if idx == 0 and states[0]:
                parts.append("%s %s: %s installed" % (tmode, LIST_ASSETS[key], chosen))
                continue
            gap = True
            miss = ["%s (%s)" % (e, package_hint(pk, e)) for e in entries[:idx] if len(entries) > 1] or ["%s (%s)" % (entries[0], package_hint(pk, entries[0]))]
            parts.append("%s %s: preferred %s missing; %s %s%s" % (tmode, LIST_ASSETS[key], "; ".join(miss), "falls back to" if idx == len(entries) - 1 else "uses",
                                                                  chosen, "" if states[idx] else " (not installed either)"))
        line(True, "pkg " + tname, " | ".join(parts), tag="note" if gap else "ok")
    return min(fails, 99)


def cmd_packages(P, args):
    """The install list: per pair, what is missing of its preferred themes, and the one command for all of it. Writes and installs nothing."""
    pk = load_packages(P)
    want, builds, pairs, exts = {"aur": [], "extra": []}, [], {}, []
    for tname, tmode, key, chosen, entries, states in package_report(P):
        for e, s in zip(entries[:-1], states[:-1]):
            if s:
                continue
            ent = pk.get(e) if isinstance(pk.get(e), dict) else {}
            pairs.setdefault(tname, [])
            if ent.get("vscode"):
                if ent["vscode"] not in pairs[tname]:
                    pairs[tname].append(ent["vscode"])
                if ent["vscode"] not in exts:
                    exts.append(ent["vscode"])
            elif ent.get("pkg"):
                if ent["pkg"] not in pairs[tname]:
                    pairs[tname].append(ent["pkg"])
                bucket = want["extra" if ent.get("repo") == "extra" else "aur"]
                if ent["pkg"] not in bucket:
                    bucket.append(ent["pkg"])
            elif ent.get("build"):
                if ent["build"] not in builds:
                    builds.append(ent["build"])
                pairs[tname].append("(build: %s)" % e)
            else:
                pairs[tname].append("(no package known for %s)" % e)
    if not pairs:
        print("nothing missing: every preferred theme of every pair is installed")
        return 0
    for tname in sorted(pairs):
        print("%-12s %s" % (tname, " ".join(pairs[tname])))
    print()
    if want["extra"]:
        print("sudo pacman -S --needed " + " ".join(sorted(want["extra"])))
    if want["aur"]:
        print("yay -S --needed " + " ".join(sorted(want["aur"])))
    for x in sorted(exts):
        print("code --install-extension " + x)
    for b in builds:
        print("# " + b)
    return 0


def main(argv=None):
    ap = argparse.ArgumentParser(prog="themectl", description="The desktop's theme generator (see the header of this file).",
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd")

    def common(p, dry=False):
        p.add_argument("--only", default="", help="comma-separated target names")
        p.add_argument("--skip", default="", help="comma-separated target names")
        p.set_defaults(dry=dry)
    common(sub.add_parser("apply"))
    s = sub.add_parser("set")
    s.add_argument("theme")
    s.add_argument("mode", nargs="?")
    common(s)
    common(sub.add_parser("toggle"))
    common(sub.add_parser("next"))
    d = sub.add_parser("diff")
    d.add_argument("theme", nargs="?")
    d.add_argument("mode", nargs="?")
    common(d, dry=True)
    ls = sub.add_parser("list")
    ls.add_argument("--json", action="store_true")
    sub.add_parser("doctor")
    sub.add_parser("packages")
    i = sub.add_parser("install")
    i.add_argument("--dry-run", action="store_true")
    mg = sub.add_parser("migrate")
    mg.add_argument("--dry-run", action="store_true")
    r = sub.add_parser("restore")
    r.add_argument("targets", nargs="*")
    r.add_argument("--dry-run", action="store_true")
    wp = sub.add_parser("wallpaper", help="the wallpapers of the current theme and mode (yazi's \"Set as wallpaper\" / \"Remove from wallpapers\")")
    wsub = wp.add_subparsers(dest="wcmd")
    ws = wsub.add_parser("set", help="add ONE image to the list and show it now")
    ws.add_argument("paths", nargs="*", help="exactly ONE image file (several are refused)")
    ws.add_argument("--no-notify", action="store_true", help="no notification, no Revert (for scripts)")
    wr = wsub.add_parser("remove", help="take ONE image out of the list (the last one of a slot is refused)")
    wr.add_argument("paths", nargs="*", help="exactly ONE file")
    wr.add_argument("--no-notify", action="store_true", help="no notification (for scripts)")
    wl = wsub.add_parser("list", help="the pictures of a slot and its current pick")
    wl.add_argument("theme", nargs="?")
    wl.add_argument("mode", nargs="?")
    wsub.add_parser("_prompt").add_argument("record")
    sub.add_parser("_evince")                    # the evince target's background half (t_evince)
    rs = sub.add_parser("resolve")
    rs.add_argument("--theme")
    rs.add_argument("--file")
    rs.add_argument("--l0", help="path of the Theme.qml whose defaults are L0")
    rs.add_argument("--mode", default="light", choices=MODES)
    try:
        args = ap.parse_args(argv)
    except SystemExit as e:
        return REFUSED if e.code not in (0, None) else 0
    if not args.cmd:
        ap.print_help()
        return REFUSED
    P = Paths()
    try:
        if args.cmd == "apply":
            return cmd_apply(P, args)
        if args.cmd == "set":
            return cmd_apply(P, args, args.theme, args.mode)
        if args.cmd == "toggle":
            return cmd_apply(P, args, toggle=True)
        if args.cmd == "next":
            return cmd_next(P, args)
        if args.cmd == "diff":
            return cmd_apply(P, args, args.theme, args.mode)
        if args.cmd == "list":
            return cmd_list(P, args)
        if args.cmd == "doctor":
            return cmd_doctor(P, args)
        if args.cmd == "packages":
            return cmd_packages(P, args)
        if args.cmd == "install":
            return cmd_install(P, args)
        if args.cmd == "migrate":
            return cmd_migrate(P, args)
        if args.cmd == "restore":
            return cmd_restore(P, args)
        if args.cmd == "resolve":
            return cmd_resolve(P, args)
        if args.cmd == "_evince":
            return cmd_evince_worker(P, args)
        if args.cmd == "wallpaper":
            if args.wcmd == "set":
                return cmd_wallpaper_set(P, args)
            if args.wcmd == "remove":
                return cmd_wallpaper_remove(P, args)
            if args.wcmd == "list":
                return cmd_wallpaper_list(P, args)
            if args.wcmd == "_prompt":
                return cmd_wallpaper_prompt(P, args)
            wp.print_help()
            return REFUSED
    except Refused as e:
        print("themectl: refused: %s" % e)
        return REFUSED
    return REFUSED


if __name__ == "__main__":
    sys.exit(main())

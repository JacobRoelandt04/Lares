# ================================================================================================= the wallpaper bag
# A SHUFFLE BAG per slot (theme + mode), the lock's veil bag ported: modules/lockscreen/lock/VeilBag.js is the other copy, and
# tools/dev/themectl_bag_parity.py holds the two to ONE case table (the same rnd in, the same picks and states out). A ROUND is a fresh
# Fisher-Yates permutation of the slot's pictures; a draw takes the next one off the front. Inside a round every picture comes once; a new
# round never starts with the picture the last one ended on, so any 2N-1 draws in a row show all N; a list that changed under a bag in
# use RECONCILES it (a picture taken out leaves the round at once, one put in joins it at a random place among those still to come).
# State: {"round": [...], "remaining": [...], "last": "the picture shown last"} -- `last` is the slot's current pick. `rnd` returns [0, 1).

def _bag_uniq(lst):
    out = []
    if isinstance(lst, str):                          # as VeilBag.js reads an array-like: a string is its characters (no file holds one)
        lst = list(lst)
    if not isinstance(lst, (list, tuple)):
        return out
    for n in lst:
        if isinstance(n, str) and n != "" and n not in out:
            out.append(n)
    return out


def _bag_int(rnd, n):
    return min(n - 1, int(math.floor(rnd() * n)))


def bag_empty():
    return {"round": [], "remaining": [], "last": ""}


def bag_state(obj):
    """A kept state (an object read from JSON) -> a state; anything unreadable is an empty bag."""
    if not isinstance(obj, dict):
        return bag_empty()
    last = obj.get("last")
    return {"round": _bag_uniq(obj.get("round")), "remaining": _bag_uniq(obj.get("remaining")), "last": last if isinstance(last, str) else ""}


def bag_parse(text):
    """VeilBag.parse: a state file's text -> a state."""
    try:
        return bag_state(json.loads(str(text)))
    except ValueError:
        return bag_empty()


def _bag_not_first(bag, last, rnd):
    if len(bag) > 1 and bag[0] == last:
        k = 1 + _bag_int(rnd, len(bag) - 1)
        bag[0], bag[k] = bag[k], bag[0]


def _bag_new_round(names, last, rnd):
    bag = list(names)
    for i in range(len(bag) - 1, 0, -1):
        j = _bag_int(rnd, i + 1)
        bag[i], bag[j] = bag[j], bag[i]
    _bag_not_first(bag, last, rnd)
    return bag


def _bag_reconcile(state, want, rnd):
    s = state or bag_empty()
    round_ = [n for n in _bag_uniq(s.get("round")) if n in want]
    remaining = [n for n in _bag_uniq(s.get("remaining")) if n in round_]
    for n in want:                                   # a picture put into the list since: it joins this round, among those still to come
        if n not in round_:
            round_.append(n)
            remaining.insert(_bag_int(rnd, len(remaining) + 1), n)
    return round_, remaining


def bag_draw(state, names, rnd):
    """VeilBag.draw: the next picture -> (name, state); name is "" when NAMES holds none."""
    want = _bag_uniq(names)
    s = state or bag_empty()
    if not want:
        return "", {"round": [], "remaining": [], "last": s.get("last") or ""}
    last = s.get("last") if isinstance(s.get("last"), str) else ""
    round_, remaining = _bag_reconcile(s, want, rnd)
    if not remaining:
        round_ = list(want)
        remaining = _bag_new_round(want, last, rnd)
    else:
        _bag_not_first(remaining, last, rnd)
    name = remaining.pop(0)
    return name, {"round": round_, "remaining": remaining, "last": name}


def bag_take(state, names, name, rnd):
    """themectl's own: NAME is shown now by hand (`wallpaper set`): reconciled with NAMES like a draw, then NAME counts as drawn -- it leaves
    the round's remaining pictures and is `last`, so the next draw is another one. -> state."""
    want = _bag_uniq(names)
    round_, remaining = _bag_reconcile(state, want, rnd)
    return {"round": round_, "remaining": [n for n in remaining if n != name], "last": name}


def bag_file(P):
    return P.state + "/theme/wallpaper-bag.json"


def load_bags(P):
    """The kept bags: {"version": 1, "shown": [theme, mode], "instance": "<HYPRLAND_INSTANCE_SIGNATURE>", "slots": {"<theme>.<mode>": state}}.
    `shown` and `instance` are what the wallpaper target last showed and in which Hyprland: a draw happens when either differs."""
    try:
        doc = load_json(bag_file(P))
    except (OSError, ValueError):
        doc = {}
    if not isinstance(doc, dict):
        doc = {}
    slots = doc.get("slots") if isinstance(doc.get("slots"), dict) else {}
    shown = doc.get("shown")
    return {"version": 1, "shown": list(shown) if isinstance(shown, list) and len(shown) == 2 else None,
            "instance": doc.get("instance") if isinstance(doc.get("instance"), str) else None,
            "slots": {k: bag_state(v) for k, v in slots.items() if isinstance(k, str)}}


def save_bags(P, doc):
    """Written only when it changed: an apply that shows what was shown writes nothing."""
    text = json.dumps(doc, indent=2, sort_keys=True) + "\n"
    if _read_text(bag_file(P)) != text:
        write_atomic(bag_file(P), text)


def slot_key(theme, mode):
    return "%s.%s" % (theme, mode)


# ============================================================================================ files, backups, locks


def write_atomic(path, data, mode=None):
    """Temp file in the same directory, then rename: a reader never sees half a file."""
    d = os.path.dirname(path)
    os.makedirs(d, exist_ok=True)
    fd, tmp = tempfile.mkstemp(prefix=".themectl-", dir=d)
    try:
        with os.fdopen(fd, "wb") as f:
            f.write(data if isinstance(data, bytes) else data.encode("utf-8"))
            f.flush()
            os.fsync(f.fileno())
        os.chmod(tmp, mode if mode is not None else 0o644)
        os.replace(tmp, path)
    except BaseException:
        with contextlib.suppress(OSError):
            os.unlink(tmp)
        raise


def _read_text(path):
    try:
        with open(path, encoding="utf-8") as f:
            return f.read()
    except (OSError, UnicodeDecodeError):
        return None


# ---------------------------------------------------------------------------------------------- JSON with comments

def jsonc_tokens(text):
    """The tokens of a JSON-with-comments text, as (kind, start, end): kind is one of  { } [ ] , :  or "s" (a string) or "w" (a
    bare word: a number, true, false, null). Whitespace, // and /* */ comments are skipped. ValueError on an unterminated string or
    comment. Trailing commas are tokens like any other: this reads settings.json the way VS Code does, and judges nothing."""
    i, n = 0, len(text)
    while i < n:
        c = text[i]
        if c in " \t\r\n\ufeff":
            i += 1
        elif text.startswith("//", i):
            j = text.find("\n", i)
            i = n if j < 0 else j + 1
        elif text.startswith("/*", i):
            j = text.find("*/", i + 2)
            if j < 0:
                raise ValueError("an unterminated /* comment")
            i = j + 2
        elif c == '"':
            j = i + 1
            while j < n and text[j] != '"':
                j += 2 if text[j] == "\\" else 1
            if j >= n:
                raise ValueError("an unterminated string")
            yield "s", i, j + 1
            i = j + 1
        elif c in "{}[],:":
            yield c, i, i + 1
            i += 1
        else:
            j = i
            while j < n and text[j] not in " \t\r\n{}[],:\"/":
                j += 1
            if j == i:                              # a lone "/" or another stray character
                raise ValueError("unexpected %r at offset %d" % (c, i))
            yield "w", i, j
            i = j


def jsonc_find(text, key):
    """-> ("found", start, end) of the VALUE of top-level `key` (its token), ("absent", pos, has_members) with pos just after the
    top-level object's `{`, or raises ValueError (not an object, unreadable, a malformed member)."""
    toks = list(jsonc_tokens(text))
    if not toks or toks[0][0] != "{":
        raise ValueError("the file is not a JSON object")
    depth, i = 0, 0
    while i < len(toks):
        k, s, e = toks[i]
        if k in "{[":
            depth += 1
        elif k in "}]":
            depth -= 1
        elif k == "s" and depth == 1 and toks[i - 1][0] in "{,":
            if i + 2 >= len(toks) or toks[i + 1][0] != ":":
                raise ValueError("a member without its value at offset %d" % s)
            if json.loads(text[s:e]) == key:
                v = toks[i + 2]
                if v[0] in "{[":
                    raise ValueError("%s is an object or a list, not a string" % key)
                return "found", v[1], v[2]
        i += 1
    return "absent", toks[0][2], len(toks) > 1 and toks[1][0] != "}"


def jsonc_set(text, key, value):
    """The text with top-level `key` set to the string `value` and NOTHING else touched: the comments, the trailing commas, the
    order and the spacing stay (a json.load / json.dump round trip would drop every comment, and the file has them). A key that is
    not there is added as the first member. ValueError (nothing to write) when the file cannot be read as an object, or when the
    key's present value is not a string."""
    new = json.dumps(value, ensure_ascii=False)
    kind, a, b = jsonc_find(text, key)
    if kind == "found":
        if not text[a:b].startswith('"'):
            raise ValueError("%s is %s, not a string" % (key, text[a:b]))
        out = text[:a] + new + text[b:]
    else:
        out = text[:a] + '\n  %s: %s%s' % (json.dumps(key), new, "," if b else "\n") + text[a:]
    kind, a, b = jsonc_find(out, key)                # what is written reads back as what was asked for
    if kind != "found" or json.loads(out[a:b]) != value:
        raise ValueError("the edit did not read back (nothing written)")
    return out


@contextlib.contextmanager
def locked(P):
    """One themectl at a time (a double click is two toggles, one after the other)."""
    os.makedirs(P.theme_dir, exist_ok=True)
    fd = os.open(P.lock_file, os.O_CREAT | os.O_RDWR, 0o644)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX)
        yield
    finally:
        os.close(fd)


def _manifest_path(P):
    return P.backup_dir + "/manifest.json"


def load_manifest(P):
    try:
        return load_json(_manifest_path(P))
    except (OSError, ValueError):
        return {}


def own_file(P, path):
    """The first time themectl owns PATH, keep what was there. Raises OSError if it cannot (then nothing is written)."""
    man = load_manifest(P)
    if path in man:
        return False
    entry = {"at": datetime.datetime.now().astimezone().isoformat(timespec="seconds")}
    if os.path.islink(path):
        entry.update(kind="symlink", link=os.readlink(path))
    elif os.path.exists(path):
        os.makedirs(P.backup_dir + "/files", exist_ok=True)
        n = len(man)
        rel = "files/%03d-%s" % (n, os.path.basename(path))
        shutil.copy2(path, P.backup_dir + "/" + rel)
        entry.update(kind="file", backup=rel, sha256=hashlib.sha256(open(path, "rb").read()).hexdigest())
    else:
        entry.update(kind="absent")
    man[path] = entry
    write_atomic(_manifest_path(P), json.dumps(man, indent=2, sort_keys=True) + "\n")
    return True


def guard_output(P, path):
    """A targets.json typo must not scribble over /etc: outputs live under HOME or an XDG directory."""
    real = os.path.realpath(os.path.dirname(path))
    roots = [os.path.realpath(x) for x in (P.home, P.config, P.cache, P.state, P.data)]
    if not any(real == r or real.startswith(r + "/") for r in roots):
        raise Refused("%s is outside HOME" % path)


# ================================================================================================ the template engine


TOKEN_RE = re.compile(r"\{\{\s*([A-Za-z_][A-Za-z0-9_.]*)\s*(?:\|\s*([A-Za-z]+)\s*)?\}\}")


class TemplateError(Exception):
    pass


def render(text, ctx, values, name="template"):
    """{{ key }} / {{ key | fmt }}: key is a context entry (theme, mode, assets.x, output, ...) or a resolved token.
    A colour is formatted by fmt ('' -> #RRGGBB, hex -> RRGGBB, hexa -> RRGGBBAA, rgb -> r, g, b), or replaced by its ink (ink -> the one of
    the theme's two text colours, textPrimary and textOnAccent, with the higher WCAG contrast on it, as #RRGGBB: a warning yellow in a light
    mode reads ~2.4:1 with the light text-on-accent)."""
    def sub(m):
        key, fmt = m.group(1), m.group(2) or ""
        line = text.count("\n", 0, m.start()) + 1
        if key in ctx:
            if fmt:
                raise TemplateError("%s line %d: %s takes no format" % (name, line, key))
            return str(ctx[key])
        if key not in values:
            raise TemplateError("%s line %d: unknown token \"%s\"" % (name, line, key))
        v = values[key]
        if isinstance(v, list) and fmt == "ink":
            inks = [values.get(k) for k in ("textPrimary", "textOnAccent")]
            if not all(isinstance(c, list) for c in inks):
                raise TemplateError("%s line %d: %s|ink needs the colours textPrimary and textOnAccent" % (name, line, key))
            return fmt_colour(max(inks, key=lambda c: wcag_contrast(v, c)), "")
        if isinstance(v, list):
            try:
                return fmt_colour(v, fmt)
            except ValueError as e:
                raise TemplateError("%s line %d: %s" % (name, line, e))
        if fmt:
            raise TemplateError("%s line %d: \"%s\" is not a colour (%s)" % (name, line, key, fmt))
        return str(v)
    return TOKEN_RE.sub(sub, text)


# ========================================================================================================== targets


class Fail(Exception):
    """A target failed: the reason is the message."""


def run_cmd(argv, timeout, cwd=None, extra_env=None):
    env = dict(os.environ)
    env.update(extra_env or {})
    try:
        p = subprocess.run(argv, stdin=subprocess.DEVNULL, capture_output=True, text=True, timeout=timeout, env=env, cwd=cwd)
    except FileNotFoundError:
        raise Fail("%s: command not found" % argv[0])
    except subprocess.TimeoutExpired:
        raise Fail("%s: timed out after %ds" % (argv[0], timeout))
    except OSError as e:
        raise Fail("%s: %s" % (argv[0], e))
    return p


def _first_line(s):
    for l in (s or "").splitlines():
        if l.strip():
            return l.strip()[:200]
    return ""


def shell_theme_block(P):
    """The `theme` object of the user's shell.jsonc (comments allowed; `.jsonc` first, `.json` when there is none). {} when the file is
    absent, does not parse, or has no such object: the wallpaper target then says it has nothing to set, it never fails over a typo
    in a file the shell reports itself (ShellConfig.lastError)."""
    import importlib.util
    spec = importlib.util.spec_from_file_location("themectl_jsonc", os.path.join(P.repo, "tools", "lib", "jsonc.py"))
    mod = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(mod)
    try:
        doc = mod.load(P.shell_config)
    except (OSError, ValueError):
        return {}
    t = doc.get("theme") if isinstance(doc, dict) else None
    return t if isinstance(t, dict) else {}


def target_off(P, spec, only=None):
    """Why a target does not run, "" when it does: switched off in targets.json, or by the user's shell.jsonc ("theme": { "targets":
    { "evince": false } }). `lares`, the state the shell itself reads, has no switch; a target named by --only runs whatever shell.jsonc says."""
    if spec.get("enabled", True) is False:
        return "disabled in targets.json"
    off = shell_theme_block(P).get("targets")
    if spec["name"] != "lares" and spec["name"] not in (only or []) and isinstance(off, dict) and off.get(spec["name"]) is False:
        return 'off in shell.jsonc ("theme" "targets")'
    return ""


def pair_order(P):
    """The pairs to cycle through: shell.jsonc's "theme": { "pairs": [...] }, those of them that are there, in its order; every pair by name
    without it (or when it names none that is there)."""
    names = sorted(theme_files(P))
    want = shell_theme_block(P).get("pairs")
    listed = [n for n in want if n in names] if isinstance(want, list) else []
    return listed or names


FIT_MODES = ("cover", "contain", "tile", "fill")


def wallpaper_slot(P, theme, mode):
    """The wallpapers shell.jsonc names for THEME and MODE, or None when it names none:

        "theme": { "wallpapers": { "eva": { "light": ["~/Pictures/wallpapers/dunes.jpeg", "~/Pictures/wallpapers/sky.png"],
                                            "dark": "~/Pictures/wallpapers/flower.png" } },
                   "wallpaperFit": "cover" }

    A slot is a path or a list of paths (a string is a list of one); the wallpaper target draws one of a list from the slot's bag. A
    path takes ~ and ${XDG_*}; a relative one is refused (the file hyprpaper reads must not depend on where it was started). There is no
    other source (the HyprV backgrounds directory and the theme file's `assets.<mode>.wallpaper` are not read).
    -> {"where", "entries": [(as written, absolute)] (repeats dropped), "paths": the absolute ones that exist, "missing": the others, "fit"}.
    Fail: a slot of another shape, a relative path, a bad fit."""
    block = shell_theme_block(P)
    wps = block.get("wallpapers")
    pair = wps.get(theme) if isinstance(wps, dict) else None
    raw = pair.get(mode) if isinstance(pair, dict) else None
    where = "shell.jsonc theme.wallpapers.%s.%s" % (theme, mode)
    if raw is None or raw == "" or raw == []:
        return None
    entries = []
    for r in (raw if isinstance(raw, list) else [raw]):
        if not isinstance(r, str) or r == "":
            raise Fail("%s must be a path or a list of paths, not %s" % (where, json.dumps(raw)))
        path = P.expand(r)
        if not os.path.isabs(path):
            raise Fail("%s: %s is not an absolute path (use ~/... or /...)" % (where, r))
        path = os.path.normpath(path)
        if path not in [e[1] for e in entries]:
            entries.append((r, path))
    fit = block.get("wallpaperFit", "cover")
    if fit not in FIT_MODES:
        raise Fail("shell.jsonc theme.wallpaperFit must be one of %s, not %s" % (", ".join(FIT_MODES), json.dumps(fit)))
    return {"where": where, "entries": entries, "paths": [p for _, p in entries if os.path.exists(p)],
            "missing": [p for _, p in entries if not os.path.exists(p)], "fit": fit}


# The tokens that only a program's template reads, which a theme may leave out: the token each one then is. A pair whose legacy
# file drew these apart from its accent or its ok (everbox's starship head, hyprlock's field) says so; eva renders as it always did.
# hyprGroupTab is the active tab hypr-group-tabs draws inside a group's border (groupbar col.active): it must stand apart from the border.
# The prompt's ramp is a flat accent bar in a theme that names none: its four colours are slots of KITTY's file now (the prompt prints
# slot numbers so that old prompts follow a switch: templates/starship.toml), and a theme without a ramp must not cost kitty its colours.
FALLBACKS = {"starshipHead": "accent", "starshipOk": "ok", "starshipError": "error", "lockField": "panelSunk", "lockCaps": "ansiBrightYellow",
             "hyprGroupTab": "warn", "starshipRamp0": "accent", "starshipRamp1": "accent", "starshipRamp2": "accent", "starshipRamp3": "accent"}


# ASSET PREFERENCE LISTS. An asset that names an installed theme (gtkTheme, iconTheme, vscodeTheme) may be a LIST: the first entry that
# is installed wins; none installed, the LAST entry is applied as it always was (so a list ends with today's fallback, and a user who
# installs nothing gets the same writes as with a plain string). A string is a list of one. themes/*.json carries the lists,
# tools/theme/packages.json says what installs each name, `doctor` and `packages` report the gap.
LIST_ASSETS = {"gtkTheme": "gtk", "iconTheme": "icon", "vscodeTheme": "vscode"}


def _data_dirs(P):
    dirs = [P.data] + [d for d in (os.environ.get("XDG_DATA_DIRS") or "/usr/local/share:/usr/share").split(":") if d]
    return dirs


def vscode_theme_names(P):
    """The theme names VS Code knows here (its built-ins and the user's extensions): a set, or None when no VS Code is installed (read only)."""
    names, found = set(), False
    for d in (P.home + "/.vscode/extensions", "/usr/share/code/resources/app/extensions", "/opt/visual-studio-code/resources/app/extensions"):
        if not os.path.isdir(d):
            continue
        found = True
        try:
            entries = os.listdir(d)
        except OSError:
            continue
        for e in entries:
            try:
                with open(os.path.join(d, e, "package.json"), encoding="utf-8") as f:
                    pj = json.load(f)
            except (OSError, ValueError):
                continue
            for th in ((pj.get("contributes") or {}).get("themes") or []) if isinstance(pj, dict) else []:
                if isinstance(th, dict):
                    names.add(th.get("id") or th.get("label"))
    return names if found else None


def asset_installed(P, kind, name):
    """Is the theme NAME of this kind installed? True / False; None for 'cannot tell' (no VS Code at all). GTK: a directory of that name in
    the themes directories holding index.theme or a gtk-3.0 / gtk-4.0 folder; icons: one holding index.theme; VS Code: a theme of that name."""
    if kind == "gtk":
        for base in [P.home + "/.themes"] + [d + "/themes" for d in _data_dirs(P)]:
            d = base + "/" + name
            if os.path.isdir(d) and any(os.path.exists(d + "/" + x) for x in ("index.theme", "gtk-3.0", "gtk-4.0")):
                return True
        return False
    if kind == "icon":
        return any(os.path.isfile(base + "/" + name + "/index.theme") for base in [P.home + "/.icons"] + [d + "/icons" for d in _data_dirs(P)])
    if kind == "vscode":
        names = vscode_theme_names(P)
        return None if names is None else name in names
    return None


def resolve_assets(P, raw):
    """The assets of one mode with every list taken to the entry in force -> (assets, errors, picks). picks[key] = (chosen, entries,
    states) for a LIST only: states[i] is True / False / None (cannot tell) for entries[i]; chosen is the first True, else the last."""
    assets, errors, picks = {}, {}, {}
    for k, v in raw.items():
        if k in LIST_ASSETS and isinstance(v, list):
            if not v or not all(isinstance(x, str) and x for x in v):
                errors[k] = "assets.%s is a list that is empty or holds something that is not a theme name" % k
                continue
            states = [asset_installed(P, LIST_ASSETS[k], x) for x in v]
            chosen = next((x for x, s in zip(v, states) if s), v[-1])
            assets[k] = chosen
            picks[k] = (chosen, list(v), states)
        else:
            assets[k] = v
    return assets, errors, picks


def load_packages(P):
    """tools/theme/packages.json (and ~/.config/theme/packages.json over it, as targets.json): theme name -> {"repo": "extra" | "aur", "pkg": name}
    or {"build": "a command"}; {} when there is none."""
    out = {}
    for f in (P.tools + "/packages.json", P.theme_dir + "/packages.json"):
        try:
            d = load_json(f)
        except (OSError, ValueError):
            continue
        if isinstance(d, dict) and isinstance(d.get("themes"), dict):
            out.update(d["themes"])
    return out


def package_hint(pk, name):
    e = pk.get(name)
    if not isinstance(e, dict):
        return "no package known"
    if e.get("vscode"):
        return "code --install-extension %s" % e["vscode"]
    if e.get("pkg"):
        return "%s %s" % ("sudo pacman -S" if e.get("repo") == "extra" else "yay -S", e["pkg"])
    return e.get("build") or "no package known"


def package_report(P):
    """Per theme and mode, every asset that is a list: [(theme, mode, key, chosen, entries, states)] -- for `doctor` and `packages`."""
    rows = []
    for name in sorted(theme_files(P)):
        try:
            th = load_theme(P, name)
        except Refused:
            continue
        for mode in MODES:
            _, _, picks = resolve_assets(P, th.assets(mode))
            for k, (chosen, entries, states) in picks.items():
                rows.append((name, mode, k, chosen, entries, states))
    return rows


class Ctx:
    """What a target sees: the paths, the options, the theme + mode, its resolved tokens and its assets."""

    def __init__(self, P, options, theme, mode, dry):
        self.P, self.options, self.theme, self.mode, self.dry = P, options, theme, mode, dry
        self.values, self.errors = theme.mode_values(mode)
        for k, v in FALLBACKS.items():
            if k not in self.values and v in self.values:
                self.values[k] = self.values[v]
        self.assets, self.asset_errors, self.asset_picks = resolve_assets(P, theme.assets(mode))
        self.timeout = int(options.get("timeoutSec", 20))
        self.extra = {}                              # entries a target adds for its own templates (t_wallpaper: wallpaperPath, wallpaperFit)

    def base(self):
        c = {"theme": self.theme.name, "mode": self.mode}
        c.update(self.extra)
        for k, v in self.assets.items():
            c["assets." + k] = v
        return c

    def need_assets(self, names):
        for n in names or []:
            if n in self.asset_errors:
                raise Fail("theme %s, %s: %s" % (self.theme.name, self.mode, self.asset_errors[n]))
            if n not in self.assets:
                raise Fail("theme %s has no assets.%s.%s" % (self.theme.name, self.mode, n))

    def template(self, name):
        for d in (self.P.theme_dir + "/templates", self.P.tools + "/templates"):
            p = d + "/" + name
            t = _read_text(p)
            if t is not None:
                return t, p
        raise Fail("template %s not found (looked in %s/templates and %s/templates)" % (name, self.P.theme_dir, self.P.tools))

    def render(self, text, name, extra=None):
        c = self.base()
        c.update(extra or {})
        try:
            return render(text, c, self.values, name)
        except TemplateError as e:
            raise Fail("template: %s" % e)


def _udiff(old, new, path):
    a = (old or "").splitlines(keepends=True)
    b = new.splitlines(keepends=True)
    return "".join(difflib.unified_diff(a, b, "now: " + path, "themectl: " + path))


def _include_note(spec, P):
    """' [not used yet: ...]' when the app's own config lacks the line that makes it read the file themectl owns."""
    inc = spec.get("include")
    if not inc:
        return ""
    f = P.expand(inc["file"])
    text = _read_text(f)
    if text is None:
        return " [not used yet: %s is missing; it needs: %s]" % (f, inc["line"])
    if not re.search(inc["pattern"], text, re.M):
        return " [not used yet: add to %s: %s]" % (f, inc["line"])
    return ""


def _do_reload(spec, ctx, out, changed):
    rl = spec.get("reload")
    if not rl:
        return ""
    when = rl.get("when", "changed")
    if when == "changed" and not changed:
        return ""
    argv = [ctx.render(a, spec["name"] + " reload", {"output": out}) for a in rl["argv"]]
    if ctx.dry:
        return "; would run: " + " ".join(argv)
    p = run_cmd(argv, ctx.timeout)
    ok_codes = rl.get("okCodes", [0])
    text = (p.stdout or "").strip()
    if p.returncode not in ok_codes:
        raise Fail("%s: exit %d: %s" % (" ".join(argv[:2]), p.returncode, _first_line(p.stderr) or _first_line(p.stdout) or "no output"))
    expect = rl.get("expect")
    if expect and not re.search(expect, text):
        raise Fail("%s: %s" % (" ".join(argv[:2]), _first_line(text) or _first_line(p.stderr) or "no answer"))
    return "; " + (rl.get("label") or " ".join(argv[:2])) + (" (nothing running)" if p.returncode != 0 else "")


def t_state(spec, ctx):
    P = ctx.P
    want = state_text(ctx.theme.name, ctx.mode)
    cur = _read_text(P.state_file)
    if cur == want:
        return "state.json: %s %s" % (ctx.theme.name, ctx.mode), ""
    diff = _udiff(cur, want, P.state_file)
    if ctx.dry:
        return "would write state.json: %s %s" % (ctx.theme.name, ctx.mode), diff
    try:
        write_atomic(P.state_file, want)
    except OSError as e:
        raise Fail("cannot write %s: %s" % (P.state_file, e))
    return "state.json: %s %s (changed)" % (ctx.theme.name, ctx.mode), diff


def t_file(spec, ctx):
    P = ctx.P
    ctx.need_assets(spec.get("needs"))
    out = P.expand(spec["output"])
    tpl, tpath = ctx.template(spec["template"])
    new = ctx.render(tpl, spec["template"], {"output": out})
    try:
        guard_output(P, out)
    except Refused as e:
        raise Fail(str(e))
    cur = _read_text(out) if not os.path.islink(out) or os.path.exists(out) else None
    is_link = os.path.islink(out)
    changed = cur != new or is_link
    diff = _udiff(cur, new, out) if cur != new else ""
    if is_link and cur == new:
        diff = "(same text; the symlink %s -> %s becomes a file themectl owns)\n" % (out, os.readlink(out))
    if ctx.dry:
        msg = ("would write %s" % out) if changed else "unchanged: %s" % out
        return msg + _do_reload(spec, ctx, out, changed) + _include_note(spec, P), diff
    if changed:
        try:
            own_file(P, out)
        except OSError as e:
            raise Fail("cannot keep the original of %s (nothing written): %s" % (out, e))
        try:
            write_atomic(out, new)
        except OSError as e:
            raise Fail("cannot write %s: %s" % (out, e))
    msg = ("wrote %s" % out) if changed else "unchanged: %s" % out
    return msg + _do_reload(spec, ctx, out, changed) + _include_note(spec, P), diff


def _install_shipped(P, src, dst):
    """Copy a file the repo ships (tools/theme/<shipped>/) to DST in an app's directory, keeping what was there first (own_file: an absent
    original is recorded as absent, so `restore` takes the copy away again). The repo's mtime goes with it: `install` keeps a copy that is
    newer than the repo's (someone edited it) and refreshes an older one."""
    guard_output(P, dst)
    own_file(P, dst)
    d = os.path.dirname(dst)
    os.makedirs(d, exist_ok=True)
    tmp = tempfile.mktemp(prefix=".themectl-", dir=d)
    try:
        shutil.copy2(src, tmp)
        os.replace(tmp, dst)
    except OSError:
        with contextlib.suppress(OSError):
            os.unlink(tmp)
        raise


def t_link(spec, ctx):
    """output -> target (absolute, or relative to output's directory), kept in step with the mode. Like a `file` target it can name an
    include (the app's own line that reads the link) and a reload, which runs when the link moved: btop's `current.theme` is a link
    to the theme of the mode, and btop re-reads the file its link names on SIGUSR2.

    `shipped`: a directory under tools/theme/ of files the repo ships for this target (btop's custom themes, the fastfetch logos). A
    target that is a bare file name, absent next to the link and shipped there, is copied in first (`_install_shipped`); a copy that is
    already there is used as it is (`themectl install` refreshes it)."""
    P = ctx.P
    ctx.need_assets(spec.get("needs"))
    out = P.expand(spec["output"])
    target = ctx.render(spec["target"], spec["name"] + " target")
    try:
        guard_output(P, out)
    except Refused as e:
        raise Fail(str(e))
    resolved = target if os.path.isabs(target) else os.path.join(os.path.dirname(out), target)
    installed = ""
    if not os.path.exists(resolved) and spec.get("shipped") and "/" not in target:
        src = os.path.join(P.tools, spec["shipped"], target)
        if os.path.isfile(src):
            if ctx.dry:
                installed = "would install %s from %s; " % (resolved, src)
            else:
                try:
                    _install_shipped(P, src, resolved)
                except (OSError, Refused) as e:
                    raise Fail("cannot install %s (nothing linked): %s" % (resolved, e))
                installed = "installed %s; " % resolved
        else:
            raise Fail("%s does not exist, and %s/%s ships no %s (the link would dangle)" % (resolved, os.path.basename(P.tools), spec["shipped"], target))
    if not installed and not os.path.exists(resolved):
        raise Fail("%s does not exist (the link would dangle)" % resolved)
    cur = os.readlink(out) if os.path.islink(out) else None
    changed = cur != target
    was = ("%s -> %s" % (out, cur)) if cur else out + (" (a file, not a link)" if os.path.lexists(out) else " (absent)")
    diff = "" if not changed else "-%s\n+%s\n" % (was, "%s -> %s" % (out, target))
    if ctx.dry:
        return installed + (("would link %s -> %s" % (out, target)) if changed else "unchanged: %s -> %s" % (out, target)) + _do_reload(spec, ctx, out, changed) + _include_note(spec, P), diff
    if changed:
        try:
            own_file(P, out)
        except OSError as e:
            raise Fail("cannot keep the original of %s (nothing written): %s" % (out, e))
        d = os.path.dirname(out)
        os.makedirs(d, exist_ok=True)
        tmp = tempfile.mktemp(prefix=".themectl-", dir=d)
        try:
            os.symlink(target, tmp)
            os.replace(tmp, out)
        except OSError as e:
            with contextlib.suppress(OSError):
                os.unlink(tmp)
            raise Fail("cannot link %s: %s" % (out, e))
    return installed + (("linked %s -> %s" % (out, target)) if changed else "unchanged: %s -> %s" % (out, target)) + _do_reload(spec, ctx, out, changed) + _include_note(spec, P), diff


def _gs_quote(v):
    return "'" + v.replace("\\", "\\\\").replace("'", "\\'") + "'"


def t_gsettings(spec, ctx):
    ctx.need_assets(spec.get("needs"))
    lines, did = [], []
    for item in spec["keys"]:
        want = ctx.render(item["value"], spec["name"] + " " + item["key"])
        p = run_cmd(["gsettings", "get", item["schema"], item["key"]], ctx.timeout)
        if p.returncode != 0:
            raise Fail("gsettings get %s %s: %s" % (item["schema"], item["key"], _first_line(p.stderr) or "exit %d" % p.returncode))
        cur = p.stdout.strip()
        if cur == _gs_quote(want):
            continue
        lines.append("-%s %s = %s\n+%s %s = %s\n" % (item["schema"], item["key"], cur, item["schema"], item["key"], _gs_quote(want)))
        if not ctx.dry:
            q = run_cmd(["gsettings", "set", item["schema"], item["key"], want], ctx.timeout)
            if q.returncode != 0:
                raise Fail("gsettings set %s %s: %s" % (item["schema"], item["key"], _first_line(q.stderr) or "exit %d" % q.returncode))
        did.append(item["key"])
    if not did:
        return "unchanged: " + ", ".join(i["key"] for i in spec["keys"]), ""
    return ("would set " if ctx.dry else "set ") + ", ".join(did), "".join(lines)


EVINCE_KEY = "metadata::evince::inverted-colors"


def _evince_docs(P):
    """file:// URIs evince has opened, newest list GTK keeps ($XDG_DATA_HOME/recently-used.xbel, bookmarks whose application runs
    evince); [] when there is none."""
    import xml.etree.ElementTree as ET
    out = []
    try:
        root = ET.parse(P.data + "/recently-used.xbel").getroot()
    except (OSError, ET.ParseError):
        return out
    for bm in root.iter("bookmark"):
        href = bm.get("href") or ""
        if not href.startswith("file://"):
            continue
        apps = [a for a in bm.iter() if a.tag.endswith("}application") or a.tag == "bookmark:application"]
        if any("evince" in (a.get("exec") or "").lower() for a in apps):      # GTK writes 'org.gnome.Evince %u'
            out.append(href)
    return out


def _evince_gio():
    try:
        import gi
        gi.require_version("Gio", "2.0")
        from gi.repository import Gio, GLib
        return Gio, GLib
    except (ImportError, ValueError):
        return None, None


def _evince_doc_pass(P, want, dry):
    """(2): every document whose metadata holds a copy of the default gets WANT ("1"/"0"). -> (changed, of_with_a_copy)."""
    Gio, _ = _evince_gio()
    if Gio is None:
        return 0, 0
    changed = held = 0
    for uri in _evince_docs(P):
        f = Gio.File.new_for_uri(uri)
        try:
            cur = f.query_info(EVINCE_KEY, Gio.FileQueryInfoFlags.NONE, None).get_attribute_string(EVINCE_KEY)
        except Exception:                                # noqa: BLE001 -- gone, unreadable, no metadata store: not ours to judge
            continue
        if cur is None:
            continue
        held += 1
        if cur == want:
            continue
        if not dry:
            try:
                f.set_attribute_string(EVINCE_KEY, want, Gio.FileQueryInfoFlags.NONE, None)
            except Exception:                            # noqa: BLE001
                continue
        changed += 1
    return changed, held


def _evince_window_pass(want, dry):
    """(3): every evince process on the session bus, every window it exports: its stateful `inverted-colors` action set to WANT.
    -> (changed, windows)."""
    Gio, GLib = _evince_gio()
    if Gio is None:
        return 0, 0
    try:
        bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)
        names = bus.call_sync("org.freedesktop.DBus", "/org/freedesktop/DBus", "org.freedesktop.DBus", "ListNames", None,
                              GLib.VariantType("(as)"), Gio.DBusCallFlags.NONE, 2000, None).unpack()[0]
    except Exception:                                    # noqa: BLE001 -- no session bus: no window to tell
        return 0, 0
    # An evince process holds TWO connections, and the later one (the GVfs client's) never answers a call: asked, it costs the whole
    # timeout (2 s a switch, measured). The application's is the one it made first, at its start: per process, the connections are
    # asked oldest first and the first that lists windows is the one.
    procs = {}
    for name in names:
        if not name.startswith(":"):
            continue
        try:
            pid = bus.call_sync("org.freedesktop.DBus", "/org/freedesktop/DBus", "org.freedesktop.DBus", "GetConnectionUnixProcessID",
                                GLib.Variant("(s)", (name,)), GLib.VariantType("(u)"), Gio.DBusCallFlags.NONE, 1000, None).unpack()[0]
            with open("/proc/%d/comm" % pid) as fh:
                if fh.read().strip() != "evince":
                    continue
        except Exception:                                # noqa: BLE001 -- gone meanwhile, not ours
            continue
        procs.setdefault(pid, []).append(name)
    changed = windows = 0
    for conns in procs.values():
        for name in sorted(conns, key=lambda n: [int(x) if x.isdigit() else 0 for x in n[1:].split(".")]):
            try:
                xml = bus.call_sync(name, "/org/gnome/Evince/window", "org.freedesktop.DBus.Introspectable", "Introspect", None,
                                    GLib.VariantType("(s)"), Gio.DBusCallFlags.NONE, 2000, None).unpack()[0]
            except Exception:                            # noqa: BLE001
                continue
            nodes = re.findall(r'<node name="(\d+)"', xml)
            if nodes:
                break
        else:
            continue
        for node in nodes:
            path = "/org/gnome/Evince/window/" + node
            try:
                d = bus.call_sync(name, path, "org.gtk.Actions", "Describe", GLib.Variant("(s)", ("inverted-colors",)),
                                  GLib.VariantType("((bgav))"), Gio.DBusCallFlags.NONE, 2000, None).unpack()[0]
            except Exception:                            # noqa: BLE001
                continue
            windows += 1
            if d[2] and bool(d[2][0]) == want:
                continue
            if not dry:
                try:
                    bus.call_sync(name, path, "org.gtk.Actions", "SetState",
                                  GLib.Variant("(sva{sv})", ("inverted-colors", GLib.Variant("b", want), {})),
                                  None, Gio.DBusCallFlags.NONE, 2000, None)
                except Exception:                        # noqa: BLE001
                    continue
            changed += 1
    return changed, windows


def t_evince(spec, ctx):
    """Evince (48) inverts a document's colours in the modes `invertIn` names (default ["dark"]). It keeps that state in THREE places,
    and a switch writes all three:
    (1) the default for a document opened for the first time: gsettings `org.gnome.Evince.Default inverted-colors`;
    (2) every document opened before: evince COPIES the default into the file's GVfs metadata (`metadata::evince::inverted-colors`,
        "0" / "1") at its first open and reads that copy ever after, so a default alone changes nothing already seen (the user: "when I
        open a pdf document again that was inverted in colors, it is still inverted"). The documents are the ones GTK's recent list
        names with evince as their application and that hold the copy; one older than the list keeps its copy until Ctrl+I there;
    (3) a window open now: its stateful window action `inverted-colors` (org.gtk.Actions, /org/gnome/Evince/window/N on each evince
        process's bus name) inverts the page at once, and evince then writes that document's copy itself.
    No Evince schema (not installed) is 'skipped'. (2) and (3) need GIO from python (gi) and a session bus; without them only (1) runs.
    A real switch writes the wish and leaves the three to a detached worker (below: the curtain waits for themectl to exit); a dry run
    (diff) counts them in place. Proven on the real evince: tools/dev/themectl_evince_env_probe.sh."""
    want = ctx.mode in spec.get("invertIn", ["dark"])
    schema = spec.get("schema", "org.gnome.Evince.Default")
    if not _evince_installed(schema):
        return "skipped: evince is not installed (no %s schema)" % schema, ""
    state = "inverted" if want else "not inverted"
    if ctx.dry:
        did, lines, held, nwin = _evince_apply(spec, want, ctx.P, True, ctx.timeout)
        if not did:
            return "unchanged: %s (%d documents, %d windows)" % (state, held, nwin), ""
        return "would set " + state + ": " + ", ".join(did), "".join(lines)
    # THE BACKGROUND HALF (the user, 2026-11-12: a switch "used to feel faster"). The curtain reveals only when themectl has EXITED,
    # and this target cost the switch its whole run (~250 ms measured on the user's data: GIO 86, the window's reply after evince has
    # re-rendered its page 125, the copies 20; +650-950 ms in the shell's log). Nothing here has to be finished before the curtain
    # opens -- the open window flips while the reveal runs -- so the wish is written down and a detached worker (`themectl _evince`)
    # carries it out: one at a time (a lock), and always the LAST wish (it re-reads it before it lets go). A wish already made is not
    # made again: an apply in the same mode writes nothing and starts nothing, like every other target.
    wish = "1\n" if want else "0\n"
    if _read_text(_evince_want_file(ctx.P)) == wish:
        return "unchanged: %s" % state, ""
    try:
        write_atomic(_evince_want_file(ctx.P), wish)
    except OSError as e:
        raise Fail("cannot write %s: %s" % (_evince_want_file(ctx.P), e))
    try:
        subprocess.Popen([sys.executable, os.path.realpath(__file__), "_evince"], stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL, start_new_session=True, close_fds=True)
    except OSError as e:
        raise Fail("cannot start the background half: %s" % e)
    return "set %s: the default, the recent documents and the open windows follow in the background" % state, ""


def _evince_installed(schema):
    """The schema's XML is installed beside the compiled schemas (XDG_DATA_DIRS/glib-2.0/schemas): a file test, not a gsettings fork."""
    dirs = [d for d in (os.environ.get("XDG_DATA_DIRS") or "/usr/local/share:/usr/share").split(":") if d]
    base = schema.rsplit(".", 1)[0] if schema.endswith(".Default") else schema
    return any(os.path.exists("%s/glib-2.0/schemas/%s.gschema.xml" % (d, base)) for d in dirs)


def _evince_want_file(P):
    return P.state + "/theme/evince-want"


def _evince_apply(spec, want, P, dry, timeout):
    """The three places (t_evince) set to WANT, or with DRY only counted. -> (did, diff lines, documents holding a copy, windows)."""
    schema, key = spec.get("schema", "org.gnome.Evince.Default"), spec.get("key", "inverted-colors")
    p = run_cmd(["gsettings", "get", schema, key], timeout)
    if p.returncode != 0:
        raise Fail("gsettings get %s %s: %s" % (schema, key, _first_line(p.stderr) or "exit %d" % p.returncode))
    cur = p.stdout.strip()
    word = "true" if want else "false"
    did, lines = [], []
    if cur != word:
        lines.append("-%s %s = %s\n+%s %s = %s\n" % (schema, key, cur, schema, key, word))
        if not dry:
            q = run_cmd(["gsettings", "set", schema, key, word], timeout)
            if q.returncode != 0:
                raise Fail("gsettings set %s %s: %s" % (schema, key, _first_line(q.stderr) or "exit %d" % q.returncode))
        did.append("the default")
    docs, held = _evince_doc_pass(P, "1" if want else "0", dry)
    if docs:
        did.append("%d of %d documents" % (docs, held))
        lines.append("~%d documents' %s -> %s\n" % (docs, EVINCE_KEY, "1" if want else "0"))
    wins, nwin = _evince_window_pass(want, dry)
    if wins:
        did.append("%d open window%s" % (wins, "" if wins == 1 else "s"))
        lines.append("~%d open windows' inverted-colors -> %s\n" % (wins, word))
    return did, lines, held, nwin


def cmd_evince_worker(P, args):
    """`themectl _evince`: the evince target's background half. One worker at a time (a lock beside the wish); it applies the wish in
    `evince-want` and, before it lets go, reads it again: a switch made meanwhile is carried out by the worker that holds the lock, the
    one it started finds nothing left to do. Its last word is `evince-last` beside the wish (read it after a switch that did not show)."""
    want_file = _evince_want_file(P)
    spec = next((t for t in load_targets(P)[1] if t.get("type") == "evince"), {})
    os.makedirs(os.path.dirname(want_file), exist_ok=True)
    with open(want_file + ".lock", "a+") as lk:
        fcntl.flock(lk, fcntl.LOCK_EX)
        done = None
        for _ in range(8):
            want = (_read_text(want_file) or "").strip() == "1"
            if want == done:
                break
            t0 = time.time()
            try:
                did, _lines, held, nwin = _evince_apply(spec, want, P, False, 20)
                word = "%s %s: %s (%d documents, %d windows) in %d ms" % ("set" if did else "unchanged", "inverted" if want else "not inverted",
                                                                          ", ".join(did) or "-", held, nwin, (time.time() - t0) * 1000)
            except Fail as e:
                word = "FAIL %s" % e
            try:
                write_atomic(want_file[:-len("-want")] + "-last", word + "\n")
            except OSError:
                pass
            done = want
    return 0


def t_gnome_accent(spec, ctx):
    """libadwaita's accent (`org.gnome.desktop.interface accent-color`: one of nine names) = the GNOME accent nearest, by CIEDE2000, to the
    theme's `accent` token of this mode, for whatever reads that key. libadwaita reads it only when no settings portal answers (this
    desktop's portal does, without the key); what reaches loupe and zenity is the `libadwaita` target's stylesheet, whose exact accent wins
    over this one. Written through gsettings like the `gtk` target (the key exists from GNOME 47: an older schema is a FAIL that says so)."""
    token = ctx.values.get("accent")
    if token is None:
        raise Fail("theme %s (%s) has no accent token" % (ctx.theme.name, ctx.mode))
    shown = fmt_colour(token) if isinstance(token, list) else token
    try:
        name, dist = nearest_gnome_accent(shown)
    except ValueError as e:
        raise Fail("accent token: %s" % e)
    sub = {"name": spec["name"], "keys": [{"schema": spec.get("schema", "org.gnome.desktop.interface"), "key": spec.get("key", "accent-color"), "value": name}]}
    msg, diff = t_gsettings(sub, ctx)
    return "%s (accent %s -> %s, dE %.1f)" % (msg, shown, name, dist), diff


def t_setting(spec, ctx):
    """One key of a settings file in JSON with comments, set by an edit of its TEXT (jsonc_set): VS Code's `workbench.colorTheme`,
    which theme-switch.py rewrote for two years (the theme's `assets.<mode>.vscodeTheme`: a name VS Code has installed). The file is
    the user's own and long-lived, so nothing about it is kept for `restore` (a put-back would bring back every setting it has had
    since) and nothing is written unless the value changed or the key is new; it is replaced atomically, through a symlink to where
    the link points, with its own permission bits. No file -- the app is not installed, or never ran -- is no failure."""
    P = ctx.P
    ctx.need_assets(spec.get("needs"))
    out = P.expand(spec["file"])
    key = spec["key"]
    want = ctx.render(spec["value"], spec["name"] + " " + key)
    try:
        guard_output(P, out)
    except Refused as e:
        raise Fail(str(e))
    if not os.path.exists(out):
        return "skipped: %s does not exist (the app is not installed, or has never run)" % out, ""
    cur = _read_text(out)
    if cur is None:
        raise Fail("cannot read %s as text" % out)
    try:
        new = jsonc_set(cur, key, want)
    except ValueError as e:
        raise Fail("%s: %s -- nothing written" % (out, e))
    if new == cur:
        return "unchanged: %s %s = %s" % (os.path.basename(out), key, want), ""
    diff = _udiff(cur, new, out)
    if ctx.dry:
        return "would set %s %s = %s" % (os.path.basename(out), key, want), diff
    real = os.path.realpath(out)
    try:
        write_atomic(real, new, mode=stat.S_IMODE(os.stat(real).st_mode))
    except OSError as e:
        raise Fail("cannot write %s: %s" % (real, e))
    return "set %s %s = %s (changed)" % (os.path.basename(out), key, want), diff


def t_command(spec, ctx):
    ctx.need_assets(spec.get("needs"))
    argv = [ctx.render(a, spec["name"]) for a in spec["argv"]]
    if ctx.dry:
        return "would run: " + " ".join(argv), ""
    tries = int(spec.get("retries", 0)) + 1
    last = ""
    for i in range(tries):
        p = run_cmd(argv, ctx.timeout)
        if p.returncode == 0:
            return "ran: " + " ".join(argv[:3]) + (" (try %d)" % (i + 1) if i else ""), ""
        last = "%s: exit %d: %s" % (argv[0], p.returncode, _first_line(p.stderr) or _first_line(p.stdout) or "no output")
        if i + 1 < tries:
            time.sleep(float(spec.get("retryDelay", 0.5)))
    raise Fail(last)


def ini_set(text, section, key, value):
    """KEY=VALUE in [SECTION] of an ini file's TEXT: the line is replaced where it is, else added at the end of the section, else the
    section is added. Nothing else in the file moves (comments, other sections, the line endings)."""
    nl = "\r\n" if "\r\n" in text else "\n"
    lines = text.splitlines(keepends=True)
    head = re.compile(r"^\s*\[([^\]]*)\]\s*$")
    keyrx = re.compile(r"^\s*" + re.escape(key) + r"\s*=")
    sect = None
    last_in = -1                                    # the last line of SECTION that is not blank
    for i, l in enumerate(lines):
        m = head.match(l.rstrip("\r\n"))
        if m:
            sect = m.group(1)
            if sect == section:
                last_in = i
            continue
        if sect == section:
            if keyrx.match(l):
                lines[i] = "%s=%s%s" % (key, value, nl if l.endswith("\n") else "")
                return "".join(lines)
            if l.strip():
                last_in = i
    new = "%s=%s%s" % (key, value, nl)
    if last_in >= 0:
        if not lines[last_in].endswith("\n"):
            lines[last_in] += nl
        lines.insert(last_in + 1, new)
        return "".join(lines)
    out = "".join(lines)
    if out and not out.endswith("\n"):
        out += nl
    return out + ("%s" % nl if out else "") + "[%s]%s%s" % (section, nl, new)


def t_ini(spec, ctx):
    """Keys of an ini file's section (GTK's settings.ini), set by an edit of its TEXT (ini_set). gsettings is what a running GTK app and
    the shell's icon provider follow; settings.ini is what a GTK app started without a settings daemon reads, so the two are written
    together: one source. The file is the user's own and long-lived: nothing is kept for `restore`, nothing is
    written unless a value changed, and a missing file is created and noted for `restore` to remove (a GTK program reads whatever is there)."""
    P = ctx.P
    ctx.need_assets(spec.get("needs"))
    out = P.expand(spec["file"])
    try:
        guard_output(P, out)
    except Refused as e:
        raise Fail(str(e))
    cur = _read_text(out) if os.path.exists(out) else ""
    if cur is None:
        raise Fail("cannot read %s as text" % out)
    new, did = cur, []
    for item in spec["keys"]:
        want = ctx.render(item["value"], spec["name"] + " " + item["key"])
        nxt = ini_set(new, spec["section"], item["key"], want)
        if nxt != new:
            did.append("%s=%s" % (item["key"], want))
            new = nxt
    short = os.path.relpath(out, P.config) if out.startswith(P.config + "/") else out
    if not did:
        return "unchanged: %s" % short, ""
    diff = _udiff(cur, new, out)
    if ctx.dry:
        return "would set %s %s" % (short, ", ".join(did)), diff
    if not os.path.lexists(out):
        try:
            own_file(P, out)                        # a file themectl creates is taken away again by `restore`; one that was there is not kept
        except OSError as e:
            raise Fail("cannot keep a note of %s (nothing written): %s" % (out, e))
    real = os.path.realpath(out)
    try:
        write_atomic(real, new, mode=stat.S_IMODE(os.stat(real).st_mode) if os.path.exists(real) else None)
    except OSError as e:
        raise Fail("cannot write %s: %s" % (real, e))
    return "set %s %s" % (short, ", ".join(did)), diff


def hyprpaper_named(argv, mon):
    """ARGV (the wallpaper target's, rendered: its last word the FALLBACK request `,<path>,<fit>`) for monitor MON by name; None when the
    last word is not that shape (a targets.json of the user's with another command: no named pass)."""
    if not argv or not argv[-1].startswith(","):
        return None
    return list(argv[:-1]) + [mon + argv[-1]]


def hyprpaper_show(argv, path, timeout):
    """THE NAMED MONITORS. hyprpaper 0.8.5 (measured in a nested Hyprland, tools/dev/themectl_hyprpaper_env_probe.sh): a wallpaper set for a
    NAMED monitor wins over the fallback until the daemon restarts, and the fallback request it then ignores answers exit 0 and nothing. One
    named set by anything -- the Revert of an inserted slot, a `hyprctl hyprpaper wallpaper MON,...` by hand -- froze every later switch while
    this target said "ran" (2026-11-11). So after ARGV's fallback request what each monitor shows is read back (`listactive` answers the new
    state at once); a monitor that did not take PATH is told by name (argv's last word with the monitor in front) and read back again. Only
    the stragglers are named: a named set of our own would shadow the next fallback request of anyone else the same way. -> [] when every
    listed monitor shows PATH, else ["MON (shows X)", ...]. A daemon that lists nothing (it is starting, a stub) is not judged."""
    want = os.path.realpath(path)

    def off():
        return [(mon, pic) for mon, pic in _active_pictures(None) if os.path.realpath(pic) != want]
    stray = off()
    named = [hyprpaper_named(argv, mon) for mon, _ in stray]
    for a in named:
        if a is not None:
            run_cmd(a, timeout)
    if any(a is not None for a in named):
        stray = off()
    return ["%s (shows %s)" % (mon, os.path.basename(pic)) for mon, pic in stray]


def t_wallpaper(spec, ctx):
    """The wallpaper of this theme and mode (shell.jsonc, `wallpaper_slot`), through hyprpaper (0.8+; the shell's own crossfade does the
    transition, so the daemon needs none).

    WHICH PICTURE. A slot holding several is a shuffle bag (`bag_draw`, kept in ~/.local/state/theme/wallpaper-bag.json): a picture is DRAWN
    when the theme or the mode differs from what this target last showed, or the Hyprland instance does (HYPRLAND_INSTANCE_SIGNATURE: the
    autostart's `themectl apply` of a new session draws, a second apply in the same session does not); otherwise the slot's current pick is
    shown again (unless it left the list). A missing file is left out of the draw; all missing is a FAIL. A dry run (diff, doctor) draws
    nothing and keeps nothing.

    Two steps, because a wallpaper must survive a restart of the daemon and a switch must show at once: (1) the file hyprpaper reads at
    its start (`output`, from `template`) is written -- it is the same `file` target everything else is; (2) the running daemon is told with
    `hyprctl hyprpaper wallpaper ',<abs path>,<fit>'` (an empty monitor is the fallback, which every monitor not named takes), then what
    each monitor shows is read back and one that kept another picture is told BY NAME (`hyprpaper_show`: a named wallpaper beats the
    fallback); one that still shows another is a FAIL. hyprpaper not running is no failure -- its file is read when it starts (its message: `notRunning`, a regex on hyprctl's text). No wallpaper set
    in shell.jsonc for this theme and mode is 'skipped': the one on screen stays."""
    P, name, mode = ctx.P, ctx.theme.name, ctx.mode
    inst = os.environ.get("HYPRLAND_INSTANCE_SIGNATURE", "")
    slot = wallpaper_slot(P, name, mode)
    bags = load_bags(P)
    switched = bags["shown"] != [name, mode] or bags["instance"] != inst

    def keep(state=None):
        """What this target showed is recorded (a real run only): the slot's state, the theme and mode, the instance."""
        if ctx.dry:
            return
        if state is not None:
            bags["slots"][slot_key(name, mode)] = state
        bags["shown"], bags["instance"] = [name, mode], inst
        try:
            save_bags(P, bags)
        except OSError as e:
            raise Fail("cannot write %s: %s" % (bag_file(P), e))
    if slot is None:
        keep()
        return "skipped: no wallpaper for %s %s (shell.jsonc theme.wallpapers.%s.%s)" % (name, mode, name, mode), ""
    if not slot["paths"]:
        if len(slot["missing"]) == 1:
            raise Fail("wallpaper file %s not found (%s)" % (slot["missing"][0], slot["where"]))
        raise Fail("none of the %d wallpaper files of %s exists (%s)" % (len(slot["missing"]), slot["where"], ", ".join(slot["missing"])))
    state = bags["slots"].get(slot_key(name, mode), bag_empty())
    if not switched and state["last"] in slot["paths"]:
        path, new_state, how = state["last"], state, "kept"
    else:
        path, new_state = bag_draw(state, slot["paths"], random.random)
        how = "drawn"
    n = len(slot["paths"])
    which = "" if n == 1 and not slot["missing"] else " [%s: %s, %d of %d%s]" % (
        "would draw" if (how == "drawn" and ctx.dry) else how, os.path.basename(path), slot["paths"].index(path) + 1, n,
        "; %d not found: %s" % (len(slot["missing"]), ", ".join(os.path.basename(m) for m in slot["missing"])) if slot["missing"] else "")
    ctx.extra = {"wallpaperPath": path, "wallpaperFit": slot["fit"]}
    fspec = {k: v for k, v in spec.items() if k not in ("type", "argv", "notRunning")}
    msg, diff = t_file(fspec, ctx)
    argv = [ctx.render(a, spec["name"]) for a in spec["argv"]]
    if ctx.dry:
        return msg + "; would run: " + " ".join(argv) + which, diff
    p = run_cmd(argv, ctx.timeout)
    text = ((p.stdout or "") + " " + (p.stderr or "")).strip()
    if p.returncode == 0 and not re.search(r"(?i)\berror\b", text):
        kept = hyprpaper_show(argv, path, ctx.timeout)
        if kept:
            raise Fail("hyprpaper did not take %s: %s" % (os.path.basename(path), ", ".join(kept)))
        keep(new_state)
        return msg + "; " + " ".join(argv[:3]) + " ran" + which, diff
    if re.search(spec.get("notRunning", r"(?!x)x"), text):
        keep(new_state)
        return msg + "; hyprpaper is not running (the file is read when it starts)" + which, diff
    raise Fail("%s: exit %d: %s" % (" ".join(argv[:3]), p.returncode, _first_line(text) or "no output"))


def toml_str(s):
    """S as a TOML basic string (JSON's escapes are TOML's for every character a path holds)."""
    return json.dumps(s, ensure_ascii=False)


def yazi_glob(path):
    """An exact-path glob for a yazi open rule (yazi's Pattern: matched against the whole path, backslash is no escape, `\\s` in front makes it
    case-sensitive): every glob character is put in a class of its own."""
    return "\\s" + "".join("[%s]" % c if c in "*?[]{}" else c for c in path)


YAZI_BEGIN = "# BEGIN themectl wallpapers"
YAZI_END = "# END themectl wallpapers"


def yazi_rule_block(text, lines):
    """TEXT (yazi.toml) with the lines between its BEGIN / END marks replaced by LINES (each indented as the BEGIN line is) -> new text, or
    None when the marks are not there. ValueError: a mark twice, an END before its BEGIN."""
    begins = [m for m in re.finditer(r"^([ \t]*)%s\b[^\n]*\n" % re.escape(YAZI_BEGIN), text, re.M)]
    ends = [m for m in re.finditer(r"^[ \t]*%s\b[^\n]*(\n|$)" % re.escape(YAZI_END), text, re.M)]
    if not begins and not ends:
        return None
    if len(begins) != 1 or len(ends) != 1 or ends[0].start() < begins[0].end():
        raise ValueError("the %r / %r marks are not one pair in order (%d / %d)" % (YAZI_BEGIN, YAZI_END, len(begins), len(ends)))
    ind = begins[0].group(1)
    return text[:begins[0].end()] + "".join(ind + l + "\n" for l in lines) + text[ends[0].start():]


def t_yazi(spec, ctx):
    """yazi's view of the CURRENT theme and mode's wallpapers (tools/theme/yazi/CHEATSHEET.md), on every apply and every wallpaper change:

    (1) `list`: the slot's pictures, one absolute path a line (and its real path when that differs), which the wallpapers.yazi plugin reads
        live for the mark beside each listed file. Written whether or not yazi is set up (themectl's own state file).
    (2) `config` (yazi.toml): the rules between the BEGIN / END marks `install` put at the top of [open] prepend_rules, one per picture, exact
        path -> the `opener` ("Remove from wallpapers" and the viewer); every other image keeps the user's own image rule ("Set as wallpaper").
        The rest of the file is never touched; no marks is 'not set up' (no failure). An open yazi reads it at its next start."""
    P = ctx.P
    note = ""
    try:
        slot = wallpaper_slot(P, ctx.theme.name, ctx.mode)
    except Fail as e:
        slot, note = None, " (the slot is unreadable: %s)" % e
    paths = []
    for _, p in (slot["entries"] if slot else []):
        for q in (p, os.path.realpath(p)):
            if q not in paths and "\n" not in q:
                paths.append(q)
    out = []
    lst = P.expand(spec["list"])
    head = ("# themectl: the wallpapers of %s %s (shell.jsonc theme.wallpapers.%s.%s), one path a line, for yazi's wallpapers.yazi plugin.\n"
            "# Rewritten on every theme switch and wallpaper change; do not edit.\n") % (ctx.theme.name, ctx.mode, ctx.theme.name, ctx.mode)
    want = head + "".join(p + "\n" for p in paths)
    diff = ""
    if _read_text(lst) != want:
        diff += _udiff(_read_text(lst), want, lst)
        if not ctx.dry:
            try:
                write_atomic(lst, want)
            except OSError as e:
                raise Fail("cannot write %s: %s" % (lst, e))
        out.append("%s %s (%d)" % ("would write" if ctx.dry else "wrote", lst, len(slot["entries"]) if slot else 0))
    else:
        out.append("unchanged: %s" % lst)
    cfg = P.expand(spec["config"])
    text = _read_text(cfg)
    if text is None:
        out.append("no %s (no yazi config here)" % cfg)
        return "; ".join(out) + note, diff
    rules = ["{ url = %s, use = %s }," % (toml_str(yazi_glob(p)), toml_str(spec["opener"])) for p in paths if "://" not in p]
    try:
        new = yazi_rule_block(text, rules)
    except ValueError as e:
        raise Fail("%s: %s -- nothing written" % (cfg, e))
    if new is None:
        out.append("%s has no %s block (themectl install adds it)" % (os.path.basename(cfg), YAZI_BEGIN[2:]))
    elif new == text:
        out.append("unchanged: the rules in %s" % os.path.basename(cfg))
    else:
        try:
            import tomllib
            tomllib.loads(new)
        except Exception as e:                      # noqa: BLE001 -- what yazi would refuse is never written
            raise Fail("%s: the new rules do not parse (%s) -- nothing written" % (cfg, e))
        diff += _udiff(text, new, cfg)
        if not ctx.dry:
            real = os.path.realpath(cfg)
            try:
                write_atomic(real, new, mode=stat.S_IMODE(os.stat(real).st_mode))
            except OSError as e:
                raise Fail("cannot write %s: %s" % (real, e))
        out.append("%s the %d rule%s in %s" % ("would write" if ctx.dry else "wrote", len(rules), "" if len(rules) == 1 else "s", os.path.basename(cfg)))
    return "; ".join(out) + note, diff


def compose_share(P, compose, guest):
    """The host directory COMPOSE mounts at GUEST, from a short-form volume line (`- <host>:<guest>[:opts]`), or None. Lines, not YAML: this is the one fact themectl needs of that
    file, and PyYAML is not a dependency worth having for it. A variable other than HOME and the XDG bases cannot be known here, and that is said, not guessed past."""
    text = _read_text(compose)
    rx = re.compile(r"""^\s*-\s*['"]?([^'"#\s]+?):%s(?::[a-z,]+)?['"]?\s*(?:#.*)?$""" % re.escape(guest))
    for line in (text or "").splitlines():
        m = rx.match(line)
        if not m:
            continue
        host = P.expand(re.sub(r"\$([A-Za-z_][A-Za-z0-9_]*)", r"${\1}", m.group(1)))
        if "$" in host:
            raise Fail("%s: cannot resolve the volume at %s: %s" % (compose, guest, m.group(1)))
        return os.path.normpath(host if os.path.isabs(host) else os.path.join(os.path.dirname(compose), host))
    return None


def t_vmshare(spec, ctx):
    """A small file in the folder a VM shares with this machine, for the agent inside it to read (windows/ThemeSync.cs). The folder is the VM's own compose file's, so there is
    one place that says where it is, and the file is on Linux: a switch needs the VM neither running nor reachable, and a Windows that was off reads the mode when it next starts.

    OPTIONAL: no compose file, no such volume, or a folder that does not exist is a machine without that VM, and is 'skipped' (the folder is never made here: docker owns that).
    A share that cannot be written IS a FAIL. Nothing here starts, asks or signals anything: no docker, no ssh, and the compose file's `storage` is not read."""
    P = ctx.P
    compose = P.expand(spec["compose"])
    if not os.path.exists(compose):
        return "skipped: no VM here (%s)" % compose, ""
    share = compose_share(P, compose, spec["guest"])
    if share is None:
        return "skipped: %s shares nothing at %s" % (compose, spec["guest"]), ""
    if not os.path.isdir(share):
        return "skipped: the shared folder %s does not exist" % share, ""
    out = os.path.join(share, spec["file"])
    try:
        guard_output(P, out)
    except Refused as e:
        raise Fail(str(e))
    new = ctx.render(spec["text"], spec["name"])
    cur = _read_text(out)
    changed = cur != new
    diff = _udiff(cur, new, out) if changed else ""
    if ctx.dry:
        return (("would write %s" % out) if changed else "unchanged: %s" % out), diff
    if changed:
        try:
            own_file(P, out)
            write_atomic(out, new)
        except OSError as e:
            raise Fail("cannot write %s: %s" % (out, e))
    return (("wrote %s" % out) if changed else "unchanged: %s" % out), diff


def t_nwglook(spec, ctx):
    """nwg-look (the GTK settings app here) kept in step with the gtk target, so that it can never put an old theme back on its own:

    (1) `file` (~/.local/share/nwg-look/gsettings): what nwg-look applied last, `key=value` lines under its own header, which `nwg-look -a`
        applies again. The keys the gtk target sets (`keys`: gtk-theme, icon-theme, color-scheme) take the pair's values; every other line
        (the cursor, the font, the sounds: no target of themectl sets those) stays as nwg-look wrote it. Nothing is kept for `restore`: a
        put-back would bring back a theme long gone.
    (2) `config` (~/.config/nwg-look/config, nwg-look's JSON): every key in `off` is false -- `export-gtk4-symlinks`, with which nwg-look's
        Apply deletes ~/.config/gtk-4.0/gtk.css and settings.ini and links the GTK theme's own in their place (the libadwaita target's
        stylesheet and the gtk4-ini target's file gone). Its original is kept for `restore` the first time, as every file themectl owns.

    nwg-look's window shows what gsettings said when it OPENED, and its Apply writes all of that back: one left open across a switch puts
    the old theme back (doctor says when one is running). Neither file there -- nwg-look never ran -- is 'skipped'."""
    P = ctx.P
    ctx.need_assets(spec.get("needs"))
    f, cfg = P.expand(spec["file"]), P.expand(spec["config"])
    for x in (f, cfg):
        try:
            guard_output(P, x)
        except Refused as e:
            raise Fail(str(e))
    out, diff = [], ""
    have_f, have_c = os.path.exists(f), os.path.exists(cfg)
    if not have_f and not have_c:
        return "skipped: nwg-look has stored nothing here (%s, %s)" % (f, cfg), ""
    if have_f:
        cur = _read_text(f)
        if cur is None:
            raise Fail("cannot read %s as text" % f)
        lines = cur.splitlines(keepends=True)
        did = []
        for item in spec["keys"]:
            want = ctx.render(item["value"], spec["name"] + " " + item["key"])
            line = "%s=%s\n" % (item["key"], want)
            hit = [i for i, l in enumerate(lines) if l.split("=", 1)[0] == item["key"]]
            if hit:
                if lines[hit[0]].rstrip("\n") != line.rstrip("\n"):
                    lines[hit[0]] = line if lines[hit[0]].endswith("\n") else line.rstrip("\n")
                    did.append("%s=%s" % (item["key"], want))
            else:
                if lines and not lines[-1].endswith("\n"):
                    lines[-1] += "\n"
                lines.append(line)
                did.append("%s=%s" % (item["key"], want))
        new = "".join(lines)
        if did:
            diff += _udiff(cur, new, f)
            if not ctx.dry:
                real = os.path.realpath(f)
                try:
                    write_atomic(real, new, mode=stat.S_IMODE(os.stat(real).st_mode))
                except OSError as e:
                    raise Fail("cannot write %s: %s" % (real, e))
            out.append("%s %s" % ("would set" if ctx.dry else "set", ", ".join(did)))
        else:
            out.append("unchanged: %s" % os.path.basename(f))
    if have_c:
        cur = _read_text(cfg)
        try:
            obj = json.loads(cur if cur is not None else "")
        except ValueError as e:
            raise Fail("%s is not JSON (%s): nothing written" % (cfg, e))
        if not isinstance(obj, dict):
            raise Fail("%s is not a JSON object: nothing written" % cfg)
        flip = [k for k in spec.get("off", []) if obj.get(k) is not False]
        if flip:
            for k in flip:
                obj[k] = False
            new = json.dumps(obj, indent=1, ensure_ascii=False) + ("\n" if cur.endswith("\n") else "")   # nwg-look's own layout (Go's MarshalIndent, one space)
            diff += _udiff(cur, new, cfg)
            if not ctx.dry:
                try:
                    own_file(P, cfg)
                except OSError as e:
                    raise Fail("cannot keep the original of %s (nothing written): %s" % (cfg, e))
                real = os.path.realpath(cfg)
                try:
                    write_atomic(real, new, mode=stat.S_IMODE(os.stat(real).st_mode))
                except OSError as e:
                    raise Fail("cannot write %s: %s" % (real, e))
            out.append("%s %s off" % ("would switch" if ctx.dry else "switched", ", ".join(flip)))
        else:
            out.append("%s off" % ", ".join(spec.get("off", [])))
    return "nwg-look: " + "; ".join(out), diff


def nwglook_running():
    """[(pid, start as HH:MM)] of the nwg-look processes on this machine (read from /proc; nothing is signalled)."""
    found = []
    try:
        ticks = os.sysconf("SC_CLK_TCK")
        boot = time.time() - float(open("/proc/uptime").read().split()[0])
    except (OSError, ValueError):
        return found
    for d in os.listdir("/proc"):
        if not d.isdigit():
            continue
        try:
            if open("/proc/%s/comm" % d).read().strip() != "nwg-look":
                continue
            st = open("/proc/%s/stat" % d).read()
            start = boot + int(st.rsplit(")", 1)[1].split()[19]) / ticks
            found.append((int(d), time.strftime("%H:%M", time.localtime(start))))
        except (OSError, ValueError, IndexError):
            continue
    return found


TYPES = {"state": t_state, "file": t_file, "link": t_link, "gsettings": t_gsettings, "ini": t_ini, "setting": t_setting, "command": t_command,
         "wallpaper": t_wallpaper, "vmshare": t_vmshare, "gnomeAccent": t_gnome_accent, "yazi": t_yazi, "nwglook": t_nwglook, "evince": t_evince}


def load_targets(P):
    for p in (P.theme_dir + "/targets.json", P.tools + "/targets.json"):
        if os.path.exists(p):
            try:
                doc = load_json(p)
            except (OSError, ValueError) as e:
                raise Refused("%s: %s" % (p, e))
            return doc.get("options", {}), doc.get("targets", []), p
    raise Refused("no targets.json (looked in %s and %s)" % (P.theme_dir, P.tools))


TARGET_ALIASES = {"quickshell": "lares"}   # the shell's state target was called quickshell before the project was named Lares


def select(targets, only, skip):
    names = [t["name"] for t in targets]
    only = [TARGET_ALIASES.get(n, n) for n in (only or [])] or only
    skip = [TARGET_ALIASES.get(n, n) for n in (skip or [])] or skip
    for n in (only or []) + (skip or []):
        if n not in names:
            raise Refused('no target named "%s" (have: %s)' % (n, ", ".join(names)))
    out = []
    for t in targets:
        if only and t["name"] not in only:
            continue
        if skip and t["name"] in skip:
            continue
        out.append(t)
    return out


def run_targets(P, theme, mode, only=None, skip=None, dry=False, show_diff=False, out=sys.stdout):
    """Run the targets in order; every one prints `ok` or `FAIL <reason>`. -> the number of FAILs."""
    options, targets, _ = load_targets(P)
    chosen = select(targets, only, skip)
    ctx = Ctx(P, options, theme, mode, dry)
    fails = 0
    if ctx.errors:
        for k, v in sorted(ctx.errors.items()):
            print("note  theme %s (%s): %s" % (theme.name, mode, v), file=out)
    # WHAT EACH TARGET COSTS (a real run): $XDG_STATE_HOME/theme/last-run.tsv, one `target<TAB>ms<TAB>ok|FAIL` line each. The shell's
    # curtain waits for this whole run, so a switch that "feels slower" is read here, not guessed (2026-11-12: the evince target).
    times, t_run = [], time.time()
    for spec in chosen:
        name = spec["name"]
        t_spec = time.time()
        fails_before = fails
        off = target_off(P, spec, only)
        if off:
            print("%-5s %-12s skipped (%s)" % ("ok", name, off), file=out)
            continue
        only_themes = spec.get("themes")
        if only_themes and theme.name not in only_themes:
            print("%-5s %-12s skipped (only for: %s)" % ("ok", name, ", ".join(only_themes)), file=out)
            continue
        try:
            fn = TYPES.get(spec.get("type"))
            if fn is None:
                raise Fail('unknown target type "%s"' % spec.get("type"))
            msg, diff = fn(spec, ctx)
            print("%-5s %-12s %s" % ("ok", name, msg), file=out)
            if show_diff and diff:
                print("".join("      " + l + "\n" if not l.endswith("\n") else "      " + l for l in diff.splitlines(True)).rstrip("\n"), file=out)
        except Fail as e:
            fails += 1
            print("%-5s %-12s %s" % ("FAIL", name, e), file=out)
        except Exception as e:                      # a bug in a target is a FAIL of that target, never a silent one
            fails += 1
            print("%-5s %-12s internal error: %s: %s" % ("FAIL", name, type(e).__name__, e), file=out)
        times.append("%s\t%d\t%s\n" % (name, (time.time() - t_spec) * 1000, "FAIL" if fails > fails_before else "ok"))
    if not dry and times:
        try:
            write_atomic(P.state + "/theme/last-run.tsv", "# %s %s, %d ms in all\n" % (theme.name, mode, (time.time() - t_run) * 1000) + "".join(times))
        except OSError:
            pass
    return fails



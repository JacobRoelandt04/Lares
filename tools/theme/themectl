def _split(s):
    return [x for x in (s or "").split(",") if x]


def _apply(P, args, name, mode):
    """Apply NAME in MODE (the lock is held, or this is a dry run). -> the exit status."""
    if mode not in MODES:
        raise Refused('mode must be "light" or "dark", not "%s"' % mode)
    theme = load_theme(P, name)
    if not isinstance(theme.doc.get(mode), dict):
        raise Refused('theme "%s" has no "%s" block' % (name, mode))
    fails = run_targets(P, theme, mode, _split(args.only), _split(args.skip), dry=args.dry, show_diff=args.dry)
    print("themectl: %s %s: %s" % (name, mode, "all ok" if fails == 0 else "%d FAIL" % fails))
    return min(fails, 99)


def cmd_apply(P, args, theme_name=None, mode=None, toggle=False):
    with contextlib.nullcontext() if args.dry else locked(P):
        st = read_state(P)
        if toggle:
            mode = "dark" if st["mode"] == "light" else "light"
        return _apply(P, args, theme_name or st["theme"], mode or st["mode"])


def cmd_next(P, args):
    with locked(P):
        names = pair_order(P)
        st = read_state(P)
        if len(names) < 2:
            print("themectl: only one theme (%s): nothing to do" % (names[0] if names else "none"))
            return 0
        nxt = names[(names.index(st["theme"]) + 1) % len(names)] if st["theme"] in names else names[0]
        return _apply(P, args, nxt, st["mode"])


# ============================================================================ `wallpaper set | remove | list`: the pictures of this theme and mode
# yazi's "Set as wallpaper" and "Remove from wallpapers" (tools/theme/yazi/CHEATSHEET.md). `set`: ONE image is APPENDED to
# theme.wallpapers.<theme>.<mode> of the user's shell.jsonc (a string slot becomes a list; a picture already there is not added twice) -- by an
# edit of its TEXT (jsonc_list_add: the comments, the layout and every other key stay) -- and shown now (it counts as drawn: bag_take), through
# the existing `wallpaper` target; a notification with a Revert action says so. The notification is waited on by a detached copy of this
# program (`wallpaper _prompt`), so the file manager is never blocked; Revert takes the picture out of the list again and puts the old one
# back on screen. `remove`: the picture leaves the list (jsonc_list_drop); the one on screen is replaced by the next draw; the last one of a
# slot is refused. Both refresh yazi's view (the `yazi` target). `list`: the slot, its current pick, what is still to come in this round.


def _jsonc_members(text, toks, i):
    """toks[i] is a `{`: -> ([(key, key_index, value_index)], index of its `}`)."""
    members, j = [], i + 1
    while j < len(toks):
        k = toks[j][0]
        if k == "}":
            return members, j
        if k == ",":
            j += 1
            continue
        if k != "s" or j + 2 >= len(toks) or toks[j + 1][0] != ":":
            raise ValueError("a malformed member at offset %d" % toks[j][1])
        members.append((json.loads(text[toks[j][1]:toks[j][2]]), j, j + 2))
        j = _jsonc_skip(toks, j + 2)
    raise ValueError("an object is not closed")


def _jsonc_skip(toks, i):
    """The index after the value that starts at toks[i]."""
    if toks[i][0] not in "{[":
        return i + 1
    depth = 0
    while i < len(toks):
        if toks[i][0] in "{[":
            depth += 1
        elif toks[i][0] in "}]":
            depth -= 1
            if depth == 0:
                return i + 1
        i += 1
    raise ValueError("a value is not closed")


def jsonc_find_path(text, path):
    """-> ("found", start, end) of the scalar at PATH (a list of keys), or ("absent", open_index, depth_reached, toks): the deepest object
    that exists on the way (its `{`'s token index) and how many keys of PATH lead to it. ValueError: not an object, unreadable, or a key
    on the way (or the last one) holds a list / an object / a non-object where one is needed."""
    toks = list(jsonc_tokens(text))
    if not toks or toks[0][0] != "{":
        raise ValueError("the file is not a JSON object")
    at, depth = 0, 0
    while True:
        members, _ = _jsonc_members(text, toks, at)
        hit = next((m for m in members if m[0] == path[depth]), None)
        if hit is None:
            return "absent", at, depth, toks
        v = toks[hit[2]]
        if depth == len(path) - 1:
            if v[0] in "{[":
                raise ValueError("%s is an object or a list, not a string" % ".".join(path))
            return "found", v[1], v[2]
        if v[0] != "{":
            raise ValueError("%s is %s, not an object" % (".".join(path[:depth + 1]), text[v[1]:v[2]] if v[0] != "[" else "a list"))
        at, depth = hit[2], depth + 1


def _line_indent(text, pos):
    """The whitespace that starts the line holding POS."""
    s = text.rfind("\n", 0, pos) + 1
    m = re.match(r"[ \t]*", text[s:])
    return m.group(0)


def jsonc_set_path(text, path, value):
    """The text with the string at PATH set to VALUE and NOTHING else touched. A key that is not there is added as the LAST member of the
    deepest object that exists, with the keys below it made (`"theme": { "wallpapers": { "x": { "dark": "..." } } }` from nothing); a
    multi-line object gets its member on a line of its own at its members' indent (a trailing comma, a `//` note after the last member
    and the closing brace stay where they are), a one-line object gets it inline. ValueError (nothing to write) on anything unreadable;
    what is written is read back before it is returned."""
    new = json.dumps(value, ensure_ascii=False)
    found = jsonc_find_path(text, path)
    if found[0] == "found":
        out = text[:found[1]] + new + text[found[2]:]
    else:
        _, at, depth, toks = found
        members, close = _jsonc_members(text, toks, at)
        opener, closer = toks[at], toks[close]
        base = _line_indent(text, opener[1])
        root_members, _ = _jsonc_members(text, toks, 0)
        unit = "    "
        if root_members:
            ind = _line_indent(text, toks[root_members[0][1]][1])
            if ind and "\n" in text[toks[0][2]:toks[root_members[0][1]][1]]:
                unit = ind
        first_key = toks[members[0][1]][1] if members else closer[1]
        multi = "\n" in text[opener[2]:first_key]
        inner = (_line_indent(text, toks[members[0][1]][1]) if members and multi else base + unit)

        def nest(keys, ind):
            k = json.dumps(keys[0], ensure_ascii=False)
            if len(keys) == 1:
                return "%s: %s" % (k, new)
            if multi:
                return "%s: {\n%s%s\n%s}" % (k, ind + unit, nest(keys[1:], ind + unit), ind)
            return "%s: { %s }" % (k, nest(keys[1:], ind))
        member = nest(path[depth:], inner)
        if not members:
            if multi:
                out = text[:opener[2]] + "\n" + inner + member + text[opener[2]:]
            else:
                out = text[:opener[2]] + " " + member + " " + text[opener[2]:closer[1]].strip() + text[closer[1]:]
        else:
            after = _jsonc_skip(toks, members[-1][2])
            last_end = toks[after - 1][2]
            has_comma = after < len(toks) and toks[after][0] == ","
            pos = toks[after][2] if has_comma else last_end
            if multi:
                nl = text.find("\n", pos)
                eol = len(text) if nl < 0 else nl
                rest = text[pos:eol].strip()
                if rest and not rest.startswith("//") and not (rest.startswith("/*") and rest.endswith("*/")):
                    raise ValueError("cannot place a member after %r on its line" % rest[:20])
                out = text[:eol] + "\n" + inner + member + text[eol:]
                if not has_comma:
                    out = out[:last_end] + "," + out[last_end:]
            else:
                out = text[:pos] + (" " if has_comma else ", ") + member + text[pos:]
    kind, a, b = jsonc_find_path(out, path)
    if kind != "found" or json.loads(out[a:b]) != value:
        raise ValueError("the edit did not read back (nothing written)")
    if _parses(text) and not _parses(out):           # a file that did not parse before (a trailing comma) is no worse for the edit
        raise ValueError("the edit does not parse (nothing written)")
    return out


def _parses(text):
    try:
        json.loads(_jsonc_lib().strip(text))
        return True
    except ValueError:
        return False


def _jsonc_lib():
    import importlib.util
    spec = importlib.util.spec_from_file_location("themectl_jsonc", os.path.join(os.path.dirname(os.path.dirname(os.path.realpath(__file__))), "lib", "jsonc.py"))
    mod = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(mod)
    return mod


def _jsonc_locate(text, path):
    """-> (toks, key index, value index) of the member at PATH (a list of keys), or (toks, None, None) when a key on the way is absent.
    ValueError: not an object, unreadable, or a key on the way that holds no object."""
    toks = list(jsonc_tokens(text))
    if not toks or toks[0][0] != "{":
        raise ValueError("the file is not a JSON object")
    at = 0
    for depth, key in enumerate(path):
        if toks[at][0] != "{":
            raise ValueError("%s is not an object" % ".".join(path[:depth]))
        members, _ = _jsonc_members(text, toks, at)
        hit = next((m for m in members if m[0] == key), None)
        if hit is None:
            return toks, None, None
        if depth == len(path) - 1:
            return toks, hit[1], hit[2]
        at = hit[2]


def _jsonc_elements(toks, i):
    """toks[i] is a `[`: -> ([(first token index, index after its last token)] per element, index of its `]`)."""
    els, j = [], i + 1
    while j < len(toks):
        k = toks[j][0]
        if k == "]":
            return els, j
        if k == ",":
            j += 1
            continue
        e = _jsonc_skip(toks, j)
        els.append((j, e))
        j = e
    raise ValueError("a list is not closed")


def _indent_unit(text, toks):
    """One level of the file's indent (that of the root's first member, when the root is multi-line), else four spaces."""
    root_members, _ = _jsonc_members(text, toks, 0)
    if root_members:
        ind = _line_indent(text, toks[root_members[0][1]][1])
        if ind and "\n" in text[toks[0][2]:toks[root_members[0][1]][1]]:
            return ind
    return "    "


def _slot_list(text, path):
    """The slot at PATH as a list of strings ([] when absent; a string is a list of one) -- read through the shell's own reader (strip)."""
    d = _jsonc_lib().loads(text)
    for k in path:
        d = d.get(k) if isinstance(d, dict) else None
    if d is None:
        return []
    return [d] if isinstance(d, str) else list(d) if isinstance(d, list) else None


def jsonc_list_add(text, path, value):
    """The text with the string VALUE added at the end of the slot at PATH and NOTHING else touched: an absent slot becomes the string (as
    jsonc_set_path makes it), a string becomes a list of the two (one item a line when the member has its own line), a list gets the item
    after its last one (on a line of its own at its items' indent when it is multi-line; a `//` note after the last item stays with it).
    ValueError (nothing to write) on anything else; what is written is read back first."""
    new = json.dumps(value, ensure_ascii=False)
    toks, ki, vi = _jsonc_locate(text, path)
    if vi is None:
        return jsonc_set_path(text, path, value)
    want = (_slot_list(text, path) or []) + [value]
    v = toks[vi]
    if v[0] == "s":
        old = text[v[1]:v[2]]
        if text[text.rfind("\n", 0, toks[ki][1]) + 1:toks[ki][1]].strip() == "":
            ind = _line_indent(text, toks[ki][1])
            inner = ind + _indent_unit(text, toks)
            arr = "[\n%s%s,\n%s%s\n%s]" % (inner, old, inner, new, ind)
        else:
            arr = "[%s, %s]" % (old, new)
        out = text[:v[1]] + arr + text[v[2]:]
    elif v[0] == "[":
        els, close = _jsonc_elements(toks, vi)
        if not els:
            out = text[:v[2]] + new + text[toks[close][1]:]
        else:
            last_end = toks[els[-1][1] - 1][2]
            has_comma = toks[els[-1][1]][0] == ","
            pos = toks[els[-1][1]][2] if has_comma else last_end
            first = toks[els[0][0]][1]
            if "\n" in text[v[2]:first]:
                inner = _line_indent(text, first)
                nl = text.find("\n", pos)
                eol = len(text) if nl < 0 else nl
                rest = text[pos:eol].strip()
                if rest.startswith("]"):                 # the bracket closes on the last item's line
                    out = text[:pos] + ("" if has_comma else ",") + "\n" + inner + new + text[pos:]
                elif rest and not rest.startswith("//") and not (rest.startswith("/*") and rest.endswith("*/")):
                    raise ValueError("cannot place an item after %r on its line" % rest[:20])
                else:
                    out = text[:eol] + "\n" + inner + new + text[eol:]
                    if not has_comma:
                        out = out[:last_end] + "," + out[last_end:]
            else:
                out = text[:pos] + (" " if has_comma else ", ") + new + text[pos:]
    else:
        raise ValueError("%s is %s, not a path or a list of paths" % (".".join(path), text[v[1]:v[2]][:30]))
    if _parses(text) and not _parses(out):
        raise ValueError("the edit does not parse (nothing written)")
    if _slot_list(out, path) != want:
        raise ValueError("the edit did not read back (nothing written)")
    return out


def jsonc_list_drop(text, path, match):
    """The text with every item of the LIST at PATH for which match(item) is true taken out -- the item, its comma, and its line when it
    has one of its own (a `//` note on that line goes with it) -- and NOTHING else touched. ValueError: not a list, nothing matches, or the
    list would be left empty (an emptied slot is the caller's refusal); what is written is read back first."""
    before = _slot_list(text, path)
    if before is None:
        raise ValueError("%s is not a path or a list of paths" % ".".join(path))
    want = [x for x in before if not (isinstance(x, str) and match(x))]
    if len(want) == len(before):
        raise ValueError("%s holds no such picture" % ".".join(path))
    if not want:
        raise ValueError("%s would be left empty" % ".".join(path))
    out = text
    while True:
        toks, ki, vi = _jsonc_locate(out, path)
        if vi is None or toks[vi][0] != "[":
            raise ValueError("%s is not a list" % ".".join(path))
        els, close = _jsonc_elements(toks, vi)
        hit = next((n for n, (a, b) in enumerate(els) if b == a + 1 and toks[a][0] == "s" and match(json.loads(out[toks[a][1]:toks[a][2]]))), None)
        if hit is None:
            break
        a, b = els[hit]
        s, e = toks[a][1], toks[b - 1][2]
        line_start = out.rfind("\n", 0, s) + 1
        own_line = out[line_start:s].strip() == ""
        if hit < len(els) - 1:                           # an item with one after it: the item and its comma
            cut = toks[b][2]
            nl = out.find("\n", cut)
            rest = out[cut:nl if nl >= 0 else len(out)].strip()
            if own_line and (rest == "" or rest.startswith("//")) and toks[els[hit + 1][0]][1] > nl >= 0:
                out = out[:line_start] + out[nl + 1:]
            else:
                out = out[:s] + out[toks[els[hit + 1][0]][1]:]
        else:                                            # the last item: it, and the comma after the one before it
            comma = toks[els[hit - 1][1]]
            nl = out.find("\n", e)
            rest = out[e:nl if nl >= 0 else len(out)].strip().lstrip(",").strip()
            if own_line and nl >= 0 and (rest == "" or rest.startswith("//")):
                out = out[:line_start] + out[nl + 1:]
                out = out[:comma[1]] + out[comma[2]:]
            else:
                out = out[:comma[1]] + out[toks[b][2] if toks[b][0] == "," else e:]
    if _parses(text) and not _parses(out):
        raise ValueError("the edit does not parse (nothing written)")
    if _slot_list(out, path) != want:
        raise ValueError("the edit did not read back (nothing written)")
    return out


# the formats hyprpaper (hyprgraphics) draws; read by their first bytes, so a picture named .jpg that is a PNG is still one
def sniff_image(path):
    """-> "jpeg" | "png" | "webp" | "jxl" | "bmp", or None when the file is none of them (or cannot be read)."""
    try:
        with open(path, "rb") as f:
            h = f.read(16)
    except OSError:
        return None
    if h[:3] == b"\xff\xd8\xff":
        return "jpeg"
    if h[:8] == b"\x89PNG\r\n\x1a\n":
        return "png"
    if h[:4] == b"RIFF" and h[8:12] == b"WEBP":
        return "webp"
    if h[:2] == b"\xff\x0a" or h[:12] == b"\x00\x00\x00\x0cJXL \r\n\x87\n":
        return "jxl"
    if h[:2] == b"BM":
        return "bmp"
    return None


def shown_path(P, path):
    """A path as the user writes one in shell.jsonc: ~/... under the home, absolute elsewhere."""
    return "~" + path[len(P.home):] if path == P.home or path.startswith(P.home + "/") else path


def _notify(title, body, actions=None, wait=False):
    """notify-send through the session's notification server. -> its stdout (the chosen action's name when ACTIONS was given), "" when
    there is no notify-send or no server: a toast is never a reason to fail."""
    argv = ["notify-send", "--app-name=themectl", "--expire-time=15000"]
    for a in actions or []:
        argv.append("--action=%s" % a)
    argv += [title, body]
    try:
        p = subprocess.run(argv, stdin=subprocess.DEVNULL, capture_output=True, text=True, timeout=60 if wait else 10)
    except (OSError, subprocess.TimeoutExpired):
        return ""
    return p.stdout.strip() if p.returncode == 0 else ""


def shell_config_file(P):
    """The shell.jsonc in force (`.jsonc` first, `.json` when there is none); a first write makes the `.jsonc`."""
    return _jsonc_lib().resolve(P.shell_config)


def _active_pictures(P):
    """[(monitor, path)] hyprpaper shows now (`hyprctl hyprpaper listactive`, lines `MON: /path`); [] when it does not say."""
    try:
        p = subprocess.run(["hyprctl", "hyprpaper", "listactive"], stdin=subprocess.DEVNULL, capture_output=True, text=True, timeout=10)
    except (OSError, subprocess.TimeoutExpired):
        return []
    if p.returncode != 0:
        return []
    return [(m.group(1), m.group(2)) for m in (re.match(r"^\s*([^:\s][^:]*):\s*(/\S.*?)\s*$", l) for l in p.stdout.splitlines()) if m]


def _apply_wallpaper_target(P, theme, mode):
    """The `wallpaper` target for THEME and MODE and the `yazi` one after it (yazi's marks follow the list), as `apply --only wallpaper,yazi`
    runs them -> (fails, their printed lines). A targets.json of the user's that has no yazi target runs the wallpaper alone."""
    import io
    buf = io.StringIO()
    names = [t["name"] for t in load_targets(P)[1]]
    fails = run_targets(P, theme, mode, only=[n for n in ("wallpaper", "yazi") if n in names], out=buf)
    return fails, buf.getvalue().strip()


def _one_path(P, args, what):
    if len(args.paths) != 1:
        raise Refused("pick exactly one image (%s given)" % ("none" if not args.paths else "%d" % len(args.paths)))
    return os.path.normpath(os.path.abspath(P.expand(args.paths[0])))


def _current_slot(P):
    """Under the lock: the theme in force, its mode, the slot's path in shell.jsonc and what it holds -> (theme, mode, key path, slot or None)."""
    st = read_state(P)
    theme = load_theme(P, st["theme"])
    mode = st["mode"]
    if not isinstance(theme.doc.get(mode), dict):
        raise Refused('theme "%s" has no "%s" block' % (theme.name, mode))
    try:
        slot = wallpaper_slot(P, theme.name, mode)
    except Fail as e:
        raise Refused("%s -- nothing written" % e)
    return theme, mode, ["theme", "wallpapers", theme.name, mode], slot


def _put_back(P, cfg, before, existed_file, bag_text):
    """After a refused picture: shell.jsonc and the bag as they were."""
    real = os.path.realpath(cfg)
    if existed_file:
        write_atomic(real, before, mode=stat.S_IMODE(os.stat(real).st_mode))
    elif os.path.exists(real):
        os.unlink(real)
    _put_bag(P, bag_text)


def _put_bag(P, text):
    if text is None:
        with contextlib.suppress(OSError):
            os.unlink(bag_file(P))
    else:
        write_atomic(bag_file(P), text)



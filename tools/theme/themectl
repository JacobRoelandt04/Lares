def _wallpaper_remove(P, args):
    src = _one_path(P, args, "remove")
    with locked(P):
        theme, mode, slot_path, slot = _current_slot(P)
        label = "%s %s" % (shown_name(theme.name), mode)
        if slot is None or src not in [p for _, p in slot["entries"]]:
            raise Refused("%s is not one of the %s wallpapers" % (os.path.basename(src), label))
        if len(slot["entries"]) == 1:
            raise Refused("%s is the only %s wallpaper: nothing removed (set another one first)" % (os.path.basename(src), label))
        cfg = shell_config_file(P)
        before = _read_text(cfg)
        try:
            after = jsonc_list_drop(before, slot_path, lambda v: os.path.normpath(P.expand(v)) == src)
        except ValueError as e:
            raise Refused("%s: %s -- nothing written" % (cfg, e))
        key = slot_key(theme.name, mode)
        was = load_bags(P)["slots"].get(key, bag_empty())["last"]
        bag_before = _read_text(bag_file(P))
        real = os.path.realpath(cfg)
        try:
            write_atomic(real, after, mode=stat.S_IMODE(os.stat(real).st_mode))
        except OSError as e:
            raise Refused("cannot write %s: %s" % (real, e))
        # the target does the rest: a pick that left the list is drawn again (one rule, in t_wallpaper), any other stays
        fails, said = _apply_wallpaper_target(P, theme, mode)
        now = load_bags(P)["slots"].get(key, bag_empty())["last"]
        nxt = now if was == src and now != src else ""
        print(said)
        if fails:
            _put_back(P, cfg, before, True, bag_before)
            _apply_wallpaper_target(P, theme, mode)
            if not args.no_notify:
                _notify("Wallpaper not removed", said.split("wallpaper", 1)[-1].strip()[:200])
            return 1
    left = len(slot["entries"]) - 1
    msg = "%s left the %s wallpapers (%d left)%s" % (os.path.basename(src), label, left, "; %s is on screen now" % os.path.basename(nxt) if nxt else "")
    print("themectl: wallpaper " + msg)
    if not args.no_notify:
        _notify("Wallpaper removed", msg)
    return 0



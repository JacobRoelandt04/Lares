def list_json(P):
    """What `list` says, as one object: the state, every theme with the modes it can be applied in (a theme that cannot be read says why
    and has no modes), the targets. Writes nothing and takes no lock."""
    files = theme_files(P)
    st = read_state(P)
    themes = []
    for n in sorted(files):
        t = {"name": n, "path": files[n], "modes": [], "active": n == st["theme"]}
        try:
            doc = load_json(files[n])
            if not isinstance(doc, dict):
                raise ValueError("not a JSON object")
            t["modes"] = [m for m in MODES if isinstance(doc.get(m), dict)]
        except (OSError, ValueError) as e:
            t["error"] = str(e)
        themes.append(t)
    options, targets, tpath = load_targets(P)
    return {"state": {"file": P.state_file, "present": bool(st["present"]), "theme": st["theme"], "mode": st["mode"]}, "themes": themes,
            "targets": [{"name": t["name"], "type": t.get("type"), "enabled": target_off(P, t) == ""} for t in targets], "targetsFile": tpath}



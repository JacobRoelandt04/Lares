# Night Owl light -- a btop theme made by tools/theme/pairgen.py from themes/night-owl.json (light), for the btop target of tools/theme/themectl.
# themectl copies it into ~/.config/btop/themes/ when first used (and `themectl install` refreshes it) and points current.theme
# at it. Edit freely: a copy there that is newer than the repo's is kept. Colours are "#RRGGBB"; an empty value is btop's default.

theme[main_bg]="#F0F0F0"
theme[main_fg]="#403F53"
theme[title]="#403F53"
theme[hi_fg]="#4876D6"
theme[selected_bg]="#CAD6ED"
theme[selected_fg]="#4876D6"
theme[inactive_fg]="#8496A0"
theme[graph_text]="#5F6075"
theme[meter_bg]="#D4D4D4"
theme[proc_misc]="#4876D6"
theme[cpu_box]="#994CC3"
theme[mem_box]="#08916A"
theme[net_box]="#DE3D3B"
theme[proc_box]="#4876D6"
theme[div_line]="#AEB9BF"
theme[temp_start]="#08916A"
theme[temp_mid]="#DAAA01"
theme[temp_end]="#DE3D3B"
theme[cpu_start]="#2AA298"
theme[cpu_mid]="#0C969B"
theme[cpu_end]="#994CC3"
theme[free_start]="#994CC3"
theme[free_mid]=""
theme[free_end]="#4876D6"
theme[cached_start]="#0C969B"
theme[cached_mid]=""
theme[cached_end]="#4876D6"
theme[available_start]="#E0752A"
theme[available_mid]=""
theme[available_end]="#DE3D3B"
theme[used_start]="#08916A"
theme[used_mid]=""
theme[used_end]="#2AA298"
theme[download_start]="#E0752A"
theme[download_mid]=""
theme[download_end]="#DE3D3B"
theme[upload_start]="#08916A"
theme[upload_mid]=""
theme[upload_end]="#2AA298"
theme[process_start]="#0C969B"
theme[process_mid]=""
theme[process_end]="#994CC3"

# Monokai light -- a btop theme made by tools/theme/pairgen.py from themes/monokai.json (light), for the btop target of tools/theme/themectl.
# themectl copies it into ~/.config/btop/themes/ when first used (and `themectl install` refreshes it) and points current.theme
# at it. Edit freely: a copy there that is newer than the repo's is kept. Colours are "#RRGGBB"; an empty value is btop's default.

theme[main_bg]="#FAF4F2"
theme[main_fg]="#29242A"
theme[title]="#29242A"
theme[hi_fg]="#1C8CA8"
theme[selected_bg]="#CFDDE2"
theme[selected_fg]="#1C8CA8"
theme[inactive_fg]="#918C8E"
theme[graph_text]="#706B6E"
theme[meter_bg]="#DDD8D6"
theme[proc_misc]="#1C8CA8"
theme[cpu_box]="#7058BE"
theme[mem_box]="#269D69"
theme[net_box]="#E14775"
theme[proc_box]="#4E7FE0"
theme[div_line]="#BAB4B5"
theme[temp_start]="#269D69"
theme[temp_mid]="#CC7A0A"
theme[temp_end]="#E14775"
theme[cpu_start]="#2A9A8C"
theme[cpu_mid]="#1C8CA8"
theme[cpu_end]="#7058BE"
theme[free_start]="#7058BE"
theme[free_mid]=""
theme[free_end]="#4E7FE0"
theme[cached_start]="#1C8CA8"
theme[cached_mid]=""
theme[cached_end]="#4E7FE0"
theme[available_start]="#E16032"
theme[available_mid]=""
theme[available_end]="#E14775"
theme[used_start]="#269D69"
theme[used_mid]=""
theme[used_end]="#2A9A8C"
theme[download_start]="#E16032"
theme[download_mid]=""
theme[download_end]="#E14775"
theme[upload_start]="#269D69"
theme[upload_mid]=""
theme[upload_end]="#2A9A8C"
theme[process_start]="#1C8CA8"
theme[process_mid]=""
theme[process_end]="#7058BE"

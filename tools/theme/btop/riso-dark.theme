# Riso dark -- a btop theme made by tools/theme/pairgen.py from themes/riso.json (dark), for the btop target of tools/theme/themectl.
# themectl copies it into ~/.config/btop/themes/ when first used (and `themectl install` refreshes it) and points current.theme
# at it. Edit freely: a copy there that is newer than the repo's is kept. Colours are "#RRGGBB"; an empty value is btop's default.

theme[main_bg]="#2D1B26"
theme[main_fg]="#F2EBE0"
theme[title]="#F2EBE0"
theme[hi_fg]="#FF5CB8"
theme[selected_bg]="#622E4B"
theme[selected_fg]="#FF5CB8"
theme[inactive_fg]="#8C6E7E"
theme[graph_text]="#CDB7C2"
theme[meter_bg]="#4B3944"
theme[proc_misc]="#FF5CB8"
theme[cpu_box]="#B497E8"
theme[mem_box]="#5BD08A"
theme[net_box]="#FF5A4E"
theme[proc_box]="#7AA6EC"
theme[div_line]="#644B59"
theme[temp_start]="#5BD08A"
theme[temp_mid]="#FFC93C"
theme[temp_end]="#FF5A4E"
theme[cpu_start]="#62C2B1"
theme[cpu_mid]="#5EC8E5"
theme[cpu_end]="#B497E8"
theme[free_start]="#B497E8"
theme[free_mid]=""
theme[free_end]="#7AA6EC"
theme[cached_start]="#5EC8E5"
theme[cached_mid]=""
theme[cached_end]="#7AA6EC"
theme[available_start]="#FF8A4C"
theme[available_mid]=""
theme[available_end]="#FF5A4E"
theme[used_start]="#5BD08A"
theme[used_mid]=""
theme[used_end]="#62C2B1"
theme[download_start]="#FF8A4C"
theme[download_mid]=""
theme[download_end]="#FF5A4E"
theme[upload_start]="#5BD08A"
theme[upload_mid]=""
theme[upload_end]="#62C2B1"
theme[process_start]="#5EC8E5"
theme[process_mid]=""
theme[process_end]="#B497E8"

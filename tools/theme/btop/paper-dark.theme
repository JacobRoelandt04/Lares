# Paper dark -- a btop theme made by tools/theme/pairgen.py from themes/paper.json (dark), for the btop target of tools/theme/themectl.
# themectl copies it into ~/.config/btop/themes/ when first used (and `themectl install` refreshes it) and points current.theme
# at it. Edit freely: a copy there that is newer than the repo's is kept. Colours are "#RRGGBB"; an empty value is btop's default.

theme[main_bg]="#272520"
theme[main_fg]="#EEEADA"
theme[title]="#EEEADA"
theme[hi_fg]="#E8735E"
theme[selected_bg]="#4A473E"
theme[selected_fg]="#EEEADA"
theme[inactive_fg]="#7C786B"
theme[graph_text]="#B3AE9E"
theme[meter_bg]="#46433A"
theme[proc_misc]="#EEEADA"
theme[cpu_box]="#B3AE9E"
theme[mem_box]="#B3AE9E"
theme[net_box]="#B3AE9E"
theme[proc_box]="#B3AE9E"
theme[div_line]="#7C786B"
theme[temp_start]="#7C786B"
theme[temp_mid]="#EEEADA"
theme[temp_end]="#E8735E"
theme[cpu_start]="#7C786B"
theme[cpu_mid]="#EEEADA"
theme[cpu_end]="#E8735E"
theme[free_start]="#7FB35F"
theme[free_mid]=""
theme[free_end]="#7FB35F"
theme[cached_start]="#6FA3E8"
theme[cached_mid]=""
theme[cached_end]="#6FA3E8"
theme[available_start]="#7FB35F"
theme[available_mid]=""
theme[available_end]="#7FB35F"
theme[used_start]="#E8735E"
theme[used_mid]=""
theme[used_end]="#E8735E"
theme[download_start]="#7C786B"
theme[download_mid]="#EEEADA"
theme[download_end]="#E8735E"
theme[upload_start]="#7C786B"
theme[upload_mid]="#EEEADA"
theme[upload_end]="#E8735E"
theme[process_start]="#7C786B"
theme[process_mid]="#EEEADA"
theme[process_end]="#E8735E"

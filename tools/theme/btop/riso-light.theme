# Riso light -- a btop theme made by tools/theme/pairgen.py from themes/riso.json (light), for the btop target of tools/theme/themectl.
# themectl copies it into ~/.config/btop/themes/ when first used (and `themectl install` refreshes it) and points current.theme
# at it. Edit freely: a copy there that is newer than the repo's is kept. Colours are "#RRGGBB"; an empty value is btop's default.

theme[main_bg]="#F3F0EA"
theme[main_fg]="#283C7E"
theme[title]="#283C7E"
theme[hi_fg]="#EE3A9E"
theme[selected_bg]="#F8CDD9"
theme[selected_fg]="#EE3A9E"
theme[inactive_fg]="#8C94B8"
theme[graph_text]="#4F5D94"
theme[meter_bg]="#D6D4CF"
theme[proc_misc]="#EE3A9E"
theme[cpu_box]="#765BA7"
theme[mem_box]="#00A95C"
theme[net_box]="#E0303A"
theme[proc_box]="#3255A4"
theme[div_line]="#B4B8CC"
theme[temp_start]="#00A95C"
theme[temp_mid]="#E09A00"
theme[temp_end]="#E0303A"
theme[cpu_start]="#00838A"
theme[cpu_mid]="#0078BF"
theme[cpu_end]="#765BA7"
theme[free_start]="#765BA7"
theme[free_mid]=""
theme[free_end]="#3255A4"
theme[cached_start]="#0078BF"
theme[cached_mid]=""
theme[cached_end]="#3255A4"
theme[available_start]="#FF6C2F"
theme[available_mid]=""
theme[available_end]="#E0303A"
theme[used_start]="#00A95C"
theme[used_mid]=""
theme[used_end]="#00838A"
theme[download_start]="#FF6C2F"
theme[download_mid]=""
theme[download_end]="#E0303A"
theme[upload_start]="#00A95C"
theme[upload_mid]=""
theme[upload_end]="#00838A"
theme[process_start]="#0078BF"
theme[process_mid]=""
theme[process_end]="#765BA7"

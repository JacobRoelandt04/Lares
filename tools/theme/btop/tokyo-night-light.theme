# Tokyo Night light -- a btop theme made by tools/theme/pairgen.py from themes/tokyo-night.json (light), for the btop target of tools/theme/themectl.
# themectl copies it into ~/.config/btop/themes/ when first used (and `themectl install` refreshes it) and points current.theme
# at it. Edit freely: a copy there that is newer than the repo's is kept. Colours are "#RRGGBB"; an empty value is btop's default.

theme[main_bg]="#E6E7ED"
theme[main_fg]="#343B58"
theme[title]="#343B58"
theme[hi_fg]="#2959AA"
theme[selected_bg]="#BBC8E0"
theme[selected_fg]="#2959AA"
theme[inactive_fg]="#8990A3"
theme[graph_text]="#5E606C"
theme[meter_bg]="#CACBD0"
theme[proc_misc]="#2959AA"
theme[cpu_box]="#65359D"
theme[mem_box]="#385F0D"
theme[net_box]="#8C4351"
theme[proc_box]="#2959AA"
theme[div_line]="#ADB2C0"
theme[temp_start]="#385F0D"
theme[temp_mid]="#8F5E15"
theme[temp_end]="#8C4351"
theme[cpu_start]="#33635C"
theme[cpu_mid]="#006C86"
theme[cpu_end]="#65359D"
theme[free_start]="#65359D"
theme[free_mid]=""
theme[free_end]="#2959AA"
theme[cached_start]="#006C86"
theme[cached_mid]=""
theme[cached_end]="#2959AA"
theme[available_start]="#965027"

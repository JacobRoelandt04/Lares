# Monokai dark -- a btop theme made by tools/theme/pairgen.py from themes/monokai.json (dark), for the btop target of tools/theme/themectl.
# themectl copies it into ~/.config/btop/themes/ when first used (and `themectl install` refreshes it) and points current.theme
# at it. Edit freely: a copy there that is newer than the repo's is kept. Colours are "#RRGGBB"; an empty value is btop's default.

theme[main_bg]="#2D2A2E"
theme[main_fg]="#FCFCFA"
theme[title]="#FCFCFA"
theme[hi_fg]="#78DCE8"
theme[selected_bg]="#44575D"
theme[selected_fg]="#78DCE8"
theme[inactive_fg]="#727072"
theme[graph_text]="#C1C0C0"
theme[meter_bg]="#4D484F"
theme[proc_misc]="#78DCE8"
theme[cpu_box]="#AB9DF2"
theme[mem_box]="#A9DC76"
theme[net_box]="#FF6188"
theme[proc_box]="#6E9CF7"
theme[div_line]="#555356"
theme[temp_start]="#A9DC76"
theme[temp_mid]="#FFD866"
theme[temp_end]="#FF6188"
theme[cpu_start]="#8FDCB0"
theme[cpu_mid]="#78DCE8"
theme[cpu_end]="#AB9DF2"
theme[free_start]="#AB9DF2"
theme[free_mid]=""
theme[free_end]="#6E9CF7"
theme[cached_start]="#78DCE8"
theme[cached_mid]=""
theme[cached_end]="#6E9CF7"
theme[available_start]="#FC9867"
theme[available_mid]=""
theme[available_end]="#FF6188"
theme[used_start]="#A9DC76"
theme[used_mid]=""
theme[used_end]="#8FDCB0"
theme[download_start]="#FC9867"
theme[download_mid]=""
theme[download_end]="#FF6188"
theme[upload_start]="#A9DC76"
theme[upload_mid]=""
theme[upload_end]="#8FDCB0"
theme[process_start]="#78DCE8"
theme[process_mid]=""
theme[process_end]="#AB9DF2"

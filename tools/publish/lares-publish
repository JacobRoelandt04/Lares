#!/usr/bin/env python3
"""lares-publish -- the public copy of this repository: one squashed commit per export, on a local branch, never pushed by itself.

    lares publish check [<rev>]     what an export of <rev> (default HEAD) would hold, judged by the leak check; builds nothing
    lares publish build [<rev>]     the export commit on the local branch `public` (the first one an orphan, every later one on
                                    top of the last), after the leak check passed on exactly that tree and that commit
    --repo <dir>                    another repository (the cases)

WHY A SEPARATE COMMIT. History is not published (it holds what the scrub took out), so the public repository's history is a
chain of exports: each one the private tree of that day minus tools/publish/exclude.txt (the agents' notes, the feedback).
Only objects reachable from `public` are ever pushed (`git push public public:main`), so nothing of the private history
travels. Never merge `public` into main or main into `public`.

THE COMMIT carries the identity of config/privacy.jsonc `publish` (name, e-mail: a GitHub no-reply address; it refuses
without one) and a UTC date: a local time zone would say where its author lives.

The push is yours (an outward step, like a deploy): the tool prints it and stops. Exit 0 built or nothing new, 1 the leak
check failed (nothing built, `public` unchanged), 2 could not run.
"""
import argparse
import datetime
import os
import subprocess
import sys
import tempfile

HERE = os.path.dirname(os.path.abspath(__file__))
sys.path.insert(0, os.path.join(HERE, "..", "lib"))
import jsonc  # noqa: E402

CHECK = os.path.join(HERE, "privacy_check.py")
BRANCH = "refs/heads/public"
ARM = os.environ.get("PUBLISH_ARM", "")     # tools/dev/publish_cases.py: keepall (nothing is left out), localtz (the local zone)


def git(repo, *args, env=None, check=True):
    r = subprocess.run(["git", "-C", repo] + list(args), capture_output=True, text=True, env=env)
    if check and r.returncode != 0:
        sys.exit("lares publish: git %s: %s" % (" ".join(args[:2]), r.stderr.strip()))
    return r.stdout.strip()


def say(s):
    print("lares publish: " + s)


def excluded(repo):
    pats = []
    try:
        with open(os.path.join(repo, "tools", "publish", "exclude.txt"), encoding="utf-8") as f:
            for line in f:
                line = line.strip()
                if line and not line.startswith("#"):
                    pats.append(line.lstrip("/"))
    except OSError:
        sys.exit("lares publish: tools/publish/exclude.txt is missing: refusing (it would publish everything)")
    return pats


def identity(repo):
    path = os.environ.get("LARES_PRIVACY_FILE") or jsonc.resolve(os.path.join(repo, "config", "privacy.jsonc"))
    if not os.path.exists(path):
        sys.exit("lares publish: no private list (config/privacy.jsonc; the template is .examples/privacy.jsonc): refusing")
    pub = (jsonc.load(path).get("publish") or {})
    name, email = str(pub.get("name") or "").strip(), str(pub.get("email") or "").strip()
    if not name or not email:
        sys.exit("lares publish: config/privacy.jsonc has no `publish` name and e-mail (a GitHub no-reply address): refusing")
    return name, email


def export_tree(repo, rev):
    """The tree of <rev> without the excluded paths, written through a temporary index (the real index is never touched)."""
    with tempfile.TemporaryDirectory(prefix="lares-publish-") as tmp:
        env = dict(os.environ, GIT_INDEX_FILE=os.path.join(tmp, "index"))
        git(repo, "read-tree", rev, env=env)
        if ARM != "keepall":
            specs = [p.rstrip("/") if p.endswith("/") else p for p in excluded(repo)]
            specs = [(":(glob)" + p) if any(c in p for c in "*?[") else p for p in specs]
            git(repo, "rm", "-r", "-q", "--cached", "--ignore-unmatch", "--", *specs, env=env)
        tree = git(repo, "write-tree", env=env)
        n = len(git(repo, "ls-tree", "-r", "--name-only", tree).splitlines())
    return tree, n


def leak_check(repo, tree, commit=None):
    args = [sys.executable, "-B", CHECK, "--repo", repo, "--tree", tree, "--export"] + (["--commit", commit] if commit else [])
    r = subprocess.run(args, capture_output=True, text=True)
    sys.stdout.write("".join("  " + l + "\n" for l in r.stdout.splitlines()))
    return r.returncode == 0


def main():
    ap = argparse.ArgumentParser(prog="lares publish")
    ap.add_argument("what", choices=["check", "build"])
    ap.add_argument("rev", nargs="?", default="HEAD")
    ap.add_argument("--repo", default=os.path.normpath(os.path.join(HERE, "..", "..")))
    a = ap.parse_args()
    repo = os.path.abspath(a.repo)
    rev = git(repo, "rev-parse", "--verify", a.rev + "^{commit}")
    tree, n = export_tree(repo, rev)
    say("the export of %s: %d files, tree %s" % (rev[:12], n, tree[:12]))
    if a.what == "check":
        ok = leak_check(repo, tree)
        say("the leak check %s" % ("passed: this tree may be published" if ok else "FAILED: nothing may be published"))
        return 0 if ok else 1
    name, email = identity(repo)
    if not leak_check(repo, tree):
        say("the leak check FAILED: nothing built, `public` unchanged")
        return 1
    parent = git(repo, "rev-parse", "--verify", "-q", BRANCH, check=False)
    if parent and git(repo, "rev-parse", parent + "^{tree}") == tree:
        say("nothing new since the last export (%s)" % parent[:12])
        return 0
    now = datetime.datetime.now(datetime.timezone.utc)
    date = now.astimezone().strftime("%s %z") if ARM == "localtz" else "%d +0000" % int(now.timestamp())
    env = dict(os.environ, GIT_AUTHOR_NAME=name, GIT_AUTHOR_EMAIL=email, GIT_COMMITTER_NAME=name, GIT_COMMITTER_EMAIL=email,
               GIT_AUTHOR_DATE=date, GIT_COMMITTER_DATE=date)
    msg = "Lares %s" % now.strftime("%Y-%m-%d")
    commit = git(repo, "commit-tree", tree, *(["-p", parent] if parent else []), "-m", msg, env=env)
    if not leak_check(repo, tree, commit):
        say("the leak check FAILED on the commit (its name or e-mail): `public` unchanged")
        return 1
    git(repo, "update-ref", BRANCH, commit, parent or "0" * 40)
    say("`public` is %s (%s), %d files" % (commit[:12], "the first export" if not parent else "on " + parent[:12], n))
    if not git(repo, "remote", "get-url", "public", check=False):
        say("no remote `public` yet: git remote add public git@github.com:<you>/<public repo>.git")
    say("to publish it: git push public public:main")
    return 0


if __name__ == "__main__":
    sys.exit(main())

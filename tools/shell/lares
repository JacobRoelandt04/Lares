# ==================================================================================================
usage_error() { printf 'lares: %s\n\n' "$1" >&2; usage >&2; exit 2; }

need_runtime() { [ -n "$RT" ] && [ -d "$RT" ] || die "XDG_RUNTIME_DIR is not set"; }

main() {
    local cmd=${1:-help} upd mode=act a
    [ "$#" -gt 0 ] && shift
    case $cmd in
        help|-h|--help|init|binds|config|setup|update-running|oled|cleanup-marks|panorama-import|migrate-name|cleanup-old-name|publish) ;;
        *)
            deployed_stale_recover "$@"
            [ -n "$RT" ] && [ -d "$RT" ] && { for a in "$@"; do [ "$a" = --dry-run ] && mode=plan; done; qmlls_recover "$mode"; } ;;
    esac
    case $cmd in
        deploy) need_runtime; deploy_cmd "$@" ;;
        start) need_runtime; start_cmd "$@" ;;
        restart) need_runtime; restart_cmd "$@" ;;
        status) need_runtime; status_cmd ;;
        log) need_runtime; show_log "$@" ;;
        binds) binds_cmd "$@" ;;
        setup) setup_cmd ;;
        config) python3 -B "$SELF_DIR/lares-config-check.py" "$@" ;;
        init) python3 -B "$SELF_DIR/lares-init.py" "$@" ;;
        apply) need_runtime; apply_commit "$@" ;;
        publish) exec python3 -B "$REPO/tools/publish/lares-publish" --repo "$REPO" "$@" ;;
        preview) preview "$@" ;;
        oled) oled_cmd "$@" ;;
        perf) [ "${1:-}" = tour ] || usage_error "perf tour [--fresh] [--boost-ab] [--no-theme] [--list] [--dry] | perf tour compare A.json B.json"
              shift; exec python3 -B "$SELF_DIR/lares-perf-tour" "$@" ;;
        session) session_cmd "$@" ;;
        snapshot) snapshot_cmd "$@" ;;
        update-running) upd=$(update_running_pid); [ -n "$upd" ] && echo "$upd" ;;
        cleanup-marks) cleanup_marks_cmd "$@" ;;
        panorama-import) panorama_import_cmd "$@" ;;
        migrate-name) migrate_name_cmd "$@" ;;
        cleanup-old-name) cleanup_old_name_cmd "$@" ;;
        fallback) need_runtime; fallback_cmd ;;
        trial|revert|root-steps)
            printf "lares: '%s' is gone: the shell is the desktop, and lares edits no config file.%s\n" "$cmd" \
                "$([ "$cmd" = root-steps ] && echo " 'lares setup' prints the root steps.")" >&2
            exit 2 ;;
        help|-h|--help) usage ;;
        *) usage_error "unknown command: $cmd" ;;
    esac
}
main "$@"

migrate_name_cmd() {
    local a rc dry=()
    for a in "$@"; do
        case $a in --dry-run) dry=(--dry-run) ;; *) usage_error "migrate-name [--dry-run]" ;; esac
    done
    [ -n "$RT" ] && [ -d "$RT" ] || die "XDG_RUNTIME_DIR is not set"
    a=$(git -C "$REPO" rev-parse --show-toplevel 2> /dev/null) && [ "$(cd "$a" && pwd -P)" = "$REPO" ] \
        || die "migrate-name: run the repo's lares ($REPO is not the top of a git work tree): ~/.local/bin/lares is linked to it"
    migrate_args
    python3 "$MIGRATE" migrate "${MIGRATE_ARGS[@]}" "${dry[@]}"; rc=$?
    [ "$rc" -eq 0 ] && [ "${#dry[@]}" -eq 0 ] || return "$rc"
    echo
    echo "What is left, in this order (each step is safe to repeat; the old names keep working until the last one):"
    echo "  1. lares deploy        (the first deploy after this replaces a supervisor of the old name, and places a shim at each old entry-point name your lines still run)"
    echo "  2. your lines, right after it (until they say lares: the shell's global keys do nothing) -- each STALE row below has its new line in the MISSING row beside it:"

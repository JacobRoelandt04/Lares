def ap_settings(ssid, psk, band):
    ssid_b = str(ssid).encode("utf-8")
    conn = {"id": "Hotspot", "uuid": str(uuidlib.uuid4()), "type": "802-11-wireless", "autoconnect": False}
    w = {"ssid": dbus.ByteArray(ssid_b), "mode": "ap"}
    if band:
        w["band"] = str(band)
    s = {"connection": a_sv(conn), "802-11-wireless": a_sv(w), "ipv4": a_sv({"method": "shared"}), "ipv6": a_sv({"method": "ignore"})}
    if psk:
        s["802-11-wireless-security"] = a_sv({"key-mgmt": "wpa-psk", "psk": str(psk)})
    return s


def hotspot_mutator(msg):
    def mutate(st):
        w = sect(st, "802-11-wireless")
        if msg.get("ssid"):
            w["ssid"] = dbus.ByteArray(str(msg["ssid"]).encode("utf-8"))
        if msg.get("band"):
            w["band"] = str(msg["band"])
        if msg.get("psk"):
            sec = sect(st, "802-11-wireless-security")
            sec["key-mgmt"] = "wpa-psk"
            sec["psk"] = str(msg["psk"])
    return mutate


@command
def cmd_hotspot_config(msg, reply):
    """Save the hotspot's name / password / band WITHOUT starting it: the profile `uuid` (or the first AP-mode one), else a new one."""
    uuid = str(msg.get("uuid") or "")
    prof = profile_by_uuid(uuid) if uuid else next((p for p in sorted(PROFILES.values(), key=lambda p: p["id"]) if p["mode"] == "ap"), None)
    if uuid and prof is None:
        return reply(False, "no such profile")
    if prof is not None:
        if prof["mode"] != "ap":
            return reply(False, "not an access point profile")
        return merge_update(prof["uuid"], hotspot_mutator(msg), lambda ok, error=None, data=None: reply(ok, error, data or {"uuid": prof["uuid"]}))
    if not msg.get("ssid"):
        return reply(False, "a new hotspot needs a name")
    s = ap_settings(msg["ssid"], msg.get("psk"), msg.get("band"))
    new_uuid = str(s["connection"]["uuid"])
    nm_call(NM_PATH + "/Settings", NM_SETTINGS, "AddConnection", "a{sa{sv}}", (dbus.Dictionary(s, signature="sa{sv}"),),
            lambda path: reply(True, data={"uuid": new_uuid, "created": True}), nm_err(reply))


@command
def cmd_hotspot(msg, reply):
    wp = need_wifi(reply)
    if not wp:
        return
    if not msg.get("on"):
        for a in build_active():
            prof = profile_by_uuid(a["uuid"])
            if prof and prof["mode"] == "ap" and (not msg.get("uuid") or msg["uuid"] == a["uuid"]):
                return nm_call(NM_PATH, NM_IF, "DeactivateConnection", "o", (dbus.ObjectPath(a["path"]),), lambda: reply(True),
                               nm_err(reply))
        return reply(True, data={"was": "off"})
    uuid = msg.get("uuid")
    prof = profile_by_uuid(str(uuid)) if uuid else None
    if uuid and prof is None:
        return reply(False, "no such profile")
    if prof is None and not (msg.get("ssid") or msg.get("psk") or msg.get("band")):
        prof = next((p for p in PROFILES.values() if p["mode"] == "ap" and p["id"] == "Hotspot"), None)

    if prof is not None:
        if prof["mode"] != "ap":
            return reply(False, "not an access point profile")
        return activate_on(prof, wp, "/", lambda active: reply(True, data={"active": str(active), "uuid": prof["uuid"]}), reply,
                           mutate=hotspot_mutator(msg) if msg.get("ssid") or msg.get("psk") or msg.get("band") else None)
    ssid = msg.get("ssid") or "laptop-hotspot"
    s = ap_settings(ssid, msg.get("psk"), msg.get("band"))
    uuid = str(s["connection"]["uuid"])
    nm_call(NM_PATH, NM_IF, "AddAndActivateConnection2", "a{sa{sv}}ooa{sv}",
            (dbus.Dictionary(s, signature="sa{sv}"), dbus.ObjectPath(wp), dbus.ObjectPath("/"), a_sv()),
            lambda path, active, res: reply(True, data={"active": str(active), "uuid": uuid, "created": True}), nm_err(reply),
            timeout=30.0)



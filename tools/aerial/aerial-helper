    return {"path": path, "uuid": str(a.get("Uuid", "")), "id": cid, "type": typ, "devices": ifaces,
            "state": ACTIVE_STATES.get(st, "state%d" % st), "vpn": bool(a.get("Vpn", False)) or typ in ("vpn", "wireguard"),
            "default4": bool(a.get("Default", False)), "default6": bool(a.get("Default6", False)),
            "specific": str(a.get("SpecificObject", "")) if str(a.get("SpecificObject", "/")) != "/" else "",
            "proton": typ == "wireguard" and cid.startswith("ProtonVPN "), "killswitch": cid.startswith("pvpn-killswitch")}


def build_active():
    man = P.get(NM_PATH, {}).get(NM_IF, {})
    return sorted((active_dict(str(p)) for p in man.get("ActiveConnections", []) if NM_ACTIVE in P.get(str(p), {})),
                  key=lambda a: a["path"])


def build_profiles():
    return sorted((dict(p) for p in PROFILES.values()), key=lambda p: (p["id"], p["uuid"]))


def build_nm():
    man = P.get(NM_PATH, {}).get(NM_IF, {})
    prim = str(man.get("PrimaryConnection", "/"))
    pid = str(P.get(prim, {}).get(NM_ACTIVE, {}).get("Id", "")) if prim != "/" else ""
    real = pid
    if pid.startswith("pvpn-killswitch"):
        real = ""
        for a in build_active():
            if a["default4"] and not a["killswitch"] and not a["proton"] and not a["vpn"]:
                real = a["id"]
                break
        if not real:
            for a in build_active():
                if a["type"] in ("802-11-wireless", "802-3-ethernet") and a["state"] == "activated":
                    real = a["id"]
                    break
    return {"running": NM_OWNED["v"], "state": int(man.get("State", 0) or 0), "primary": pid, "primaryReal": real,
            "connectivity": int(man.get("Connectivity", 0) or 0), "wirelessEnabled": bool(man.get("WirelessEnabled", False)),
            "wirelessHardwareEnabled": bool(man.get("WirelessHardwareEnabled", True)), "version": str(man.get("Version", ""))}



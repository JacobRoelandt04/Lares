def call(dest, path, iface, method, sig, args, ok=None, err=None, timeout=15.0):
    """ONE async D-Bus call. `ok(*reply)`, `err(DBusException)`. Never blocks, never raises into the caller's turn."""
    def good(*r):
        if ok is not None:
            guarded(ok)(*r)

    def bad(e):
        if err is not None:
            guarded(err)(e)
        else:
            log("warn", "%s.%s failed: %s" % (iface, method, dbus_text(e)))
    try:
        BUS.call_async(dest, path, iface, method, sig, args, good, bad, timeout=timeout)
    except Exception as e:
        guarded(bad)(e)


def dbus_text(e):
    try:
        n = e.get_dbus_name()
    except Exception:
        n = ""
    m = ""
    try:
        m = e.get_dbus_message()
    except Exception:
        m = str(e)
    m = (m or str(e)).strip()
    return ("%s: %s" % (n, m)) if n and n not in m else (m or n or type(e).__name__)


def nm_call(path, iface, method, sig, args, ok=None, err=None, timeout=15.0):
    call(NM_NAME, path, iface, method, sig, args, ok, err, timeout)


def get_all(path, iface, cb, err=None):
    nm_call(path, PROPS, "GetAll", "s", (iface,), cb, err or (lambda e: None), timeout=10.0)



# ---- speed test ----------------------------------------------------------------------------------------------------------------
SPEED = {"task": None, "error": ""}
SIZES = [100000, 1000000, 10000000, 25000000, 100000000]
CURL_W = "LARES %{time_starttransfer} %{time_total} %{time_pretransfer} %{size_download} %{size_upload} %{http_code}\\n"


def curl_argv(url, up_bytes=None):
    argv = ["curl", "-sS", "--max-time", "40", "-o", "/dev/null", "-D", "-", "-w", CURL_W]
    if up_bytes is not None:
        argv += ["-X", "POST", "-H", "Content-Type: application/octet-stream", "--data-binary", "@-"]
    return argv + [url]


def parse_curl(out):
    hdr = {}
    mark_ = None
    for line in out.splitlines():
        if line.startswith("LARES "):
            mark_ = line.split()[1:]
        elif ":" in line:
            k, v = line.split(":", 1)
            hdr[k.strip().lower()] = v.strip()
    if not mark_ or len(mark_) < 6:
        return None
    return {"ttfb": float(mark_[0]), "total": float(mark_[1]), "pretransfer": float(mark_[2]), "down": int(float(mark_[3])),
            "up": int(float(mark_[4])), "code": int(mark_[5]), "headers": hdr}


def server_time_s(headers):
    m = re.search(r"cfWorker;dur=([\d.]+)|cfSpeedWorker;dur=([\d.]+)", headers.get("server-timing", ""))
    if m:
        return float(m.group(1) or m.group(2)) / 1000.0
    return 0.0


def p90(xs):
    if not xs:
        return 0.0
    s = sorted(xs)
    return s[min(len(s) - 1, int(0.9 * len(s) + 0.9999) - 1)] if len(s) > 1 else s[0]


def why_curl(rc, err, to, r):
    """The reason a curl request gave nothing, in curl's own words (or the server's status)."""
    err = (err or "").strip().splitlines()
    if to or rc == 28:
        return "the request timed out" + (" (%s)" % err[-1][:120] if err else "")
    if err:
        return err[-1][:200]
    if r is not None and r["code"] != 200:
        return "the server answered HTTP %d" % r["code"]
    return "curl exited %s with no output" % rc


def speed_run(base, cap):
    base = base.rstrip("/")
    used = 0
    colo = ""

    def prog(phase, live):
        emit({"t": "speed", "phase": phase, "liveMbps": round(live, 2), "result": None})

    def fail(reason):
        SPEED["error"] = reason
        emit({"t": "speed", "phase": "failed", "liveMbps": 0, "result": None, "error": reason})
        return None
    prog("latency", 0)
    lats = []
    last = ""
    # one lost probe is not a failed test: 20 are asked, the test needs 5 answers
    for _ in range(20):
        rc, out, err, to = yield Run(curl_argv(base + "/__down?bytes=0"), timeout_s=10)
        r = parse_curl(out or "")
        if rc != 0 or not r or r["code"] != 200:
            last = "latency: " + why_curl(rc, err, to, r)
            continue
        m = re.search(r"-([A-Za-z]{3})\s*$", r["headers"].get("cf-ray", ""))
        if m:
            colo = m.group(1).upper()
        lats.append(max(0.0, (r["ttfb"] - server_time_s(r["headers"])) * 1000.0))
    if len(lats) < 5:
        return fail(last or "latency: no answer")
    jitter = sum(abs(b - a) for a, b in zip(lats, lats[1:])) / max(1, len(lats) - 1)
    latency = sum(lats) / len(lats)
    res = {"downMbps": 0.0, "upMbps": 0.0, "latencyMs": round(latency, 2), "jitterMs": round(jitter, 2), "colo": colo, "bytes": 0}
    for phase in ("down", "up"):
        prog(phase, 0)
        speeds = []
        grew = True
        last = ""
        for size in SIZES:
            if not grew:
                break
            slow = False
            for _ in range(3):
                if used + size > cap:
                    grew = False
                    break
                r = None
                for attempt in range(2):          # a transfer that fails outright is asked once more
                    if phase == "down":
                        rc, out, err, to = yield Run(curl_argv(base + "/__down?bytes=%d" % size), timeout_s=45)
                    else:
                        rc, out, err, to = yield Run(curl_argv(base + "/__up", up_bytes=size), timeout_s=45,
                                                     feed=["head", "-c", str(size), "/dev/zero"])
                    r = parse_curl(out or "")
                    nbytes = (r["down"] if phase == "down" else r["up"]) if r else 0
                    # a transfer cut by the clock still measured what it moved (a slow link at the larger sizes)
                    if r and ((rc == 0 and r["code"] == 200) or (rc == 28 and nbytes > 0)):
                        break
                    last = "%s: %s" % (phase, why_curl(rc, err, to, r))
                    r = None
                if r is None:
                    grew = False
                    break
                nbytes = r["down"] if phase == "down" else r["up"]
                used += nbytes
                dur = (r["total"] - r["ttfb"]) if phase == "down" else (r["total"] - r["pretransfer"])
                mbps = nbytes * 8.0 / max(dur, 1e-3) / 1e6
                speeds.append(mbps)
                prog(phase, mbps)
                # growth stops on the TRANSFER's time: the handshake and latency of a far server are not the link's speed
                if dur > 1.0 or rc != 0:
                    slow = True
            if slow:
                grew = False
        if not speeds:
            return fail(last or "%s: no transfer completed" % phase)
        res["downMbps" if phase == "down" else "upMbps"] = round(p90(speeds), 2)
    res["bytes"] = used
    res["atMs"] = now_ms()
    emit({"t": "speed", "phase": "done", "liveMbps": 0, "result": res})
    return res


@command
def cmd_speed(msg, reply):
    action = str(msg.get("action", "run"))
    if action == "cancel":
        t = SPEED["task"]
        if t is None:
            return reply(True, data={"was": "idle"})
        t.cancel()
        return reply(True)
    if SPEED["task"] is not None:
        return reply(False, "a speed test is running")
    base = str(msg.get("base") or "https://speed.cloudflare.com")
    cap = int(msg.get("capBytes") or 200 * 1000 * 1000)
    SPEED["error"] = ""

    def done(res, cancelled):
        SPEED["task"] = None
        if cancelled:
            emit({"t": "speed", "phase": "cancelled", "liveMbps": 0, "result": None})
        reply(res is not None, None if res is not None else ("cancelled" if cancelled else (SPEED["error"] or "the speed test failed")), data=res)
    SPEED["task"] = Task(speed_run(base, cap), done)



def mark(t):
    if t in PENDING_EMIT:
        return
    due = LAST_EMIT.get(t, 0) + COALESCE_MS / 1000.0
    delay = max(1, int((due - time.time()) * 1000))
    PENDING_EMIT[t] = GLib.timeout_add(delay, guarded(lambda t=t: flush(t)))


def mark_net():
    for t in DIRTY_NET:
        mark(t)


def flush(t):
    PENDING_EMIT.pop(t, None)
    LAST_EMIT[t] = time.time()
    obj = BUILDERS[t]()
    extra = {"complete": PROFILES_LOAD["listed"] and not PROFILES_LOAD["pending"]} if t == "profiles" else {}
    s = json.dumps([obj, extra], separators=(",", ":"), sort_keys=True)
    if LAST_JSON.get(t) == s:
        return False
    LAST_JSON[t] = s
    if isinstance(obj, list):
        emit(dict({"t": t, "v": obj}, **extra))   # `devices` / `active` / `profiles` are arrays: the line carries them as "v"
    else:
        emit(dict({"t": t}, **obj))
    return False


def ip_info(path, v6):
    d = P.get(str(path), {}).get(NM_IP6 if v6 else NM_IP4)
    if d is None:
        return None
    addrs = []
    for a in d.get("AddressData", []) or []:
        a = plain(a)
        addrs.append({"address": str(a.get("address", "")), "prefix": int(a.get("prefix", 0))})
    dns = []
    nsd = d.get("NameserverData")
    if nsd:
        for n in nsd:
            n = plain(n)
            dns.append(str(n.get("address", "")))
    elif d.get("Nameservers"):
        for n in d["Nameservers"]:
            if v6:
                try:
                    dns.append(str(ipaddress.IPv6Address(bytes(bytearray(int(b) for b in n)))))
                except Exception:
                    pass
            else:
                dns.append(socket.inet_ntoa(struct.pack("=I", int(n))))
    return {"addresses": addrs, "gateway": str(d.get("Gateway", "") or ""), "dns": dns}


def device_dict(path):
    ent = P.get(path, {})
    dev = ent.get(NM_DEV, {})
    t = int(dev.get("DeviceType", 0) or 0)
    wifi = ent.get(NM_WIFI, {})
    wired = ent.get(NM_WIRED, {})
    st = int(dev.get("State", 0) or 0)
    reason = dev.get("StateReason") or (0, 0)
    rc = int(reason[1]) if len(reason) > 1 else 0
    ac = str(dev.get("ActiveConnection", "/"))
    hw = wifi.get("HwAddress") or wired.get("HwAddress") or dev.get("HwAddress") or ""
    perm = wifi.get("PermHwAddress") or wired.get("PermHwAddress") or ""
    speed = 0
    if t == 1:
        speed = int(wired.get("Speed", 0) or 0)
    elif t == 2:
        speed = int(int(wifi.get("Bitrate", 0) or 0) / 1000)
    return {"path": path, "iface": str(dev.get("Interface", "")), "type": DEVICE_TYPES.get(t, "type%d" % t), "typeCode": t,
            "driver": str(dev.get("Driver", "")), "driverVersion": str(dev.get("DriverVersion", "") or ""),
            "firmware": str(dev.get("FirmwareVersion", "") or ""), "state": DEVICE_STATES.get(st, "state%d" % st), "stateCode": st,
            "stateReason": STATE_REASONS.get(rc, "reason%d" % rc), "stateReasonCode": rc, "hwAddress": mac_of(hw),
            "permHwAddress": mac_of(perm), "managed": bool(dev.get("Managed", False)),
            "carrier": bool(wired.get("Carrier", False)) if t == 1 else None, "speed": speed,
            "activeConnection": ac if ac != "/" else "", "ip4": ip_info(dev.get("Ip4Config", "/"), False),
            "ip6": ip_info(dev.get("Ip6Config", "/"), True)}


def device_paths():
    return [str(d) for d in prop(NM_PATH, NM_IF, "Devices", []) if str(d) in P and NM_DEV in P[str(d)]]


def wifi_device_path(iface=None):
    """The Wi-Fi device: the one named, else the best of NetworkManager's -- one it MANAGES (an unmanaged radio is somebody else's: the
    test bed's access points, a USB dongle the user handed to another tool), activated before available before the rest, then the
    first. The first found was taken before: in the test bed that was an unmanaged access-point radio, and every scan was refused."""
    best, best_rank = None, -1
    for p in device_paths():
        d = P[p][NM_DEV]
        if int(d.get("DeviceType", 0) or 0) != 2:
            continue
        if iface is not None:
            if str(d.get("Interface")) == iface:
                return p
            continue
        state = int(d.get("State", 0) or 0)
        rank = (2 if bool(d.get("Managed", False)) else 0) + (1 if state >= 30 else 0) + (1 if state == 100 else 0)
        if rank > best_rank:
            best, best_rank = p, rank
    return best


def device_path_by_iface(iface):
    for p in device_paths():
        if str(P[p][NM_DEV].get("Interface")) == iface:
            return p
    return None


def build_devices():
    return [device_dict(p) for p in device_paths()]


def ap_dict(path):
    a = P.get(path, {}).get(NM_AP, {})
    ssid = a.get("Ssid")
    sb = bytes(bytearray(int(x) for x in ssid)) if ssid is not None else b""
    freq = int(a.get("Frequency", 0) or 0)
    ls = int(a.get("LastSeen", -1))
    return {"path": path, "bssid": mac_of(a.get("HwAddress", "")), "ssid": utf8(sb), "ssidHex": sb.hex(), "freq": freq,
            "width": int(a.get("Bandwidth", 0) or 0), "strength": int(a.get("Strength", 0) or 0),
            "maxBitrate": int(a.get("MaxBitrate", 0) or 0), "flags": int(a.get("Flags", 0) or 0),
            "wpaFlags": int(a.get("WpaFlags", 0) or 0), "rsnFlags": int(a.get("RsnFlags", 0) or 0), "lastSeen": ls,
            "lastSeenMs": boot_s_to_epoch_ms(ls) if ls >= 0 else 0, "mode": int(a.get("Mode", 0) or 0)}


def build_wifi():
    wp = wifi_device_path()
    man = P.get(NM_PATH, {}).get(NM_IF, {})
    if wp is None:
        return {"device": None, "aps": [], "activeAp": "", "scanning": False, "lastScan": -1, "lastScanMs": 0,
                "radioOn": bool(man.get("WirelessEnabled", False)), "hardwareEnabled": bool(man.get("WirelessHardwareEnabled", True))}
    w = P[wp].get(NM_WIFI, {})
    dev = device_dict(wp)
    aps = sorted((ap_dict(p) for p in AP_SETS.get(wp, set()) if NM_AP in P.get(p, {})), key=lambda a: (a["bssid"], a["path"]))
    active = str(w.get("ActiveAccessPoint", "/"))
    act_bssid = mac_of(P.get(active, {}).get(NM_AP, {}).get("HwAddress", "")) if active != "/" else ""
    ls = int(w.get("LastScan", -1))
    scanning = bool(SCAN["asked"]) and time.time() - SCAN["since"] / 1000.0 < 12
    dev["bitrate"] = int(w.get("Bitrate", 0) or 0)
    dev["radioOn"] = bool(man.get("WirelessEnabled", False))
    dev["country"] = REG["country"]
    auuid = str(P.get(dev["activeConnection"], {}).get(NM_ACTIVE, {}).get("Uuid", "")) if dev["activeConnection"] else ""
    ap_prof = profile_by_uuid(auuid) if auuid else None
    dev["powersave"] = ap_prof["powersave"] if ap_prof else 0        # the active profile's setting: 3 is "on", the model reads that
    return {"device": dev, "aps": aps, "activeAp": act_bssid, "scanning": scanning, "lastScan": ls,
            "lastScanMs": boot_ms_to_epoch(ls), "radioOn": bool(man.get("WirelessEnabled", False)),
            "hardwareEnabled": bool(man.get("WirelessHardwareEnabled", True))}


def active_dict(path):
    a = P.get(path, {}).get(NM_ACTIVE, {})
    ifaces = []
    for d in a.get("Devices", []) or []:
        ifaces.append(str(P.get(str(d), {}).get(NM_DEV, {}).get("Interface", "")))
    cid = str(a.get("Id", ""))

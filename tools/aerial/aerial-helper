COMMANDS = {}


def command(fn):
    COMMANDS[fn.__name__[4:]] = fn
    return fn


def a_sv(d=None):
    return dbus.Dictionary(d or {}, signature="sv")


def need_wifi(reply):
    wp = wifi_device_path()
    if wp is None:
        reply(False, "no Wi-Fi device")
    return wp


def nm_err(reply):
    def e(exc):
        reply(False, dbus_text(exc))
    return e


@command
def cmd_scan(msg, reply):
    wp = need_wifi(reply)
    if not wp:
        return
    SCAN["asked"] = 1
    SCAN["since"] = time.time() * 1000
    mark("wifi")
    GLib.timeout_add(12500, guarded(lambda: (SCAN.update(asked=0), mark("wifi"), False)[2]))

    def bad(e):
        SCAN["asked"] = 0
        mark("wifi")
        reply(False, dbus_text(e))
    nm_call(wp, NM_WIFI, "RequestScan", "a{sv}", (a_sv(),), lambda: reply(True), bad)


def resolve_ap(wp, ap):
    if not ap:
        return "/"
    if str(ap).startswith("/"):
        return str(ap)
    want = str(ap).upper()
    for p in AP_SETS.get(wp, set()):
        if mac_of(P.get(p, {}).get(NM_AP, {}).get("HwAddress", "")) == want:
            return p
    return "/"


def pick_device_for_profile(prof, iface):
    if iface:
        return device_path_by_iface(iface)
    if prof and prof["ifname"]:
        p = device_path_by_iface(prof["ifname"])
        if p:
            return p
    t = prof["type"] if prof else "802-11-wireless"
    want = {"802-11-wireless": 2, "802-3-ethernet": 1}.get(t)
    for p in device_paths():
        if int(P[p][NM_DEV].get("DeviceType", 0) or 0) == want:
            return p
    return None


def stale_binding(prof, dev):
    """A profile bound (`connection.interface-name`) to an interface this machine does not have, asked onto a device it does have.
    The name is not stable here: the Wi-Fi card is wlp46s0 or wlp47s0 depending on whether the dGPU is on the PCI bus, and every profile
    nmcli / nm-applet once made carries the name of that day. NetworkManager refuses such a profile on the device ("profile is not
    compatible with device (mismatching interface name)", the user's machine 2026-11-20: no saved network and no hotspot would come
    up). A name that IS a device of this machine is a choice and is left alone."""
    name = prof.get("ifname") or ""
    if not name or str(P.get(dev, {}).get(NM_DEV, {}).get("Interface")) == name:
        return False
    return device_path_by_iface(name) is None


def unbind(st):
    c = st.get("connection")
    if c is not None and "interface-name" in c:
        del c["interface-name"]


def activate_on(prof, dev, spec, ok, reply, mutate=None):
    """ActivateConnection of a saved profile on a device; a dead interface name is taken off the profile first (and `mutate`, a patch
    of the caller's, goes in the same Update)."""
    def go():
        nm_call(NM_PATH, NM_IF, "ActivateConnection", "ooo", (dbus.ObjectPath(prof["path"]), dbus.ObjectPath(dev), dbus.ObjectPath(spec)),
                ok, nm_err(reply), timeout=30.0)
    stale = stale_binding(prof, dev)
    if not stale and mutate is None:
        return go()

    def both(st):
        if stale:
            unbind(st)
        if mutate is not None:
            mutate(st)
    merge_update(prof["uuid"], both, reply, then=go)


@command
def cmd_activate(msg, reply):
    prof = profile_by_uuid(str(msg.get("uuid", "")))
    if prof is None:
        return reply(False, "no such profile")
    dev = pick_device_for_profile(prof, msg.get("iface"))
    if dev is None:
        return reply(False, "no device for this profile")
    spec = resolve_ap(dev, msg.get("ap")) if prof["type"] == "802-11-wireless" else "/"
    activate_on(prof, dev, spec, lambda active: reply(True, data={"active": str(active)}), reply)


def eap_settings(eap):
    method = str(eap.get("method", "peap")).lower()
    x = {"eap": dbus.Array([method], signature="s")}
    if eap.get("identity"):
        x["identity"] = str(eap["identity"])
    if eap.get("anonymousIdentity"):
        x["anonymous-identity"] = str(eap["anonymousIdentity"])
    if eap.get("password"):
        x["password"] = str(eap["password"])
    if eap.get("phase2") and method in ("peap", "ttls"):
        x["phase2-auth"] = str(eap["phase2"]).lower()
    if eap.get("caCert"):
        x["ca-cert"] = dbus.ByteArray(b"file://" + str(eap["caCert"]).encode() + b"\0")
    else:
        x["system-ca-certs"] = False
    if eap.get("domain"):
        x["domain-suffix-match"] = str(eap["domain"])
    return x


def wifi_settings(msg, ssid_b, ifname=None):
    security = str(msg.get("security", "open"))
    cid = utf8(ssid_b) or "hidden"
    conn = {"id": cid, "uuid": str(uuidlib.uuid4()), "type": "802-11-wireless", "autoconnect": True}
    if ifname:
        conn["interface-name"] = ifname
    w = {"ssid": dbus.ByteArray(ssid_b), "mode": "infrastructure"}
    if msg.get("hidden"):
        w["hidden"] = True
    if msg.get("bssid"):
        try:
            w["bssid"] = dbus.ByteArray(bytes(int(x, 16) for x in str(msg["bssid"]).split(":")))
        except Exception:
            pass
    s = {"connection": a_sv(conn), "802-11-wireless": a_sv(w), "ipv4": a_sv({"method": "auto"}), "ipv6": a_sv({"method": "auto"})}
    if security in ("wpa2", "wpa2/3"):
        s["802-11-wireless-security"] = a_sv({"key-mgmt": "wpa-psk", "psk": str(msg.get("psk", ""))})
    elif security == "wpa3":
        s["802-11-wireless-security"] = a_sv({"key-mgmt": "sae", "psk": str(msg.get("psk", ""))})
    elif security == "owe":
        s["802-11-wireless-security"] = a_sv({"key-mgmt": "owe"})
    elif security == "wep":
        s["802-11-wireless-security"] = a_sv({"key-mgmt": "none", "wep-key0": str(msg.get("psk", "")), "wep-key-type": dbus.UInt32(1),
                                               "wep-tx-keyidx": dbus.UInt32(0)})
    elif security == "eap":
        s["802-11-wireless-security"] = a_sv({"key-mgmt": "wpa-eap"})
        s["802-1x"] = a_sv(eap_settings(msg.get("eap") or {}))
    return s


def merge_update(uuid, mutate, reply, then=None):
    """GetSettings -> mutate(settings) -> Update. `then()` runs after a good Update."""
    prof = profile_by_uuid(uuid)
    if prof is None:
        return reply(False, "no such profile")
    path = prof["path"]

    def got(settings):
        try:
            mutate(settings)
        except Exception as e:
            return reply(False, "bad patch: %s" % e)
        nm_call(path, NM_SETCONN, "Update", "a{sa{sv}}", (settings,), lambda: (then() if then else reply(True)), nm_err(reply))
    nm_call(path, NM_SETCONN, "GetSettings", "", (), got, nm_err(reply))


def sect(settings, name):
    if name not in settings:
        settings[name] = a_sv()
    return settings[name]


@command
def cmd_add_activate(msg, reply):
    wp = wifi_device_path(msg.get("iface"))
    if wp is None:
        return reply(False, "no Wi-Fi device")
    ssid_b = bytes.fromhex(msg["ssidHex"]) if msg.get("ssidHex") else str(msg.get("ssid", "")).encode("utf-8")
    existing = [p for p in PROFILES.values() if p["type"] == "802-11-wireless" and p["mode"] in ("infrastructure", "")
                and p["ssid"].encode("utf-8") == ssid_b and p["mode"] != "ap"]
    spec = resolve_ap(wp, msg.get("bssid")) if msg.get("bssid") else best_ap_for(wp, ssid_b)
    # A HIDDEN network's access point broadcasts no name: NetworkManager refuses that AP as the specific object of a connection that
    # carries the name ("802-11-wireless.ssid: connection does not match access point", the test bed's first real run). Whenever the
    # AP's own SSID is not the one asked for (hidden, or empty), activate with "/" and let NetworkManager probe for the name.
    if spec != "/":
        ap_ssid = P.get(spec, {}).get(NM_AP, {}).get("Ssid", b"")
        if msg.get("hidden") or bytes(bytearray(int(x) for x in ap_ssid)) != ssid_b:
            spec = "/"
    if existing and not msg.get("new"):
        # several profiles of one name (nmcli makes "<name> 1" when the first is bound to another interface): the one that fits this
        # device first, then the one used last
        here = str(P.get(wp, {}).get(NM_DEV, {}).get("Interface"))
        existing.sort(key=lambda p: (0 if p["ifname"] in ("", here) else 1, -p["timestamp"]))
        prof = existing[0]
        mutate = None
        if bool(msg.get("psk")) or bool((msg.get("eap") or {}).get("password")):
            def mutate(st):
                sec = sect(st, "802-11-wireless-security")
                if msg.get("psk"):
                    sec["psk"] = str(msg["psk"])
                if (msg.get("eap") or {}).get("password"):
                    sect(st, "802-1x")["password"] = str(msg["eap"]["password"])
        return activate_on(prof, wp, spec, lambda active: reply(True, data={"active": str(active), "uuid": prof["uuid"], "reused": True}), reply,
                           mutate=mutate)
    settings = wifi_settings(msg, ssid_b, ifname=None)
    uuid = str(settings["connection"]["uuid"])

    def ok(path, active, result):
        reply(True, data={"active": str(active), "uuid": uuid, "path": str(path), "reused": False})
    nm_call(NM_PATH, NM_IF, "AddAndActivateConnection2", "a{sa{sv}}ooa{sv}",
            (dbus.Dictionary(settings, signature="sa{sv}"), dbus.ObjectPath(wp), dbus.ObjectPath(spec), a_sv()), ok, nm_err(reply),
            timeout=30.0)


def best_ap_for(wp, ssid_b):
    best, bs = "/", -1
    for p in AP_SETS.get(wp, set()):
        a = P.get(p, {}).get(NM_AP, {})
        if a.get("Ssid") is not None and bytes(bytearray(int(x) for x in a["Ssid"])) == ssid_b:
            s = int(a.get("Strength", 0) or 0)
            if s > bs:
                best, bs = p, s
    return best


@command
def cmd_deactivate(msg, reply):
    u = str(msg.get("uuid", ""))
    for a in build_active():
        if a["uuid"] == u:
            return nm_call(NM_PATH, NM_IF, "DeactivateConnection", "o", (dbus.ObjectPath(a["path"]),), lambda: reply(True),
                           nm_err(reply))
    reply(False, "not active")


@command
def cmd_disconnect_device(msg, reply):
    """`disconnect_device {iface}`: the DEVICE's Disconnect, not the connection's deactivation. NetworkManager then autoconnects nothing
    on that device until the user activates something; after a plain DeactivateConnection its policy joined another saved network 20 ms
    later (the test bed's fourth run), so "pull the docked network off" never ended disconnected."""
    wp = wifi_device_path(msg.get("iface")) if msg.get("iface") else wifi_device_path()
    if wp is None:
        return reply(False, "no Wi-Fi device")
    nm_call(wp, NM_DEV, "Disconnect", "", (), lambda: reply(True), nm_err(reply))


@command
def cmd_delete(msg, reply):
    prof = profile_by_uuid(str(msg.get("uuid", "")))
    if prof is None:
        return reply(False, "no such profile")
    nm_call(prof["path"], NM_SETCONN, "Delete", "", (), lambda: reply(True), nm_err(reply))


def ip4_dns_u32(ip):
    return dbus.UInt32(struct.unpack("=I", socket.inet_aton(ip))[0])


def apply_patch(st, patch):
    if "ipv4" in patch:
        p = patch["ipv4"]
        s4 = sect(st, "ipv4")
        method = str(p.get("method", "auto"))
        s4["method"] = method
        for k in ("addresses", "address-data", "gateway"):
            s4.pop(k, None)
        if method == "manual":
            s4["address-data"] = dbus.Array([a_sv({"address": str(p["address"]), "prefix": dbus.UInt32(int(p.get("prefix", 24)))})],
                                            signature="a{sv}")
            if p.get("gateway"):
                s4["gateway"] = str(p["gateway"])
        dns = p.get("dns")
        if dns is not None:
            s4["dns"] = dbus.Array([ip4_dns_u32(x) for x in dns], signature="u")
            if method == "auto":
                s4["ignore-auto-dns"] = bool(dns)
    if "ipv6" in patch:
        sect(st, "ipv6")["method"] = str(patch["ipv6"].get("method", "auto"))
    if "mac" in patch:
        w = sect(st, "802-11-wireless")
        m = str(patch["mac"])
        if m in ("", "default"):
            w.pop("cloned-mac-address", None)
        else:
            w["cloned-mac-address"] = m
    if "metered" in patch:
        sect(st, "connection")["metered"] = dbus.Int32(METERED_SET[str(patch["metered"])])
    if "band" in patch:
        w = sect(st, "802-11-wireless")
        if patch["band"]:
            w["band"] = str(patch["band"])
        else:
            w.pop("band", None)
    if "bssid" in patch:
        w = sect(st, "802-11-wireless")
        if patch["bssid"]:
            w["bssid"] = dbus.ByteArray(bytes(int(x, 16) for x in str(patch["bssid"]).split(":")))
        else:
            w.pop("bssid", None)
    if "autoconnect" in patch:
        sect(st, "connection")["autoconnect"] = bool(patch["autoconnect"])
    if "priority" in patch:
        sect(st, "connection")["autoconnect-priority"] = dbus.Int32(int(patch["priority"]))
    if patch.get("psk"):         # a known network's new password (an empty one is "no change", never "open")
        sec = sect(st, "802-11-wireless-security")
        km = str(sec.get("key-mgmt", "") or "")
        if km == "none":
            sec["wep-key0"] = str(patch["psk"])
        else:
            if not km:
                sec["key-mgmt"] = "wpa-psk"
            sec["psk"] = str(patch["psk"])
    if isinstance(patch.get("eap"), dict):      # the EAP login: password / identity / anonymousIdentity
        x = sect(st, "802-1x")
        for k, key in (("password", "password"), ("identity", "identity"), ("anonymousIdentity", "anonymous-identity")):
            if patch["eap"].get(k):
                x[key] = str(patch["eap"][k])
    if "powersave" in patch:
        sect(st, "802-11-wireless")["powersave"] = dbus.UInt32(int(patch["powersave"]))      # 2 disable, 3 enable
    if patch.get("ssid"):
        sect(st, "802-11-wireless")["ssid"] = dbus.ByteArray(str(patch["ssid"]).encode("utf-8"))


@command
def cmd_update(msg, reply):
    patch = msg.get("patch") or {}
    merge_update(str(msg.get("uuid", "")), lambda st: apply_patch(st, patch), reply)



def make_reply(mid):
    state = {"done": False}

    def reply(ok, error=None, data=None):
        if state["done"]:
            return
        state["done"] = True
        if mid is None:
            return
        emit({"t": "reply", "id": mid, "ok": bool(ok), "error": error if not ok else None, "data": data})
    return reply


def handle_line(line):
    try:
        msg = json.loads(line)
        assert isinstance(msg, dict)
    except Exception:
        return log("warn", "a command line that is not a JSON object")
    name = str(msg.get("cmd", ""))
    reply = make_reply(msg.get("id"))
    if name == "quit":
        reply(True)
        return LOOP.quit()
    fn = COMMANDS.get(name)
    if fn is None:
        return reply(False, "unknown command")
    try:
        fn(msg, reply)
    except Exception as e:
        tb = traceback.extract_tb(sys.exc_info()[2])[-1]
        log("error", "cmd %s: %s: %s (line %d)" % (name, type(e).__name__, e, tb.lineno))
        reply(False, "internal error: %s" % type(e).__name__)


def on_stdin(fd, cond):
    try:
        data = os.read(fd, 65536)
    except BlockingIOError:
        return True
    except Exception:
        data = b""
    if not data:
        LOOP.quit()
        return False
    STDIN_BUF["b"] += data
    while b"\n" in STDIN_BUF["b"]:
        line, STDIN_BUF["b"] = STDIN_BUF["b"].split(b"\n", 1)
        if line.strip():
            handle_line(line.decode("utf-8", "replace"))
    return True



CHILDREN = set()


def kill_group(p, sig=signal.SIGKILL):
    try:
        os.killpg(p.pid, sig)
    except Exception:
        try:
            p.kill()
        except Exception:
            pass


class Run:
    """A request a Task yields: run a program, collect its output, give back (rc, out, err, timedout)."""

    def __init__(self, argv, timeout_s=10.0, feed=None, env=None):
        self.argv = argv
        self.timeout_s = timeout_s
        self.feed = feed          # argv of a producer whose stdout is the child's stdin
        self.env = env
        self.proc = None
        self.finished = False

    def start(self, task):
        env = dict(os.environ)
        env["LC_ALL"] = "C"
        if self.env:
            env.update(self.env)
        try:
            stdin = subprocess.DEVNULL
            feeder = None
            if self.feed:
                feeder = subprocess.Popen(self.feed, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, start_new_session=True)
                stdin = feeder.stdout
            p = subprocess.Popen(self.argv, stdin=stdin, stdout=subprocess.PIPE, stderr=subprocess.PIPE, env=env,
                                 start_new_session=True)
            if feeder is not None:
                feeder.stdout.close()
        except Exception as e:
            GLib.idle_add(lambda: task.step((127, "", "%s" % e, False)) and False)
            return
        self.proc = p
        self.feeder = feeder
        CHILDREN.add(p)
        bufs = {"out": [], "err": []}
        state = {"open": 2, "timedout": False}
        task.current = self

        def finish():
            if self.finished:
                return False
            rc = p.poll()
            if rc is None:
                GLib.timeout_add(10, guarded(finish))
                return False
            self.finished = True
            CHILDREN.discard(p)
            if self.feeder is not None:
                kill_group(self.feeder)
                try:
                    self.feeder.wait(0.1)
                except Exception:
                    pass
            if state["timedout"]:
                rc = None
            if state.get("tid"):
                GLib.source_remove(state["tid"])
            task.current = None
            task.step((rc, b"".join(bufs["out"]).decode("utf-8", "replace"), b"".join(bufs["err"]).decode("utf-8", "replace"),
                       state["timedout"]))
            return False

        def reader(which, fd):
            os.set_blocking(fd, False)

            def cb(_fd, cond):
                try:
                    data = os.read(_fd, 65536)
                except BlockingIOError:
                    return True
                except Exception:
                    data = b""
                if data:
                    bufs[which].append(data)
                    return True
                state["open"] -= 1
                if state["open"] == 0:
                    guarded(finish)()
                return False
            GLib.io_add_watch(fd, GLib.PRIORITY_DEFAULT, GLib.IO_IN | GLib.IO_HUP | GLib.IO_ERR, guarded_keep(cb))

        reader("out", p.stdout.fileno())
        reader("err", p.stderr.fileno())

        def timeout():
            state["timedout"] = True
            state["tid"] = None
            kill_group(p)
            if self.feeder is not None:
                kill_group(self.feeder)
            return False
        state["tid"] = GLib.timeout_add(int(self.timeout_s * 1000), guarded(timeout))

    def cancel(self):
        if self.proc is not None and not self.finished:
            kill_group(self.proc)
            if getattr(self, "feeder", None) is not None:
                kill_group(self.feeder)


class InThread:
    """A request a Task yields: a blocking function in a worker thread; (ok, value) back, or (False, 'timeout')."""

    def __init__(self, fn, timeout_s=10.0):
        self.fn = fn
        self.timeout_s = timeout_s

    def start(self, task):
        done = {"v": False}

        def deliver(res):
            if done["v"]:
                return False
            done["v"] = True
            if done.get("tid"):
                GLib.source_remove(done["tid"])
            task.step(res)
            return False

        def work():
            try:
                res = (True, self.fn())
            except Exception as e:
                res = (False, "%s" % e)
            GLib.idle_add(guarded(lambda: deliver(res)))
        threading.Thread(target=work, daemon=True).start()

        def to():
            done["tid"] = None
            return deliver((False, "timeout"))
        done["tid"] = GLib.timeout_add(int(self.timeout_s * 1000), guarded(to))


class Sleep:
    def __init__(self, ms):
        self.ms = ms

    def start(self, task):
        GLib.timeout_add(self.ms, guarded(lambda: task.step(None) and False))


class Task:
    """A generator that yields requests (Run, InThread, Sleep) and is sent their results; its return value goes to `done`."""

    def __init__(self, gen, done=None):
        self.gen = gen
        self.done = done
        self.current = None
        self.cancelled = False
        self.step(None, first=True)

    @guarded
    def step(self, val, first=False):
        if self.cancelled:
            try:
                self.gen.close()
            except Exception:
                pass
            if self.done:
                self.done(None, True)
            return False
        try:
            req = next(self.gen) if first else self.gen.send(val)
        except StopIteration as e:
            if self.done:
                self.done(e.value, False)
            return False
        except Exception as e:
            log("error", "task: %s: %s" % (type(e).__name__, e))
            if self.done:
                self.done(None, False)
            return False
        req.start(self)
        return False

    def cancel(self):
        self.cancelled = True
        if self.current is not None:
            self.current.cancel()



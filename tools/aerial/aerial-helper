@guarded
def on_nm_owner(owner):
    up = bool(owner)
    if up == NM_OWNED["v"]:
        return
    NM_OWNED["v"] = up
    if up:
        walk_nm()
    else:
        P.clear()
        P_REQ.clear()
        AP_SETS.clear()
        PROFILES.clear()
        PROFILE_RAW.clear()
        PROFILES_LOAD["listed"] = False
        PROFILES_LOAD["pending"] = set()
        mark_net()
        mark("profiles")


# The FIRST full read of the saved profiles: `profiles` lines say `complete: false` until every profile ListConnections named has
# answered GetSettings (or failed). The shell's first-run trust seeding waits for it: seeding a partial or still-empty list made the
# profiles that answered late (or a network joined on a machine with none) Public / Trusted by accident (the test bed's runs).
PROFILES_LOAD = {"listed": False, "pending": set()}


def walk_nm():
    ensure(NM_PATH, [NM_IF])
    nm_call(NM_PATH + "/Settings", NM_SETTINGS, "ListConnections", "", (), on_list_connections)


@guarded
def on_list_connections(paths):
    if not PROFILES_LOAD["listed"]:
        PROFILES_LOAD["listed"] = True
        PROFILES_LOAD["pending"] = set(str(p) for p in paths)
    for p in paths:
        fetch_profile(str(p))
    for gone in [p for p in PROFILES if p not in [str(x) for x in paths]]:
        PROFILES.pop(gone, None)
        PROFILE_RAW.pop(gone, None)
    mark("profiles")


def fetch_profile(path):
    def got(settings):
        raw = plain(settings)
        PROFILE_RAW[path] = raw
        PROFILES[path] = parse_profile(path, raw)
        PROFILES_LOAD["pending"].discard(path)
        mark("profiles")
        mark("wifi")         # the card's power saving is the active profile's setting

    def bad(e):
        log("warn", "GetSettings %s: %s" % (path, dbus_text(e)))
        PROFILES_LOAD["pending"].discard(path)
        mark("profiles")
    nm_call(path, NM_SETCONN, "GetSettings", "", (), got, bad)
    # the file name and the unsaved flag come from the object's own properties
    nm_call(path, PROPS, "GetAll", "s", (NM_SETCONN,), lambda d, path=path: set_profile_file(path, d), lambda e: None)


@guarded
def set_profile_file(path, d):
    if path in PROFILES:
        PROFILES[path]["filename"] = str(d.get("Filename", ""))
        mark("profiles")


@guarded
def on_new_connection(path):
    fetch_profile(str(path))


@guarded
def on_connection_removed(path):
    PROFILES.pop(str(path), None)
    PROFILE_RAW.pop(str(path), None)
    mark("profiles")


@guarded
def on_connection_updated(path=None):
    if path and str(path) in PROFILES or (path and str(path).startswith(NM_PATH + "/Settings/")):
        fetch_profile(str(path))


def parse_profile(path, raw):
    c = raw.get("connection", {})
    w = raw.get("802-11-wireless", {})
    sec = raw.get("802-11-wireless-security", {})
    x = raw.get("802-1x", {})
    ip4 = raw.get("ipv4", {})
    ssid = w.get("ssid")
    ssid_s = utf8(ssid) if isinstance(ssid, (bytes, bytearray)) else ""
    km = str(sec.get("key-mgmt", ""))
    if not sec and not x:
        security = "open"
    elif km == "wpa-psk":
        security = "wpa2"
    elif km == "sae":
        security = "wpa3"
    elif km == "owe":
        security = "owe"
    elif km in ("wpa-eap", "wpa-eap-suite-b-192", "ieee8021x") or x:
        security = "eap"
    elif km == "none":
        security = "wep"
    else:
        security = "open" if not sec else (km or "unknown")
    mac = str(w.get("cloned-mac-address", "") or "")
    bssid = w.get("bssid")
    eap = None
    if x:
        methods = x.get("eap") or []
        eap = {"method": str(methods[0]) if methods else "", "phase2": str(x.get("phase2-auth", "") or ""),
               "identity": str(x.get("identity", "") or ""), "anonymousIdentity": str(x.get("anonymous-identity", "") or ""),
               "caCert": cert_path(x.get("ca-cert")), "domain": str(x.get("domain-suffix-match", "") or ""),
               "systemCaCerts": bool(x.get("system-ca-certs", False))}
    mode = str(w.get("mode", "")) if w else ""
    ctype = str(c.get("type", ""))
    return {"path": path, "uuid": str(c.get("uuid", "")), "id": str(c.get("id", "")), "type": ctype, "ssid": ssid_s, "mode": mode,
            "security": security if ctype == "802-11-wireless" else "", "autoconnect": bool(c.get("autoconnect", True)),
            "priority": int(c.get("autoconnect-priority", 0) or 0), "timestamp": int(c.get("timestamp", 0) or 0),
            "hidden": bool(w.get("hidden", False)), "filename": PROFILES.get(path, {}).get("filename", ""),
            "ip4method": str(ip4.get("method", "")), "metered": METERED.get(int(c.get("metered", 0) or 0), "unknown"),
            "macPolicy": mac or "default", "band": str(w.get("band", "") or ""),
            "bssid": mac_of(":".join("%02X" % b for b in bssid)) if isinstance(bssid, (bytes, bytearray)) and len(bssid) == 6 else "",
            "ifname": str(c.get("interface-name", "") or ""), "eap": eap, "powersave": int(w.get("powersave", 0) or 0)}


def cert_path(v):
    if isinstance(v, (bytes, bytearray)):
        s = bytes(v).rstrip(b"\0").decode("utf-8", "replace")
        return s[7:] if s.startswith("file://") else s
    return ""


def profile_by_uuid(u):
    for p in PROFILES.values():
        if p["uuid"] == u:
            return p
    return None



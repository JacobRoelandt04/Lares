def feature_names(mask):
    return [n for n, b in FEATURE_BITS if mask & b]


def digest_serverlist(path):
    with open(path, "rb") as f:
        d = json.load(f)
    tier = int(d.get("MaxTier", 0) or 0)
    countries = {}
    for s in d.get("LogicalServers", []):
        if int(s.get("Tier", 0) or 0) > tier:
            continue
        cc = str(s.get("ExitCountry", "")).upper()
        if not cc:
            continue
        c = countries.setdefault(cc, {"cities": {}})
        city = str(s.get("City") or "") or "-"
        loc = s.get("Location") or {}
        ct = c["cities"].setdefault(city, {"lat": [], "lon": [], "servers": []})
        if "Lat" in loc and "Long" in loc:
            ct["lat"].append(float(loc["Lat"]))
            ct["lon"].append(float(loc["Long"]))
        ct["servers"].append({"name": str(s.get("Name", "")), "load": int(s.get("Load", 0) or 0),
                              "features": feature_names(int(s.get("Features", 0) or 0)), "status": int(s.get("Status", 0) or 0)})
    out = []

    def mean(a):
        return round(sum(a) / len(a), 3) if a else 0.0
    for cc in sorted(countries):
        cities = []
        for name in sorted(countries[cc]["cities"]):
            ct = countries[cc]["cities"][name]
            ct["servers"].sort(key=lambda x: (x["load"], x["name"]))
            cities.append({"name": name, "lat": mean(ct["lat"]), "lon": mean(ct["lon"]), "servers": ct["servers"]})
        servers = [s for c in cities for s in c["servers"]]
        feats = sorted({f for s in servers for f in s["features"]}, key=lambda n: [x[0] for x in FEATURE_BITS].index(n))
        lat = [c["lat"] for c in cities if c["lat"] or c["lon"]]
        lon = [c["lon"] for c in cities if c["lat"] or c["lon"]]
        out.append({"code": cc, "name": ISO_NAMES.get(cc, cc), "lat": mean(lat), "lon": mean(lon), "servers": len(servers),
                    "minLoad": min((s["load"] for s in servers), default=0), "features": feats, "cities": cities})
    return {"tier": tier, "countries": out}


def cache_file():
    base = os.environ.get("XDG_CACHE_HOME") or os.path.join(os.path.expanduser("~"), ".cache")
    return os.path.join(base, "lares", "aerial", "catalog.json")


def load_catalog(path):
    st = os.stat(path)
    key = {"srcMtime": int(st.st_mtime), "srcSize": int(st.st_size), "src": path}
    cf = cache_file()
    try:
        with open(cf, "r", encoding="utf-8") as f:
            c = json.load(f)
        if all(c.get(k) == v for k, v in key.items()):
            return {"path": path, "mtime": key["srcMtime"], "tier": c["tier"], "countries": c["countries"], "cached": True}
    except Exception:
        pass
    dig = digest_serverlist(path)
    try:
        os.makedirs(os.path.dirname(cf), exist_ok=True)
        tmp = cf + ".tmp%d" % os.getpid()
        with open(tmp, "w", encoding="utf-8") as f:
            json.dump(dict(key, tier=dig["tier"], countries=dig["countries"]), f, separators=(",", ":"), ensure_ascii=False)
        os.replace(tmp, cf)
    except Exception as e:
        log("warn", "catalog cache not written: %s" % e)
    return {"path": path, "mtime": key["srcMtime"], "tier": dig["tier"], "countries": dig["countries"], "cached": False}


@command
def cmd_catalog(msg, reply):
    path = str(msg.get("path", ""))
    if not path:
        path = os.path.join(os.path.expanduser("~"), ".cache", "Proton", "VPN", "serverlist.json")
    if not os.path.isfile(path):
        return reply(False, "no server list at %s" % path)
    t0 = time.time()

    def work():
        return load_catalog(path)

    def run():
        return (yield InThread(work, timeout_s=180.0))

    def done(res, cancelled):
        if not res or not res[0]:
            return reply(False, "catalog: %s" % (res[1] if res else "cancelled"))
        c = res[1]
        emit(dict(c, t="catalog", digestMs=int((time.time() - t0) * 1000)))
        reply(True, data={"countries": len(c["countries"]), "cached": c["cached"]})
    Task(run(), done)


# ---- health pads ---------------------------------------------------------------------------------------------------------------
def pad_event(pid, state, detail, ms):
    emit({"t": "pad", "id": pid, "state": state, "detail": detail, "ms": int(ms)})


def carrying_device():
    """The device that carries the traffic: an activated wifi / wired device, never a virtual one."""
    best = None
    for p in device_paths():
        d = device_dict(p)
        if d["type"] not in ("wifi", "ethernet"):
            continue
        if d["stateCode"] == 100:
            if best is None or d["type"] == "ethernet":
                best = d
    if best is None:
        wp = wifi_device_path()
        if wp:
            best = device_dict(wp)
    return best


def pad_link():
    d = carrying_device()
    if d is None:
        return "fail", "no network device"
    if d["stateCode"] == 100:
        return "ok", "%s is up" % d["iface"]
    if 40 <= d["stateCode"] < 100:
        return "warn", "%s is %s" % (d["iface"], d["state"])
    return "fail", "%s is %s (%s)" % (d["iface"], d["state"], d["stateReason"])


def pad_addr():
    d = carrying_device()
    if d is None or d["stateCode"] < 70:
        return "fail", "no address yet"
    v4 = [a for a in (d["ip4"] or {}).get("addresses", []) if not a["address"].startswith("169.254.")]
    if v4:
        return "ok", "%s/%d" % (v4[0]["address"], v4[0]["prefix"])
    v6 = [a for a in (d["ip6"] or {}).get("addresses", []) if not a["address"].lower().startswith("fe80")]
    if v6:
        return "warn", "IPv6 only: %s" % v6[0]["address"]
    return "fail", "no address"


def pad_gateway_target():
    d = carrying_device()
    return ((d["ip4"] or {}).get("gateway") or "") if d else ""


# A test is a FAIL only when it failed repeatedly: one lost ping is not a dead gateway. The tries of each pad, and the pause between two.
PAD_TRIES = {"gateway": 3, "dns": 2, "net": 2}
PAD_RETRY_MS = int(os.environ.get("AERIAL_PAD_RETRY_MS", "700"))


def pad_once(pid, url, host):
    """A generator: ONE try of a pad. Returns (state, detail); emits the portal fact for the net pad."""
    if pid == "link":
        return pad_link()
    if pid == "addr":
        return pad_addr()
    if pid == "gateway":
        gw = pad_gateway_target()
        if not gw:
            return "fail", "no gateway"
        rc, out, err, to = yield Run(["ping", "-c1", "-W1", gw], timeout_s=3.5)
        m = re.search(r"time[=<]([\d.]+)\s*ms", out or "")
        if rc == 0:
            return "ok", "%s answers%s" % (gw, " in %s ms" % m.group(1) if m else "")
        return "fail", "%s does not answer" % gw
    if pid == "dns":
        ok, val = yield InThread(lambda: socket.getaddrinfo(host, 80, proto=socket.IPPROTO_TCP)[0][4][0], timeout_s=3.0)
        return ("ok", "%s is %s" % (host, val)) if ok else ("fail", "cannot resolve %s" % host if val != "timeout" else
                                                            "no answer for %s in 3 s" % host)
    if pid == "net":
        ok, val = yield InThread(lambda: http_check(url), timeout_s=7.0)
        if not ok:
            return "fail", "no internet (%s)" % val
        kind, text, loc = val
        if kind == "online":
            emit({"t": "portal", "present": False, "url": ""})
            return "ok", "internet reachable"
        if kind == "portal":
            emit({"t": "portal", "present": True, "url": loc})
            return "warn", "a login page stands in the way"
        return "fail", text
    return "fail", "unknown pad"


def run_pads(ids, url, host):
    """A generator: the pads in order, stopping at the first fail. Returns the results. A pad stays `testing` between its tries and
    says `fail` only after the last one; a pass on a later try is a plain `ok`."""
    results = []
    for pid in ids:
        pad_event(pid, "testing", "", 0)
        t0 = time.time()
        tries = PAD_TRIES.get(pid, 1)
        for attempt in range(tries):
            if attempt:
                yield Sleep(PAD_RETRY_MS)
            state, detail = yield from pad_once(pid, url, host)
            if state != "fail":
                break
        ms = (time.time() - t0) * 1000
        pad_event(pid, state, detail, ms)
        results.append({"id": pid, "state": state, "detail": detail, "ms": int(ms)})
        if state == "fail":
            break
    return results


def http_check(url):
    """GET with NO redirect following: 200 + the NetworkManager body is online; a 3xx is a portal; else a failure."""
    import http.client
    import urllib.parse
    u = urllib.parse.urlsplit(url)
    cls = http.client.HTTPSConnection if u.scheme == "https" else http.client.HTTPConnection
    conn = cls(u.hostname, u.port, timeout=5)
    try:
        conn.request("GET", (u.path or "/") + ("?" + u.query if u.query else ""), headers={"User-Agent": "lares-aerial", "Connection": "close"})
        r = conn.getresponse()
        body = r.read(2048).decode("utf-8", "replace")
        if r.status == 200 and "NetworkManager is online" in body:
            return ("online", "", "")
        if 300 <= r.status < 400:
            return ("portal", "", r.getheader("Location", "") or "")
        return ("other", "HTTP %d" % r.status if r.status != 200 else "unexpected answer", "")
    finally:
        conn.close()



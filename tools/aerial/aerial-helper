def emit(obj):
    try:
        sys.stdout.write(json.dumps(obj, separators=(",", ":"), ensure_ascii=False) + "\n")
        sys.stdout.flush()
    except BrokenPipeError:
        os._exit(0)
    except Exception:
        pass


def log(level, text):
    emit({"t": "log", "level": level, "text": str(text)[:2000]})


def guarded(fn):
    """A turn that raises is logged and the loop goes on."""
    @functools.wraps(fn)
    def w(*a, **k):
        try:
            return fn(*a, **k)
        except Exception as e:
            tb = traceback.extract_tb(sys.exc_info()[2])[-1]
            log("error", "%s: %s: %s (line %d)" % (fn.__name__, type(e).__name__, e, tb.lineno))
            return None
    return w


def guarded_keep(fn):
    """Same, for a GLib source that must stay installed."""
    g = guarded(fn)

    @functools.wraps(fn)
    def w(*a, **k):
        r = g(*a, **k)
        return True if r is None else r
    return w



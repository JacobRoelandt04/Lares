def prop(path, iface, name, default=None):
    return P.get(path, {}).get(iface, {}).get(name, default)


def ensure(path, ifaces):
    if not path or path == "/":
        return
    for i in ifaces:
        k = (path, i)
        if k in P_REQ:
            continue
        P_REQ.add(k)

        def got(d, path=path, i=i):
            P.setdefault(path, {})[i] = {str(k): v for k, v in d.items()}
            touched(path, i)

        def bad(e, k=k):
            P_REQ.discard(k)
        get_all(path, i, got, bad)


def forget_path(path):
    P.pop(path, None)
    for k in [k for k in P_REQ if k[0] == path]:
        P_REQ.discard(k)


def kind_of(path):
    p = str(path)
    if p == NM_PATH:
        return "manager"
    for k, pre in (("device", NM_PATH + "/Devices/"), ("ap", NM_PATH + "/AccessPoint/"), ("active", NM_PATH + "/ActiveConnection/"),
                   ("ip4", NM_PATH + "/IP4Config/"), ("ip6", NM_PATH + "/IP6Config/"), ("setting", NM_PATH + "/Settings/")):
        if p.startswith(pre):
            return k
    return ""


@guarded
def touched(path, iface):
    """New or changed properties of an object: pull in what it points at, mark what depends on it."""
    k = kind_of(path)
    if k == "manager":
        for d in prop(NM_PATH, NM_IF, "Devices", []):
            ensure(str(d), [NM_DEV])
        for a in prop(NM_PATH, NM_IF, "ActiveConnections", []):
            ensure(str(a), [NM_ACTIVE])
        man = P[NM_PATH][NM_IF]
        if "Devices" in man:
            live = set(str(x) for x in man["Devices"])
            for p in [p for p in P if kind_of(p) == "device" and p not in live]:
                forget_path(p)
                AP_SETS.pop(p, None)
        if "ActiveConnections" in man:
            live = set(str(a) for a in man["ActiveConnections"])
            for p in [p for p in P if kind_of(p) == "active" and p not in live]:
                forget_path(p)
    elif k == "device":
        dev = P[path].get(NM_DEV, {})
        t = int(dev.get("DeviceType", 0) or 0)
        if t == 2:
            ensure(path, [NM_WIFI])
        elif t == 1:
            ensure(path, [NM_WIRED])
        for key in ("Ip4Config", "Ip6Config"):
            v = str(dev.get(key, "/"))
            ensure(v, [NM_IP4 if key == "Ip4Config" else NM_IP6])
        ensure(str(dev.get("ActiveConnection", "/")), [NM_ACTIVE])
    if iface == NM_WIFI and k == "device":
        w = P[path].get(NM_WIFI, {})
        if "AccessPoints" in w:
            AP_SETS[path] = set(str(a) for a in w["AccessPoints"])
            for a in AP_SETS[path]:
                ensure(a, [NM_AP])
        lastscan = w.get("LastScan")
        if lastscan is not None and SCAN["asked"] and boot_ms_to_epoch(int(lastscan)) >= SCAN["since"]:
            SCAN["asked"] = 0
    if k == "active":
        a = P[path].get(NM_ACTIVE, {})
        ensure(str(a.get("Ip4Config", "/")), [NM_IP4])
        ensure(str(a.get("Ip6Config", "/")), [NM_IP6])
    if k in ("manager", "device", "ap", "active", "ip4", "ip6"):
        mark_net()


def boot_offset_ms():
    """Wall clock less CLOCK_BOOTTIME, in whole seconds: the offset that turns NetworkManager's boot-relative times into epoch times.
    Whole seconds so that a snapshot whose facts did not change prints the same bytes (the dedupe sees it)."""
    try:
        return int(round(time.time() - time.clock_gettime(time.CLOCK_BOOTTIME))) * 1000
    except Exception:
        return 0


def boot_ms_to_epoch(boot_ms):
    if boot_ms < 0:
        return 0
    return int(boot_ms) + boot_offset_ms()


def boot_s_to_epoch_ms(s):
    return boot_ms_to_epoch(int(s) * 1000) if int(s) >= 0 else 0


@guarded
def on_properties_changed(iface, changed, invalidated, path=None):
    path = str(path or "")
    if path.startswith("/org/bluez"):
        return bz_changed(path, str(iface), changed, invalidated)
    if not path.startswith(NM_PATH):
        return
    iface = str(iface)
    ent = P.get(path, {}).get(iface)
    if ent is None:
        if path.startswith(NM_PATH + "/Devices/") and iface in (NM_STATS,):
            pass
        else:
            return
    if ent is not None:
        for k, v in changed.items():
            ent[str(k)] = v
    if iface == NM_STATS:
        stats_changed(path, {str(k): v for k, v in changed.items()})
    touched(path, iface)



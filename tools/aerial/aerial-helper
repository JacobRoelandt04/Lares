IW_STANDARD_RE = re.compile(r"(EHT|HE|VHT)-MCS|\bMCS\b")


def parse_iw_link(text):
    r = {"standard": "", "dbm": None, "rxMbps": None, "txMbps": None, "bssid": "", "ssid": "", "freq": None, "connected": False}
    m = re.match(r"Connected to ([0-9a-fA-F:]{17})", text)
    if not m:
        return r
    r["connected"] = True
    r["bssid"] = m.group(1).upper()
    for line in text.splitlines():
        line = line.strip()
        if line.startswith("SSID:"):
            r["ssid"] = line[5:].strip()
        elif line.startswith("freq:"):
            try:
                r["freq"] = int(float(line[5:].strip()))
            except Exception:
                pass
        elif line.startswith("signal:"):
            mm = re.search(r"(-?\d+)\s*dBm", line)
            if mm:
                r["dbm"] = int(mm.group(1))
        elif line.startswith("rx bitrate:") or line.startswith("tx bitrate:"):
            mm = re.search(r":\s*([\d.]+)\s*MBit/s", line)
            key = "rxMbps" if line.startswith("rx") else "txMbps"
            if mm:
                r[key] = float(mm.group(1))
            tok = IW_STANDARD_RE.search(line)
            if tok and not r["standard"]:
                g = tok.group(1)
                r["standard"] = {"EHT": "Wi-Fi 7", "HE": "Wi-Fi 6", "VHT": "Wi-Fi 5", None: "Wi-Fi 4"}.get(g)
    if r["standard"] == "Wi-Fi 6" and (r["freq"] or 0) >= 5925:
        r["standard"] = "Wi-Fi 6E"
    return r


@command
def cmd_iw_link(msg, reply):
    iface = str(msg.get("iface", ""))
    if not re.match(r"^[A-Za-z0-9_.:-]{1,15}$", iface):
        return reply(False, "bad interface name")

    def run():
        res = yield Run(["iw", "dev", iface, "link"], timeout_s=5.0)
        return res

    def done(res, cancelled):
        if res is None:
            return reply(False, "cancelled")
        rc, out, err, timedout = res
        if timedout or rc is None:
            return reply(False, "iw timed out")
        if rc != 0:
            return reply(False, (err or out).strip()[:200] or "iw failed")
        r = parse_iw_link(out)
        r["iface"] = iface
        emit(dict(r, t="link"))
        reply(True, data=r)
    Task(run(), done)


def parse_iw_reg(text):
    """`iw reg get` -> [{scope, country, selfManaged}]. A self-managed phy (iwlwifi's LAR) carries its own country; the global one says
    `00` until a country is set."""
    out, scope, selfm = [], "", False
    for line in text.splitlines():
        if not line.strip() or line[0] in " \t":
            continue
        t = line.strip()
        m = re.match(r"^(global|phy#\d+)\s*(\(self-managed\))?\s*$", t)
        if m:
            scope, selfm = m.group(1), bool(m.group(2))
            continue
        m = re.match(r"^country ([A-Z0-9]{2}):", t)
        if m and scope:
            out.append({"scope": scope, "country": m.group(1), "selfManaged": selfm})
    return out


def reg_country(phys):
    for want in (True, False):
        for p in phys:
            if p["selfManaged"] == want and p["country"] not in ("00", "99"):
                return p["country"]
    return ""


def ask_reg(reply=None):
    def run():
        res = yield Run(["iw", "reg", "get"], timeout_s=5.0)
        return res

    def done(res, cancelled):
        if res is None or res[0] != 0 or res[3]:
            if reply:
                reply(False, "iw reg get failed")
            return
        phys = parse_iw_reg(res[1])
        REG["phys"], REG["country"] = phys, reg_country(phys)
        emit({"t": "reg", "country": REG["country"], "phys": phys})
        mark("wifi")
        if reply:
            reply(True, data={"country": REG["country"], "phys": phys})
    Task(run(), done)


@command
def cmd_reg(msg, reply):
    ask_reg(reply)


def parse_iw_stations(text):
    out, cur = [], None
    for line in text.splitlines():
        m = re.match(r"^Station ([0-9a-fA-F:]{17}) \(on ", line)
        if m:
            cur = {"mac": m.group(1).upper(), "dbm": None, "connectedS": 0}
            out.append(cur)
            continue
        if cur is None:
            continue
        t = line.strip()
        m = re.match(r"^signal:\s*(-?\d+)", t)
        if m:
            cur["dbm"] = int(m.group(1))
        m = re.match(r"^connected time:\s*(\d+)", t)
        if m:
            cur["connectedS"] = int(m.group(1))
    return out


def read_leases(iface):
    """dnsmasq's lease file for the hotspot (`<expiry> <mac> <ip> <name|*> <client id|*>`), if readable: mac -> {ip, name}."""
    out = {}
    try:
        with open(os.path.join(LEASE_DIR, "dnsmasq-%s.leases" % iface), "r", encoding="utf-8", errors="replace") as f:
            for line in f.read().splitlines():
                w = line.split()
                if len(w) >= 4 and re.match(r"^[0-9a-fA-F:]{17}$", w[1]):
                    out[w[1].upper()] = {"ip": w[2], "name": "" if w[3] == "*" else w[3]}
    except Exception:
        pass
    return out


@command
def cmd_stations(msg, reply):
    iface = str(msg.get("iface", ""))
    if not re.match(r"^[A-Za-z0-9_.:-]{1,15}$", iface):
        return reply(False, "bad interface name")

    def run():
        res = yield Run(["iw", "dev", iface, "station", "dump"], timeout_s=5.0)
        return res

    def done(res, cancelled):
        if res is None:
            return reply(False, "cancelled")
        rc, out, err, timedout = res
        if timedout or rc is None:
            return reply(False, "iw timed out")
        if rc != 0:
            return reply(False, (err or out).strip()[:200] or "iw failed")
        leases = read_leases(iface)
        v = []
        for st in parse_iw_stations(out):
            l = leases.get(st["mac"], {})
            v.append({"mac": st["mac"], "dbm": st["dbm"], "connectedS": st["connectedS"], "ip": l.get("ip", ""), "name": l.get("name", "")})
        emit({"t": "stations", "iface": iface, "v": v})
        reply(True, data={"iface": iface, "v": v})
    Task(run(), done)


# ---- BlueZ: a read-only snapshot (adapter + devices) ---------------------------------------------------------------------------
BZ = {}                  # object path -> {interface: props}  (Adapter1 and Device1 only)
BZ_OWNED = {"v": False}
BZ_POLL = {"tid": 0}


def rfkill_hard():
    """Is a Bluetooth radio HARD blocked (a switch, the firmware)? sysfs, no fork, no root; BlueZ says `off-blocked` for either kind."""
    try:
        for d in sorted(os.listdir(RFKILL_DIR)):
            base = os.path.join(RFKILL_DIR, d)
            with open(os.path.join(base, "type")) as f:
                if f.read().strip() != "bluetooth":
                    continue
            with open(os.path.join(base, "hard")) as f:
                if f.read().strip() == "1":
                    return True
    except Exception:
        pass
    return False


def build_bt():
    adapters = sorted(p for p, e in BZ.items() if BZ_ADAPTER in e)
    if not BZ_OWNED["v"] or not adapters:
        return {"present": False, "address": "", "name": "", "powered": False, "powerState": "", "softBlocked": False,
                "hardBlocked": False, "discovering": False, "discoverable": False, "devices": []}
    ap = adapters[0]
    a = BZ[ap][BZ_ADAPTER]
    ps = str(a.get("PowerState", "") or "")
    blocked = ps == "off-blocked"
    hard = rfkill_hard() if blocked else False
    devs = []
    for p in sorted(BZ):
        d = BZ[p].get(BZ_DEVICE)
        if d is None or not p.startswith(ap + "/"):
            continue
        devs.append({"address": mac_of(d.get("Address", "")), "name": str(d.get("Alias") or d.get("Name") or ""),
                     "paired": bool(d.get("Paired", False)), "connected": bool(d.get("Connected", False)),
                     "rssi": int(d["RSSI"]) if "RSSI" in d else None})
    bz_hard_watch(blocked)
    return {"present": True, "address": mac_of(a.get("Address", "")), "name": str(a.get("Alias") or a.get("Name") or ""),
            "powered": bool(a.get("Powered", False)), "powerState": ps, "softBlocked": blocked and not hard, "hardBlocked": hard,
            "discovering": bool(a.get("Discovering", False)), "discoverable": bool(a.get("Discoverable", False)), "devices": devs}


def bz_hard_watch(blocked):
    """A switch flipped under a blocked radio sends BlueZ nothing, so while (and only while) it is `off-blocked` the rfkill files are
    looked at again every few seconds."""
    if blocked and not BZ_POLL["tid"]:
        def look():
            if not [1 for e in BZ.values() if e.get(BZ_ADAPTER, {}).get("PowerState") == "off-blocked"]:
                BZ_POLL["tid"] = 0
                return False
            mark("bt")
            return True
        BZ_POLL["tid"] = GLib.timeout_add(int(os.environ.get("AERIAL_RFKILL_POLL_MS", "3000")), guarded_keep(look))
    elif not blocked and BZ_POLL["tid"]:
        GLib.source_remove(BZ_POLL["tid"])
        BZ_POLL["tid"] = 0


@guarded
def bz_take(objs):
    BZ.clear()
    for path, ifaces in objs.items():
        for i, props in ifaces.items():
            if str(i) in (BZ_ADAPTER, BZ_DEVICE):
                BZ.setdefault(str(path), {})[str(i)] = {str(k): v for k, v in props.items()}
    mark("bt")


def bz_walk():
    call(BLUEZ_NAME, "/", OBJMAN, "GetManagedObjects", "", (), bz_take, lambda e: (BZ.clear(), mark("bt")), timeout=10.0)


@guarded
def on_bz_owner(owner):
    up = bool(owner)
    if up == BZ_OWNED["v"]:
        return
    BZ_OWNED["v"] = up
    if up:
        bz_walk()
    else:
        BZ.clear()
        mark("bt")


@guarded
def bz_changed(path, iface, changed, invalidated):
    ent = BZ.get(path, {}).get(iface)
    if ent is None:
        return
    for k, v in changed.items():
        ent[str(k)] = v
    for k in invalidated or []:
        ent.pop(str(k), None)
    mark("bt")


@guarded
def on_bz_added(path, ifaces):
    for i, props in ifaces.items():
        if str(i) in (BZ_ADAPTER, BZ_DEVICE):
            BZ.setdefault(str(path), {})[str(i)] = {str(k): v for k, v in props.items()}
    mark("bt")


@guarded
def on_bz_removed(path, ifaces):
    ent = BZ.get(str(path))
    if ent is not None:
        for i in ifaces:
            ent.pop(str(i), None)
        if not ent:
            BZ.pop(str(path), None)
    mark("bt")


@command
def cmd_bt(msg, reply):
    bz_walk()
    reply(True)


# ---- BlueZ agent ---------------------------------------------------------------------------------------------------------------
class Rejected(dbus.DBusException):
    _dbus_error_name = "org.bluez.Error.Rejected"


class Canceled(dbus.DBusException):
    _dbus_error_name = "org.bluez.Error.Canceled"


AGENT_TIMEOUT_MS = int(os.environ.get("AERIAL_AGENT_TIMEOUT_MS", "60000"))   # a question nobody answers is rejected (60 s)
AGENT = {"obj": None, "registered": False, "rid": 0, "pending": {}}


def device_addr(path):
    m = re.search(r"dev_([0-9A-Fa-f_]{17})$", str(path))
    return m.group(1).replace("_", ":").upper() if m else str(path)


class Agent(dbus.service.Object):
    def _ask(self, kind, device, code, reply_cb, error_cb, answer):
        AGENT["rid"] += 1
        rid = AGENT["rid"]

        def timeout():
            p = AGENT["pending"].pop(rid, None)
            if p:
                emit({"t": "agent", "rid": rid, "kind": "cancel", "device": device_addr(device), "code": ""})
                error_cb(Rejected("no answer in 60 s"))
            return False
        tid = GLib.timeout_add(AGENT_TIMEOUT_MS, guarded(timeout))
        AGENT["pending"][rid] = {"reply": reply_cb, "error": error_cb, "answer": answer, "tid": tid, "device": str(device)}
        emit({"t": "agent", "rid": rid, "kind": kind, "device": device_addr(device), "code": code})

    @dbus.service.method(BLUEZ_AGENT_IF, in_signature="", out_signature="")
    def Release(self):
        for rid in list(AGENT["pending"]):
            agent_drop(rid, "cancel")
        AGENT["registered"] = False
        log("info", "bluez released the agent")

    @dbus.service.method(BLUEZ_AGENT_IF, in_signature="o", out_signature="s", async_callbacks=("reply_cb", "error_cb"))
    @guarded
    def RequestPinCode(self, device, reply_cb, error_cb):
        self._ask("pin", device, "", reply_cb, error_cb, lambda v: str(v or ""))

    @dbus.service.method(BLUEZ_AGENT_IF, in_signature="os", out_signature="")
    @guarded
    def DisplayPinCode(self, device, pincode):
        AGENT["rid"] += 1
        emit({"t": "agent", "rid": AGENT["rid"], "kind": "display", "device": device_addr(device), "code": str(pincode)})

    @dbus.service.method(BLUEZ_AGENT_IF, in_signature="o", out_signature="u", async_callbacks=("reply_cb", "error_cb"))
    @guarded
    def RequestPasskey(self, device, reply_cb, error_cb):
        self._ask("passkey", device, "", reply_cb, error_cb, lambda v: dbus.UInt32(int(v)))

    @dbus.service.method(BLUEZ_AGENT_IF, in_signature="ouq", out_signature="")
    @guarded
    def DisplayPasskey(self, device, passkey, entered):
        AGENT["rid"] += 1
        emit({"t": "agent", "rid": AGENT["rid"], "kind": "display", "device": device_addr(device), "code": "%06d" % int(passkey)})

    @dbus.service.method(BLUEZ_AGENT_IF, in_signature="ou", out_signature="", async_callbacks=("reply_cb", "error_cb"))
    @guarded
    def RequestConfirmation(self, device, passkey, reply_cb, error_cb):
        self._ask("confirm", device, "%06d" % int(passkey), reply_cb, error_cb, lambda v: None)

    @dbus.service.method(BLUEZ_AGENT_IF, in_signature="o", out_signature="", async_callbacks=("reply_cb", "error_cb"))
    @guarded
    def RequestAuthorization(self, device, reply_cb, error_cb):
        self._ask("authorize", device, "", reply_cb, error_cb, lambda v: None)

    @dbus.service.method(BLUEZ_AGENT_IF, in_signature="os", out_signature="", async_callbacks=("reply_cb", "error_cb"))
    @guarded
    def AuthorizeService(self, device, uuid, reply_cb, error_cb):
        self._ask("authorize", device, str(uuid), reply_cb, error_cb, lambda v: None)

    @dbus.service.method(BLUEZ_AGENT_IF, in_signature="", out_signature="")
    @guarded
    def Cancel(self):
        for rid in list(AGENT["pending"]):
            agent_drop(rid, "cancel")


def agent_drop(rid, why):
    p = AGENT["pending"].pop(rid, None)
    if not p:
        return
    GLib.source_remove(p["tid"])
    emit({"t": "agent", "rid": rid, "kind": why, "device": device_addr(p["device"]), "code": ""})
    p["error"](Canceled("cancelled"))


@command
def cmd_agent(msg, reply):
    on = bool(msg.get("on"))
    if on == AGENT["registered"]:
        return reply(True, data={"already": True})
    if on:
        if AGENT["obj"] is None:
            AGENT["obj"] = Agent(BUS, AGENT_PATH)

        def step2():
            call(BLUEZ_NAME, "/org/bluez", "org.bluez.AgentManager1", "RequestDefaultAgent", "o", (dbus.ObjectPath(AGENT_PATH),),
                 lambda: (AGENT.update(registered=True), reply(True)), nm_err(reply))
        call(BLUEZ_NAME, "/org/bluez", "org.bluez.AgentManager1", "RegisterAgent", "os",
             (dbus.ObjectPath(AGENT_PATH), "KeyboardDisplay"), step2, nm_err(reply))
    else:
        for rid in list(AGENT["pending"]):
            agent_drop(rid, "cancel")

        def gone(*_):
            AGENT["registered"] = False
            reply(True)
        call(BLUEZ_NAME, "/org/bluez", "org.bluez.AgentManager1", "UnregisterAgent", "o", (dbus.ObjectPath(AGENT_PATH),), gone,
             lambda e: (AGENT.update(registered=False), reply(True, data={"note": dbus_text(e)})))


@command
def cmd_agent_reply(msg, reply):
    rid = int(msg.get("rid", 0))
    p = AGENT["pending"].pop(rid, None)
    if p is None:
        return reply(False, "no such question (answered, cancelled or timed out)")
    GLib.source_remove(p["tid"])
    if not msg.get("accept"):
        p["error"](Rejected("rejected by the user"))
        return reply(True)
    try:
        val = p["answer"](msg.get("value"))
    except Exception as e:
        p["error"](Rejected("bad answer"))
        return reply(False, "bad answer: %s" % e)
    if val is None:
        p["reply"]()
    else:
        p["reply"](val)
    reply(True)


# ---- the keyring ---------------------------------------------------------------------------------------------------------------
# Proton's CLI keeps its sign-in in the login keyring and opens it on EVERY command, `status` too; while the keyring is locked the Secret
# Service then raises its password window. The shell starts under the boot lock, a second or more before the password there opens the
# keyring (SDDM's autologin gave it none), and an open window does not go when the keyring is opened by PAM: it stood on the desktop after
# every boot (2026-11-22). So the commands the shell runs BY ITSELF wait for an open keyring; one the user clicked may ask.
# gnome-keyring signals NOTHING when PAM opens it (measured, 51.1; a Lock over D-Bus does signal), so a wait looks again by itself.
SECRETS_NAME = "org.freedesktop.secrets"
SECRETS_PATH = "/org/freedesktop/secrets/aliases/default"
SECRETS_COLL = "org.freedesktop.Secret.Collection"
KEYRING = {"bus": None, "waiting": False}
KEYRING_POLL_MS = int(os.environ.get("AERIAL_KEYRING_POLL_MS", "2000"))
KEYRING_LOCKED = "The keyring is locked"


def keyring_connect():
    """The session bus, for the one question below (the module's own bus is the system's). None: no session bus, nothing to ask."""
    addr = os.environ.get("DBUS_SESSION_BUS_ADDRESS", "")
    try:
        KEYRING["bus"] = dbus.bus.BusConnection(addr) if addr else None
    except Exception as e:
        log("warn", "no session bus: %s" % e)


def keyring_locked(cb):
    """cb(True) while the default collection is locked (or the service does not answer in time), else cb(False): open, or no Secret
    Service at all. A read: it never starts the service and never prompts."""
    if KEYRING["bus"] is None:
        return cb(False)

    def answer(m):
        if isinstance(m, dbus.lowlevel.MethodReturnMessage):
            v = m.get_args_list()
            return cb(bool(v and v[0]))
        name = m.get_error_name() if isinstance(m, dbus.lowlevel.ErrorMessage) else ""
        cb(str(name).endswith((".NoReply", ".Timeout", ".TimedOut")))
    try:
        q = dbus.lowlevel.MethodCallMessage(SECRETS_NAME, SECRETS_PATH, PROPS, "Get")
        q.set_auto_start(False)
        q.append(SECRETS_COLL, "Locked", signature="ss")
        KEYRING["bus"].send_message_with_reply(q, guarded(answer), 3.0)
    except Exception as e:
        log("warn", "the keyring could not be asked: %s" % e)
        cb(False)


def keyring_wait():
    """A read was refused: say so once, look again until the keyring is open, and say that."""
    if KEYRING["waiting"]:
        return
    KEYRING["waiting"] = True
    emit({"t": "keyring", "locked": True})

    def seen(locked):
        if locked:
            GLib.timeout_add(KEYRING_POLL_MS, guarded(look))
            return
        KEYRING["waiting"] = False
        emit({"t": "keyring", "locked": False})

    def look():
        keyring_locked(seen)
        return False
    GLib.timeout_add(KEYRING_POLL_MS, guarded(look))


# ---- ProtonVPN -----------------------------------------------------------------------------------------------------------------
PROTON = {"queue": [], "busy": False}
PROTON_READS = ("status", "config")        # what the shell asks by itself: never while the keyring is locked
SAFE_ARG = re.compile(r"^[A-Za-z0-9][A-Za-z0-9 #._,'()/-]{0,63}$")
PROTON_KEYS = ("netshield", "kill-switch", "port-forwarding", "custom-dns", "vpn-accelerator", "moderate-nat", "ipv6",
               "anonymous-crash-reports")


def parse_proton_status(text):
    kv = {}
    for line in text.splitlines():
        m = re.match(r"^\s*([A-Za-z ]+?):\s*(.*?)\s*$", line)
        if m:
            kv[m.group(1).strip().lower()] = m.group(2)
    state = {"connected": "connected", "disconnected": "disconnected"}.get(kv.get("status", "").lower(), "unknown")
    return {"state": state, "server": parse_proton_server(kv.get("server", "")), "load": parse_load(kv.get("load", "")),
            "protocol": kv.get("protocol", "")}


def parse_load(s):
    m = re.match(r"^(\d+)\s*%", s or "")
    return int(m.group(1)) if m else None


def parse_proton_server(s):
    s = (s or "").strip().rstrip(".").strip()
    if not s:
        return None
    m = re.match(r"^(\S+) in (.+?)(?:, via (.+))?$", s)
    if not m:
        return {"name": s, "city": "", "country": "", "via": ""}
    city, rest = m.group(2), ""
    country = ""
    if "," in city and not m.group(3):
        city, country = [x.strip() for x in city.rsplit(",", 1)]
    return {"name": m.group(1), "city": city, "country": country, "via": m.group(3) or ""}


def parse_proton_config(text):
    out = {}
    seen_rule = False
    for line in text.splitlines():
        if re.match(r"^-{3,}\s+-{3,}", line):
            seen_rule = True
            continue
        if not seen_rule:
            continue
        if not line.strip():
            if out:
                break
            continue
        parts = re.split(r"\s{2,}", line.strip(), maxsplit=1)
        if len(parts) == 2:
            out[parts[0]] = parts[1].strip()
    return out


def proton_argv(action, args):
    argv, to = _proton_argv(action, args)
    if args.get("timeoutS"):
        to = max(1, min(120, float(args["timeoutS"])))
    return argv, to


def _proton_argv(action, args):
    if action == "status":
        return ["protonvpn", "status"], 15
    if action == "config":
        return ["protonvpn", "config", "list"], 15
    if action == "disconnect":
        return ["protonvpn", "disconnect"], 20
    if action == "set":
        k, v = str(args.get("key", "")), str(args.get("value", ""))
        if k not in PROTON_KEYS or not SAFE_ARG.match(v):
            raise ValueError("bad setting")
        return ["protonvpn", "config", "set", k, v], 15
    if action == "connect":
        argv = ["protonvpn", "connect"]
        for key, flag in (("country", "--country"), ("city", "--city")):
            if args.get(key):
                v = str(args[key])
                if not SAFE_ARG.match(v):
                    raise ValueError("bad %s" % key)
                argv += [flag, v]
        for key, flag in (("securecore", "--securecore"), ("p2p", "--p2p"), ("tor", "--tor"), ("random", "--random")):
            if args.get(key):
                argv.append(flag)
        if args.get("server"):
            v = str(args["server"])
            if not SAFE_ARG.match(v):
                raise ValueError("bad server")
            argv.append(v)
        return argv, 60
    raise ValueError("unknown action")


@command
def cmd_proton(msg, reply):
    action = str(msg.get("action", ""))
    args = msg.get("args") or {}
    try:
        argv, to = proton_argv(action, args)
    except ValueError as e:
        return reply(False, str(e))
    PROTON["queue"].append((action, argv, to, reply))
    proton_next()


def proton_next():
    if PROTON["busy"] or not PROTON["queue"]:
        return
    action, argv, to, reply = PROTON["queue"].pop(0)
    PROTON["busy"] = True

    def run():
        return (yield Run(argv, timeout_s=to))

    def done(res, cancelled):
        PROTON["busy"] = False
        guarded(proton_finish)(action, res, reply)
        GLib.idle_add(lambda: (proton_next(), False)[1])

    def go(locked):
        if not locked:
            return Task(run(), done)
        PROTON["busy"] = False
        keyring_wait()
        reply(False, KEYRING_LOCKED)
        GLib.idle_add(lambda: (proton_next(), False)[1])
    if action in PROTON_READS:
        keyring_locked(go)
    else:
        go(False)


def proton_finish(action, res, reply):
    if res is None:
        return reply(False, "cancelled")
    rc, out, err, timedout = res
    if timedout:
        return reply(False, "protonvpn timed out")
    if rc == 127:
        return reply(False, "protonvpn is not installed (%s)" % err.strip()[:100])
    # The CLI's exit status is NOT a fact: `disconnect` exits 1 when it worked (S0). The words are.
    if action == "status":
        st = parse_proton_status(out)
        ok = "status:" in out.lower()
        emit(dict(st, t="proton", raw=out))
        return reply(ok, None if ok else (err or out).strip()[:200] or "no status", data=st)
    if action == "config":
        cfg = parse_proton_config(out)
        ok = bool(cfg)
        emit(dict(cfg, t="proton_config"))
        return reply(ok, None if ok else (err or out).strip()[:200] or "no config", data=cfg)
    if action == "disconnect":
        ok = bool(re.search(r"\bDisconnected\b", out))
        if ok:
            emit({"t": "proton", "state": "disconnected", "server": None, "load": None, "protocol": "", "raw": out})
        return reply(ok, None if ok else (err or out).strip()[:200] or "disconnect failed")
    if action == "connect":
        m = re.search(r"Connected to (.+?)\.?\s*$", out, re.M)
        ok = bool(m)
        if ok:
            emit({"t": "proton", "state": "connected", "server": parse_proton_server(m.group(1)), "load": None, "protocol": "",
                  "raw": out})
        return reply(ok, None if ok else (out + "\n" + err).strip()[-300:] or "connect failed",
                     data={"server": parse_proton_server(m.group(1))} if ok else None)
    ok = rc == 0 and ("has been set" in out or not err.strip() or True)
    return reply(rc == 0, None if rc == 0 else (err or out).strip()[:200] or "failed", data={"text": out.strip()})



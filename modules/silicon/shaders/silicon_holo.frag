    vein *= smoothstep(0.5, 1.3, abs(o));
    vein *= step(-0.5, kk) * step(kk, 5.5);
    float ph = fract(sap + hash11(kk * 1.7) * 0.8);
    float pulse = exp(-pow((abs(o) - ph * (w + 3.0)) / 1.7, 2.0));
    vein *= 0.72 + 0.95 * pulse;
    // the midrib and the stem
    float mw = mix(0.50, 0.24, smoothstep(-19.0, 14.0, s));
    float dm = max(abs(o) - mw, max(s - 16.5, -25.0 - s));
    float rib = fillCov(dm);
    float sapS = fract(sap) * 46.0 - 26.0;
    rib *= 0.78 + 0.5 * exp(-pow((s - sapS) / 3.0, 2.0));
    float fill = 0.55 + 0.45 * (1.0 - clamp(abs(o) / max(w, 0.3), 0.0, 1.0));
    return Sig(d, vein * 0.95, rib, fill, 0.0);
}

// A horizontal circle in the plane's own millimetres: the iso camera foreshortens it to 0.577 of its width on the screen, and the plane's up axis is stretched 1 / 0.8165
// on the screen, so 0.577 / 0.8165 of its width up the plane's v axis.
const float ISO_V = 0.70710678;
// the distance (first order: (k - 1) / |grad k|, exact on the axes) to the ellipse of semi axes `e` about the origin; < 0 inside
float sdEllipse(vec2 p, vec2 e) {
    float k = max(length(p / e), 1e-4);
    return (k - 1.0) * k / max(length(p / (e * e)), 1e-4);
}
// the silhouette of a drum standing on a horizontal circle of radius `r`, its bottom ellipse centred at height `yb` and `h` tall: the ellipse swept up a vertical segment
// (the distance to the segment's nearest point, then to the ellipse about it)
float sdDrum(vec2 p, float yb, float r, float h) {
    return sdEllipse(p - vec2(0.0, clamp(p.y, yb, yb + h)), vec2(r, ISO_V * r));
}

// ---- SCALES -----------------------------------------------------------------------------------
// A balance: foot, post, a beam that sways about its pivot, chains and two pans that hang from the
// beam's ends and swing a little behind it.
Sig symScales(vec2 p, float sway, float lag) {
    p.y += 0.6;
    const vec2 PIV = vec2(0.0, 12.5);
    const float ARM = 13.0;
    float ca = cos(sway), sa = sin(sway);
    vec2 e1 = PIV + ARM * vec2(-ca, -sa);
    vec2 e2 = PIV + ARM * vec2(ca, sa);
    float b1 = -0.55 * sway + 0.07 * sin(lag);
    float b2 = -0.55 * sway + 0.07 * sin(lag + 1.7);
    const float HANG = 14.0;
    vec2 c1 = e1 + HANG * vec2(sin(b1), -cos(b1));
    vec2 c2 = e2 + HANG * vec2(sin(b2), -cos(b2));
    float d = 1e3;
    // foot and post. With the plinth (fxPlinth) the foot is two round drums standing on the dial's centre, drawn as the iso camera sees a horizontal circle (below),
    // not two frontal slabs: base and dial then share one perspective
    bool plinth = fxOn.y > 0.5;
    float dCollar = 1e3;
    if (plinth) {
        d = min(d, sdDrum(p, -17.4, 6.4, 1.5));
        dCollar = sdDrum(p, -15.9, 3.4, 1.5);
        d = min(d, dCollar);
    } else {
        d = min(d, sdBox2(p - vec2(0.0, -17.8), vec2(8.0, 0.9)) - 0.3);
        d = min(d, sdBox2(p - vec2(0.0, -15.4), vec2(4.2, 1.2)) - 0.3);
    }
    d = min(d, sdBox2(p - vec2(0.0, -2.4), vec2(0.65, 12.4)));
    // beam
    float dBeam = sdSeg(p, e1, e2);
    d = min(d, dBeam - 0.55);
    d = min(d, length(p - e1) - 1.25);
    d = min(d, length(p - e2) - 1.25);
    // pans: the lower half of an ellipse under a rim bar, hanging in their own frames
    vec2 q1 = rot(p - c1, -b1);
    vec2 q2 = rot(p - c2, -b2);
    float bowl1 = max((length(q1 * vec2(1.0, 1.4)) - 6.3) / 1.25, q1.y);
    float bowl2 = max((length(q2 * vec2(1.0, 1.4)) - 6.3) / 1.25, q2.y);
    float rim1 = sdBox2(q1, vec2(7.0, 0.38));
    float rim2 = sdBox2(q2, vec2(7.0, 0.38));
    d = min(d, min(min(bowl1, rim1), min(bowl2, rim2)));
    // chains: two to each pan's rim ends
    vec2 r1a = c1 + rot(vec2(-6.6, 0.0), b1);
    vec2 r1b = c1 + rot(vec2(6.6, 0.0), b1);
    vec2 r2a = c2 + rot(vec2(-6.6, 0.0), b2);
    vec2 r2b = c2 + rot(vec2(6.6, 0.0), b2);
    float dch = min(min(sdSeg(p, e1, r1a), sdSeg(p, e1, r1b)), min(sdSeg(p, e2, r2a), sdSeg(p, e2, r2b)));
    float chains = strokeCov(dch, 0.17);
    // the pivot: a ring and a finial above it
    float ring = strokeCov(abs(length(p - PIV) - 2.0), 0.20);
    float fin = fillCov(length(p - vec2(0.0, 16.6)) - 0.95);
    float fin2 = strokeCov(abs(sdSeg(p, vec2(0.0, 14.5), vec2(0.0, 16.0))), 0.18);
    // the bright strokes: the beam's centre line and the post's
    float coreBeam = strokeCov(dBeam, 0.17);
    float corePost = strokeCov(abs(p.x), 0.17) * step(-14.0, p.y) * step(p.y, 10.5);
    float core = max(coreBeam, corePost);
    float fill = 0.55 + 0.45 * fillCov(min(bowl1, bowl2));
    float spark = 0.0;
    float ink = max(chains, max(ring, fin2)) * 0.85;
    if (plinth) {
        // A HORIZONTAL BASE. A round plinth lying flat under the foot, seen as the board's iso camera sees a horizontal circle:
        // the screen ellipse is 0.577 as tall as wide (the lens rings of the board and of every hologram's foot are the same ellipse), and the plane's own up axis is
        // stretched 1 / 0.8165 on the screen, so in the plane's millimetres it is 0.7071 as tall -- ISO_V below. A rim, an inner ring and a dial of 36 ticks that turns once in
        // 25 s (phD.z); a small bead keeps the time on the rim, once in 8 s. Its far half is fainter than the near one. Drawn in `ink` and `spark` only (not the chromatic ghosts'
        // outline). The drums' own rims are the front arcs of their top faces.
        const float PR = 11.5;
        vec2 P = vec2(p.x / PR, (p.y + 17.4) / (ISO_V * PR));
        float r = max(length(P), 1e-3);
        float kk = max(length(vec2(P.x, P.y / ISO_V)) / (PR * r), 1e-3);        // |grad r| in mm: the distance to the rim is (r - 1) / kk
        float near = 0.45 + 0.55 * (1.0 - smoothstep(-0.15, 0.15, P.y));
        float dr = (r - 1.0) / kk;
        float pl = strokeCov(abs(dr), 0.17) * 0.9;
        pl = max(pl, strokeCov(abs((r - 0.70) / kk), 0.12) * 0.5);
        float tk = fract(atan(P.y, P.x) * (36.0 / TAU) - 36.0 * phD.z);
        float band = smoothstep(0.80, 0.84, r) * (1.0 - smoothstep(0.93, 0.97, r));
        pl = max(pl, band * (1.0 - smoothstep(0.10, 0.20, abs(tk - 0.5))) * 0.8);
        pl = max(pl, fillCov(dr) * 0.14);
        ink = max(ink, pl * near * (1.0 + 0.5 * gDark));
        float rim1 = strokeCov(abs(sdEllipse(p - vec2(0.0, -15.9), vec2(6.4, ISO_V * 6.4))), 0.15) * step(p.y, -15.9);       // the front arc of the big drum's top face
        float rim2 = strokeCov(abs(sdEllipse(p - vec2(0.0, -14.4), vec2(3.4, ISO_V * 3.4))), 0.15) * step(p.y, -14.4);       // and of the collar's
        float out2 = strokeCov(abs(dCollar), 0.17);                         // the collar's own outline (it stands inside the big drum's: not part of the union's)
        ink = max(ink, max(max(rim1, rim2), out2) * 0.85);
        float ba = TAU * 3.0 * phD.z;
        vec2 bp = vec2(cos(ba) * PR, -17.4 + sin(ba) * ISO_V * PR);
        spark = fillCov(length(p - bp) - 0.5) * (0.55 + 0.45 * (1.0 - smoothstep(-0.6, 0.0, sin(ba))));
    }
    return Sig(d, ink, max(core, fin) * 0.8, fill, spark);
}

// ---- SHOCK ------------------------------------------------------------------------------------
// A lightning bolt with an inner outline, light running down it, thin jagged arcs that wander
// around it and a few sparks that orbit.
void polySeg(vec2 p, vec2 a, vec2 b, inout float d, inout float sg) {
    vec2 e = b - a;
    vec2 w = p - a;
    vec2 q = w - e * clamp(dot(w, e) / dot(e, e), 0.0, 1.0);
    d = min(d, dot(q, q));
    bvec3 c = bvec3(p.y >= a.y, p.y < b.y, e.x * w.y > e.y * w.x);
    if (all(c) || all(not(c)))
        sg = -sg;
}
float sdBolt(vec2 p) {
    const vec2 V0 = vec2(2.5, 19.0);
    const vec2 V1 = vec2(-10.5, -1.0);
    const vec2 V2 = vec2(-1.0, -1.0);
    const vec2 V3 = vec2(-4.0, -19.0);
    const vec2 V4 = vec2(11.0, 4.5);
    const vec2 V5 = vec2(1.5, 4.5);
    float d = dot(p - V0, p - V0);
    float sg = 1.0;
    polySeg(p, V0, V5, d, sg);
    polySeg(p, V1, V0, d, sg);
    polySeg(p, V2, V1, d, sg);
    polySeg(p, V3, V2, d, sg);
    polySeg(p, V4, V3, d, sg);
    polySeg(p, V5, V4, d, sg);
    return sg * sqrt(d);
}

// a zigzag arc from a to b: five straight pieces whose joints wander (smoothly: nothing jumps)
float nodeOff(float k, float amp, float seed, float ph) {
    if (k < 0.5 || k > 4.5)
        return 0.0;
    // a sum of two harmonics of the phase: periodic in ph, so nothing jumps when it wraps
    return amp * (0.62 * sin(TAU * (ph + hash11(k + seed))) + 0.38 * sin(TAU * (2.0 * ph + hash11(k * 3.1 + seed))));
}
float arcStroke(vec2 p, vec2 a, vec2 b, float amp, float seed, float ph, float hw) {
    vec2 ab = b - a;
    float L = length(ab);
    vec2 dir = ab / L;
    vec2 nrm = vec2(-dir.y, dir.x);
    vec2 w = p - a;
    float along = dot(w, dir);
    float t = clamp(along / L, 0.0, 0.9999);
    float k = floor(t * 5.0);
    float u = t * 5.0 - k;
    float o0 = nodeOff(k, amp, seed, ph);
    float o1 = nodeOff(k + 1.0, amp, seed, ph);
    float line = mix(o0, o1, u);
    float slope = (o1 - o0) / (L / 5.0);
    float off = (dot(w, nrm) - line) * inversesqrt(1.0 + slope * slope);
    float ovr = max(max(-along, along - L), 0.0);
    float dist = length(vec2(off, ovr));
    return strokeCov(dist, hw);
}

Sig symShock(vec2 p, float bob, float pulse, float crackle, float orbit) {
    p.y -= bob;
    float d = sdBolt(p) - 0.7;
    // the inner outline, and the light running down the body
    float inner = strokeCov(abs(d + 1.7), 0.17);
    float run = exp(-pow((p.y - (19.0 - fract(pulse) * 40.0)) / 3.6, 2.0));
    float fill = (0.65 + 0.55 * run) * smoothstep(0.0, -3.5, d) + 0.35;
    // arcs: leave the bolt's corners and the tip, wander, thin
    float ph = crackle;
    float en = targetP.w;                                    // the load: more arcs, wilder, brighter
    float wild = 0.80 + 0.70 * en;
    float a0 = arcStroke(p, vec2(-9.5, -1.0), vec2(-19.0, 8.0), 2.0 * wild, 1.3, ph, 0.20);
    float a1 = arcStroke(p, vec2(10.5, 4.5), vec2(19.5, -4.0), 2.0 * wild, 5.1, ph, 0.20);
    float a2 = arcStroke(p, vec2(-4.0, -18.5), vec2(-14.0, -19.0), 1.6 * wild, 9.7, ph, 0.18);
    float a3 = arcStroke(p, vec2(2.5, 18.5), vec2(11.0, 22.0), 1.6 * wild, 3.3, ph, 0.18);
    float a4 = arcStroke(p, vec2(-1.0, -1.0), vec2(6.0, -9.0), 1.4 * wild, 7.7, ph, 0.16);
    float a5 = arcStroke(p, vec2(9.0, 4.5), vec2(13.5, 14.0), 1.4 * wild, 11.9, ph, 0.16);
    float a6 = arcStroke(p, vec2(-4.5, -12.0), vec2(-15.0, -10.5), 1.4 * wild, 13.3, ph, 0.16);
    // each arc breathes in and out at its own slow pace (below 3 Hz)
    float l0 = 0.30 + 0.70 * (0.5 + 0.5 * sin(TAU * (crackle) + 0.0));
    float l1 = 0.30 + 0.70 * (0.5 + 0.5 * sin(TAU * (crackle) + 2.1));
    float l2 = 0.30 + 0.70 * (0.5 + 0.5 * sin(TAU * (crackle) + 4.2));
    float l3 = 0.30 + 0.70 * (0.5 + 0.5 * sin(TAU * (crackle) + 1.0));
    float l4 = 0.30 + 0.70 * (0.5 + 0.5 * sin(TAU * (crackle) + 3.1));
    float l5 = 0.30 + 0.70 * (0.5 + 0.5 * sin(TAU * (crackle) + 5.3));
    float l6 = 0.30 + 0.70 * (0.5 + 0.5 * sin(TAU * (crackle) + 0.7));
    float arcs = max(max(max(a0 * l0, a1 * l1), max(a2 * l2, a3 * l3)), max(a4 * l4, max(a5 * l5, a6 * l6)));
    arcs *= 0.65 + 0.55 * en;
    // AN OSCILLOSCOPE TRACE. Behind the bolt, a thin line wanders across the plane like a scope's trace (two slow sines; phD.y turns 0.11 times a second, so
    // the faster of them is 0.22 Hz), with a fainter line a hair below it, as a phosphor leaves its echo. It is the load's: a livelier trace the busier the CPU. It is
    // hidden where the bolt is (it is BEHIND it), fades out toward the plane's sides, and is faint all through: the bolt and its arcs are the figure, this is the quiet
    // ground under it. `live` takes it out at halt like every event.
    float te = fxOn.z * liveP.x;
    float trace = 0.0;
    if (te > 0.0) {
        float amp = 0.9 + 0.9 * en;
        float a1 = TAU * (p.x / 11.0 - phD.y), a2 = TAU * (p.x / 5.3 - 2.0 * phD.y + 0.21);
        float yy = 1.0 + amp * (0.65 * sin(a1) + 0.35 * sin(a2));
        float sl = amp * TAU * (0.65 / 11.0 * cos(a1) + 0.35 / 5.3 * cos(a2));
        float dtr = (p.y - yy) * inversesqrt(1.0 + sl * sl);
        trace = max(strokeCov(abs(dtr), 0.16), 0.4 * strokeCov(abs(dtr + 1.1), 0.16));
        trace *= (1.0 - smoothstep(17.0, 25.0, abs(p.x))) * smoothstep(-0.2, 1.2, d) * te * 0.5 * (1.0 + 0.6 * gDark);
    }
    // sparks orbiting the bolt
    float sp = 0.0;
    for (int i = 0; i < 6; i++) {
        float fi = float(i);
        float ang = TAU * (orbit + fi * 0.1667);
        vec2 c = vec2(cos(ang) * (13.0 + 1.6 * fi), sin(ang) * (16.0 + 0.8 * fi));
        float br = 0.40 + 0.60 * (0.5 + 0.5 * sin(TAU * (orbit * 2.0) + fi * 1.7));
        sp = max(sp, fillCov(length(p - c) - 0.38) * br);
    }
    float core = inner * 0.9;
    return Sig(d, max(arcs * 0.9, trace), core, fill, sp);
}

Sig symbolSig(int sym, vec2 p) {
    if (sym == 0)
        return symLeaf(p, 0.07 * sin(TAU * phB.y), 0.8 * sin(TAU * phB.x), phB.z);
    if (sym == 1)
        return symScales(p, 0.10 * sin(TAU * phB.y), TAU * phB.y - 1.1);
    return symShock(p, 0.8 * sin(TAU * phB.x), phB.w, phC.x, phC.y);
}

// ---- the treatment ------------------------------------------------------------------------------
// One chromatic sample of a symbol, premultiplied. `sc` is the scanline modulation (1 = none): the
// translucent body and the glow carry all of it, the strokes carry a share, so fine lines stay legible.
vec4 shadeSig(Sig g, vec3 body, vec3 rim, float sc) {
    float inside = fillCov(g.d);
    float outline = strokeCov(abs(g.d), 0.26);
    float halo = exp(-max(g.d, 0.0) / 1.5) * 0.30 * (1.0 - inside);
    float rimGlow = exp(-max(-g.d, 0.0) / 2.0) * 0.16 * inside;
    float st = mix(1.0, sc, 0.5);
    vec4 acc = vec4(0.0);
    acc = inkOver(acc, body, inside * g.fill * 0.15 * sc);
    acc = inkOver(acc, body, (halo + rimGlow) * sc);
    acc = inkOver(acc, body, g.ink * 0.62 * st);
    acc = inkOver(acc, rim, outline * 0.95 * st);
    acc = inkOver(acc, rim, g.core * 0.92 * st);
    acc = inkOver(acc, mix(rim, vec3(1.0), 0.5 * gDark), g.spark);
    return acc;
}
float rimAmount(Sig g) {
    return max(strokeCov(abs(g.d), 0.26), g.core);
}

vec4 holoCpu(vec2 scr) {
    float hp = look.z;
    float energy = targetP.w;
    vec3 A = anchorP.xyz;
    vec2 uv = vec2(scr.x - dot(A, CAM_R), (scr.y - dot(A, CAM_U)) / PLANE_V);    // mm across, mm up from the anchor
    Glitch g = glitchOf(uv, look.x, anchorP.w);
    float split = 0.34 + 2.0 * g.amp + 1.4 * (1.0 - hp);
    vec2 q = g.uv;
    q.x += 0.035 * sin(q.y * 1.3 + TAU * phB.x * 2.0);                          // a faint shimmer
    vec2 p = vec2(q.x, q.y - (plane.y + plane.z * 0.5 + 1.0));
    int sym = int((g.next > 0.5 ? look2.x : look.w) + 0.5);
    vec3 cm = mix(colA.rgb, colB.rgb, g.colMix);
    vec3 body = bodyOf(cm);
    vec3 ink = inkOf(cm);
    vec3 rim = mix(ink, inkOf(colT.rgb), look.y);
    Sig s0 = symbolSig(sym, p);
    Sig sP = symbolSig(sym, p + vec2(split, 0.0));
    Sig sM = symbolSig(sym, p - vec2(split, 0.0));
    float sc = scanlines(uv.y);
    vec4 img = shadeSig(s0, body, rim, sc);
    // the split: two ghosts of the outline in neighbouring hues, under the image
    float gP = rimAmount(sP) * 0.34;
    float gM = rimAmount(sM) * 0.34;
    vec4 ghosts = inkOver(vec4(0.0), hueRot(ink, 0.95), gP);
    ghosts = inkOver(ghosts, hueRot(ink, -0.95), gM);
    img = over(img, ghosts);
    float gain = (0.90 + 0.20 * energy) * mix(0.40, 1.0, colA.a);
    img *= g.keep * flicker() * powerCurve(hp) * gain;
    // the projector: a cone from the anchor up through the plane, and the lens on the package
    vec3 ro = rayOrigin(scr);
    vec3 rd = -CAM_C;
    float haze = 1.0 - exp(-coneHaze(ro, rd, A, plane.y + plane.z, 2.2, 0.36) * 0.017);
    float lens = lensGlow(ro, rd, A, LENS_CPU, 0.55, 0.8);
    vec4 beam = inkOver(vec4(0.0), body, haze * mix(0.85, 0.55, gDark) * plane.w);
    beam = inkOver(beam, ink, lens * 0.55);
    beam *= flicker() * powerCurve(min(hp * 1.25, 1.0)) * anchorP.w;
    // the plane's corner brackets
    vec4 brk = inkOver(vec4(0.0), ink, cornerBrackets(vec2(uv.x, uv.y - plane.y - plane.z * 0.5)) * look2.y);
    brk *= powerCurve(hp) * anchorP.w;
    return over(img, over(brk, beam));
}
// =============================================================================
// holo_fractals.glsl -- the GPU die's holograms: three fractals ray-marched in a volume above the
// die (spliced into silicon_holo.frag).
//
//   0 SIERPINSKI TETRAHEDRON (Smart)   1 MENGER SPONGE (Hybrid)   2 MANDELBULB (dGPU-only)
//
// Each is a distance estimate in its own units, spun slowly about the vertical (a fixed tilt, so the
// spin shows depth). The picture is not a lit solid: the view ray is walked through the whole volume
// and collects light from every surface it passes within a hair of -- a THIN SHELL integrated along
// the ray. That is what makes it a hologram: front and back surfaces both show (see-through), a ray
// grazing a face stays in its shell longest and so the silhouettes and edges burn brighter (the
// Fresnel rim, for free), and nothing needs a normal. Steps are adaptive (small near a surface, long
// in the open), capped at 64; pixels outside the volume's bounding sphere do nothing at all.
// =============================================================================

const float FR_RB = 18.5;                // the volume's bounding sphere, mm
int gLevels;                             // how many levels / iterations the fractal is built to (set from the pixel size)

float deSierp(vec3 p) {                  // canonical frame: vertices (+-1, +-1, +-1), circumradius sqrt(3)
    float sc = 1.0;
    for (int i = 0; i < 5; i++) {
        if (i >= gLevels)
            break;
        vec3 c = vec3(1.0, 1.0, 1.0);
        float m = dot(p, c);
        float m2 = dot(p, vec3(-1.0, -1.0, 1.0));
        if (m2 > m) {
            m = m2;
            c = vec3(-1.0, -1.0, 1.0);
        }
        m2 = dot(p, vec3(1.0, -1.0, -1.0));
        if (m2 > m) {
            m = m2;
            c = vec3(1.0, -1.0, -1.0);
        }
        m2 = dot(p, vec3(-1.0, 1.0, -1.0));
        if (m2 > m) {
            m = m2;
            c = vec3(-1.0, 1.0, -1.0);
        }
        p = 2.0 * p - c;
        sc *= 2.0;
    }
    float dd = max(max(-(p.x + p.y + p.z), p.x + p.y - p.z), max(-p.x + p.y + p.z, p.x - p.y + p.z));
    return (dd - 1.0) / SQ3 / sc;
}

float deMenger(vec3 p) {                 // a cube of half size 1, three levels of holes
    vec3 q = abs(p) - vec3(1.0);
    float d = length(max(q, 0.0)) + min(max(q.x, max(q.y, q.z)), 0.0);
    float s = 1.0;
    for (int m = 0; m < 3; m++) {
        if (m >= gLevels)
            break;
        vec3 a = mod(p * s, 2.0) - 1.0;
        s *= 3.0;
        vec3 r = abs(1.0 - 3.0 * abs(a));
        float da = max(r.x, r.y);
        float db = max(r.y, r.z);
        float dc = max(r.z, r.x);
        float c = (min(da, min(db, dc)) - 1.0) / s;
        d = max(d, c);
    }
    return d;
}

float deBulb(vec3 p, float pw) {         // the Mandelbulb, its pole along y
    vec3 z = p;
    float dr = 1.0;
    float r = 0.0;
    for (int i = 0; i < 6; i++) {
        if (i >= gLevels)
            break;
        r = length(z);
        if (r > 2.0)
            break;
        float theta = acos(clamp(z.y / r, -1.0, 1.0));
        float phi = atan(z.z, z.x);
        dr = pow(r, pw - 1.0) * pw * dr + 1.0;
        float zr = pow(r, pw);
        theta *= pw;
        phi *= pw;
        z = zr * vec3(sin(theta) * cos(phi), cos(theta), sin(theta) * sin(phi)) + p;
    }
    return 0.5 * log(r) * r / dr;
}

float mapFrac(int sym, vec3 p, float pw) {
    if (sym == 0)
        return deSierp(p);
    if (sym == 1)
        return deMenger(p);
    return deBulb(p, pw);
}

vec3 rotX(vec3 v, float a) {
    float c = cos(a), s = sin(a);
    return vec3(v.x, c * v.y - s * v.z, s * v.y + c * v.z);
}
vec3 rotY(vec3 v, float a) {
    float c = cos(a), s = sin(a);
    return vec3(c * v.x + s * v.z, v.y, -s * v.x + c * v.z);
}
// the upright frame (the apex along +y) -> the canonical tetrahedron frame
vec3 tetraFrame(vec3 v) {
    return v.x * vec3(0.70710678, -0.70710678, 0.0) + v.y * vec3(0.57735027) + v.z * vec3(-0.40824829, -0.40824829, 0.81649658);
}

// Sphere-trace along o + d t for up to `len` units: the distance of the first surface, or -1; `hmin`
// is the ray's nearest approach to the fractal (the halo around the silhouette).
float traceFrac(int sym, vec3 o, vec3 d, float len, float pw, float eps, float relax, out float hmin) {
    float t = 0.0;
    float h = 1e3;
    hmin = 1e3;
    for (int i = 0; i < 56; i++) {
        h = mapFrac(sym, o + d * t, pw);
        hmin = min(hmin, h);
        if (h < eps)
            return t;
        t += h * relax;
        if (t > len)
            return -1.0;
    }
    // out of steps right next to a surface (a grazing ray): that is a silhouette pixel, not a miss
    return h < eps * 8.0 ? t : -1.0;
}

// The surface normal by four taps; `edge` is how far the gradient falls short of a unit vector (the
// two faces of an edge cancel inside one tap spacing): 0 on a face, up to 1 on a sharp edge.
vec3 fracNormal(int sym, vec3 p, float pw, float e, out float edge) {
    vec2 k = vec2(1.0, -1.0);
    vec3 g = k.xyy * mapFrac(sym, p + k.xyy * e, pw) + k.yyx * mapFrac(sym, p + k.yyx * e, pw)
           + k.yxy * mapFrac(sym, p + k.yxy * e, pw) + k.xxx * mapFrac(sym, p + k.xxx * e, pw);
    edge = sym == 2 ? 0.0 : clamp(1.0 - length(g) / (4.0 * e), 0.0, 1.0);
    return normalize(g);
}

// horizontal slice lines at constant world height: they wrap round the form, so the 3D shows
float contour(float y, float spacing) {
    return pow(1.0 - abs(2.0 * fract(y / spacing - phA.x) - 1.0), 3.5);
}

// One sample of the fractal at a screen point: premultiplied, ink-coloured. `px` seeds nothing;
// the front and the back surface of the volume are found by two sphere traces (the second from the
// far side), shaded by Fresnel and the slice lines, and stacked: that is the see-through.
vec4 fractalSample(vec2 scr, vec2 px, int sym, vec3 ink) {
    vec3 ro = rayOrigin(scr);
    vec3 rd = -CAM_C;
    vec3 C = anchorP.xyz + vec3(0.0, plane.y + plane.z * 0.5, 0.0);
    vec3 oc = ro - C;
    float b = dot(oc, rd);
    float disc = b * b - (dot(oc, oc) - FR_RB * FR_RB);
    if (disc <= 0.0)
        return vec4(0.0);
    float sq = sqrt(disc);
    float tn = -b - sq;
    float tf = -b + sq;
    float scl = sym == 2 ? 14.0 : 10.2;                   // mm per fractal unit
    float spin = TAU * phC.z;
    vec3 o = rotY(oc + rd * tn, -spin) / scl;
    vec3 d = rotY(rd, -spin);
    if (sym == 0) {
        o = tetraFrame(o);
        d = tetraFrame(d);
    }
    float len = (tf - tn) / scl;
    // build only the levels that are still wider than ~5 device px
    float pxU = 1.0 / (view.z * max(quad.z, 1.0) * scl);
    if (sym == 0)
        gLevels = int(clamp(floor(log2(1.732 / (6.0 * pxU))), 2.0, 5.0));
    else if (sym == 1)
        gLevels = int(clamp(floor(log(2.0 / (6.0 * pxU)) / 1.0986), 1.0, 3.0));
    else
        gLevels = pxU > 0.02 ? 4 : 5;
    float pw = 8.0 + 0.9 * sin(TAU * phC.z * 2.0);       // the bulb breathes, slowly
    float eps = (0.0012 + 0.35 / (view.z * max(quad.z, 1.0))) / scl;
    float relax = sym == 2 ? 0.65 : 0.9;
    float hm1;
    float t1 = traceFrac(sym, o, d, len, pw, eps, relax, hm1);
    float rho = sqrt(max(dot(oc, oc) - b * b, 0.0)) / FR_RB;                 // 0 at the centre, 1 at the sphere's edge
    float halo = exp(-hm1 * scl / 1.3) * (1.0 - smoothstep(0.70, 0.98, rho));
    vec4 acc = inkOver(vec4(0.0), ink, halo * 0.30);
    float cs = sym == 2 ? 2.0 : 1.4;                       // slice spacing, mm
    if (t1 >= 0.0) {
        float e1;
        vec3 n1 = fracNormal(sym, o + d * t1, pw, eps * 2.5, e1);
        float f1 = pow(1.0 - abs(dot(n1, d)), sym == 2 ? 1.3 : 1.7);
        float y1 = ro.y + rd.y * (tn + t1 * scl) - C.y;
        // a top light fixed in the view, so the form reads: the normal back in the world frame
        vec3 nw = sym == 0 ? vec3(dot(n1, vec3(0.70710678, -0.70710678, 0.0)), dot(n1, vec3(0.57735027)), dot(n1, vec3(-0.40824829, -0.40824829, 0.81649658))) : n1;
        nw = rotY(nw, spin);
        float lam = 0.5 + 0.5 * nw.y;
        // the surface behind it, from the far side
        float hm2;
        float e2;
        vec3 o2 = o + d * len;
        float t2 = traceFrac(sym, o2, -d, len, pw, eps, relax, hm2);
        if (t2 >= 0.0) {
            vec3 n2 = fracNormal(sym, o2 - d * t2, pw, eps * 2.5, e2);
            float f2 = pow(1.0 - abs(dot(n2, d)), 1.7);
            float y2 = ro.y + rd.y * (tn + (len - t2) * scl) - C.y;
            float a2 = (0.06 + 0.40 * f2 + 0.14 * contour(y2, cs) + 0.30 * smoothstep(0.08, 0.35, e2)) * 0.75;
            acc = inkOver(acc, hueRot(ink, -0.30) * 0.9, a2);
        }
        float lamK = sym == 2 ? 0.60 : 0.40;                       // the bulb's smooth form needs more light to read
        float a1 = (0.10 + 0.62 * f1 + (sym == 2 ? 0.34 : 0.24) * contour(y1, cs) + 0.55 * smoothstep(0.08, 0.35, e1)) * (1.0 - lamK * 0.5 + lamK * lam);
        acc = inkOver(acc, hueRot(ink, 0.22), a1);
    }
    return acc;
}

// THE ARMILLARY. Three thin rings turn about the volume's centre (HoloLayer hands over their screen frames: X, Y in silicon_holo.frag.in): the
// equator, which carries a dial of 48 ticks, a hoop that wobbles about the vertical (it precesses once in 25 s), and a meridian ring that turns about it. Each
// carries a bead (a small moon). A ring is seen as the ellipse x^2 + y^2 = 1 in its own frame (HoloLayer._ring says how x and y come from the pixel; the minor axis never
// reaches 0, so a ring turning through edge-on stays one smooth thin ellipse): the half nearer the viewer is drawn IN FRONT of the fractal and the far half BEHIND it, so
// the form sits inside the rings. Returns the coverages (line behind, line in front, bead behind, bead in front).
// Everything that does not depend on the pixel is worked out once a frame by HoloLayer: X the ring's major axis (unit) and its minor axis over the (floored) minor length,
// Y: 1/R, the near half's eased sign, the bead's near weight, the turn; `bp` the bead's screen place.
vec4 orbRing(vec2 q, vec4 X, vec4 Y, vec2 bp, float ticks) {
    float x = dot(q, X.xy) * Y.x;
    float y = dot(q, X.zw) * Y.x;
    float r = max(length(vec2(x, y)), 1e-3);
    float d = (r - 1.0) / max(length(x * X.xy + y * X.zw) * Y.x / r, 1e-3);     // mm to the ring (the gradient of r, normalised)
    // That first-order distance fails at the tips of a thin ellipse, where the curve turns sharply -- it reads pixels up to 0.15 R past
    // each tip as ON the line (the reach grows as 1 / b^2), so the ring would lengthen by a fifth just before edge-on and shrink back. The ellipse
    // lies inside its box (R along the major axis, R b along the minor, b = 1 / |X.zw|), so no pixel is nearer to it than to that box: the
    // distance is at least the box's.
    float db = length(vec2(max(abs(x) - 1.0, 0.0), max(abs(y) - 1.0, 0.0) / length(X.zw))) / Y.x;
    d = max(abs(d), db);
    float fw = smoothstep(-0.12, 0.12, -y * Y.y);                              // 1 on the near half (sin a < 0, y = Y.y sin a: Y.y is 0 at edge-on, where the halves blend)
    float line = strokeCov(d, 0.19) * 0.55;
    if (ticks > 0.5) {
        float tk = fract((atan(y, x) - TAU * Y.w) * (48.0 / TAU));
        line = max(line, (1.0 - smoothstep(0.55, 1.1, d)) * (1.0 - smoothstep(0.10, 0.22, abs(tk - 0.5))) * 0.55);
    }
    float bl = length(q - bp);
    float bead = fillCov(bl - 0.75) * 0.95 + exp(-bl * bl / 2.2) * 0.35;
    return vec4(line * (1.0 - fw), line * fw, bead * (1.0 - Y.z), bead * Y.z);
}

vec4 holoGpu(vec2 scr, vec2 px) {
    float hp = look.z;
    float energy = targetP.w;
    vec3 A = anchorP.xyz;
    vec2 uv = vec2(scr.x - dot(A, CAM_R), (scr.y - dot(A, CAM_U)) / PLANE_V);
    Glitch g = glitchOf(uv, look.x, anchorP.w);
    vec2 scrG = scr + vec2(g.uv.x - uv.x, (g.uv.y - uv.y) * PLANE_V);
    int sym = int((g.next > 0.5 ? look2.x : look.w) + 0.5);
    vec3 cm = mix(colA.rgb, colB.rgb, g.colMix);
    vec3 body = bodyOf(cm);
    vec3 ink = inkOf(cm);
    vec4 img = fractalSample(scrG, px, sym, ink);
    // the chromatic split costs two more marches: only while the picture is breaking up or powering on
    float split = 0.34 + 2.0 * g.amp + 1.4 * (1.0 - hp);
    if (g.amp > 0.02 || hp < 0.98) {
        vec4 gp = fractalSample(scrG + vec2(split, 0.0), px, sym, hueRot(ink, 0.95));
        vec4 gm = fractalSample(scrG - vec2(split, 0.0), px, sym, hueRot(ink, -0.95));
        img = over(img, (gp + gm) * 0.22);
    }
    if (fxOn.w > 0.5) {
        vec3 Cc = A + vec3(0.0, plane.y + plane.z * 0.5, 0.0);
        vec2 q = scr - vec2(dot(Cc, CAM_R), dot(Cc, CAM_U));
        vec4 orb = max(orbRing(q, orbX0, orbY0, orbB.xy, 1.0), max(orbRing(q, orbX1, orbY1, orbB.zw, 0.0), orbRing(q, orbX2, orbY2, orbC.xy, 0.0)));
        vec3 bc = mix(ink, vec3(1.0), 0.45 * gDark);
        img = over(inkOver(inkOver(vec4(0.0), ink, orb.y), bc, orb.w), over(img, inkOver(inkOver(vec4(0.0), ink, orb.x * 0.8), bc, orb.z * 0.8)));
    }
    float gain = (0.90 + 0.20 * energy) * mix(0.40, 1.0, colA.a);
    img *= g.keep * flicker() * powerCurve(hp) * gain;
    // the projector: a cone from the die up into the volume, the lens on the die, a ring where the volume begins
    vec3 ro = rayOrigin(scr);
    vec3 rd = -CAM_C;
    float hTop = plane.y + plane.z * 0.5 + 4.0;
    float haze = 1.0 - exp(-coneHaze(ro, rd, A, hTop, 1.8, 0.40) * 0.017);
    float lens = lensGlow(ro, rd, A, LENS_GPU, 0.55, 0.8);
    float ring = lensGlow(ro, rd, A + vec3(0.0, plane.y - 1.0, 0.0), LENS_GPU_RING, 0.0, 0.7);
    vec4 beam = inkOver(vec4(0.0), body, haze * mix(0.85, 0.55, gDark) * plane.w);
    beam = inkOver(beam, ink, lens * 0.55 + ring * 0.35);
    beam *= flicker() * powerCurve(min(hp * 1.25, 1.0)) * anchorP.w;
    vec4 brk = inkOver(vec4(0.0), ink, cornerBrackets(vec2(uv.x, uv.y - plane.y - plane.z * 0.5)) * look2.y);
    brk *= powerCurve(hp) * anchorP.w;
    return over(img, over(brk, beam));
}
// =============================================================================
// holo_beam.glsl -- Integrated mode: the card is gone from its slot, and the CPU's graphics tile
// beams a see-through ghost of it to where it sat (spliced into silicon_holo.frag).
//
// A thin fan of light runs along the board from the tile (`anchor`) to the card's DIE (`target`: the die's centre at its own height, hovering
// with the ghost), widening toward the card; pulses of light travel down it at a tempo the iGPU's busy sets, and it fades out into the die as it
// fades in at the tile (so it does not end in a bright band and a hard cut at the card's middle). At its end the card hangs over its
// place as a FLAT hologram of the REAL card, all its parts included and its I/O bracket left out: every part is drawn on horizontal
// planes at the heights it really has -- outlines, faint fills, the edges that join a tall part's top to its footprint -- with the same scanlines
// and flicker as every hologram. The parts come from SceneGeometry.PARTS through HoloLayer (cardPcb ... r3hMlc2): one source, so the ghost follows
// the card.
// =============================================================================

float rectSd(vec2 xz, vec4 r, float rad) {      // r: x0 z0 x1 z1 (board mm); a rounded rectangle
    vec2 c = vec2(r.x + r.z, r.y + r.w) * 0.5;
    vec2 h = vec2(r.z - r.x, r.w - r.y) * 0.5;
    return sdBox2(xz - c, h - vec2(rad)) - rad;
}

// ---- the ghost's coordinates -----------------------------------------------------------------------------------------
// The view direction is (-1, -1, -1) / sqrt 3, so the ray over a pixel is at (g.x + y, g.y + y) in x and z when it is y mm up (g is where it meets the
// board's plane, y = 0): a horizontal plane at height y is `g + vec2(y)`, a shift and nothing more, and a vertical edge is found by arithmetic on g
// too (gEdgeAt). No ray is marched for the ghost.
const float G_FS = 0.70710678;          // an axis-aligned edge lying in a horizontal plane is foreshortened to this on the screen
const float G_V = 0.8164966;            // so is a vertical length
const float G_LINE = 0.156;             // a line's half width, screen mm (0.22 mm on the plane)
const float GHOST_PCB_R = 0.8;           // the PCB's corner radius in the ghost (the card's PCB is square: a hologram's corner is a little soft)
// the beam fades IN over [-BEAM_FAN_BACK, BEAM_RAMP] of its length around the tile (its core over [0, BEAM_CORE_RAMP]) and OUT the same way around the die:
// the same ramps mirrored about the middle of the beam (the end fades out the way it fades in)
const float BEAM_RAMP = 0.05;
const float BEAM_CORE_RAMP = 0.04;

// a row of identical cells (a box is a row of one): the first cell's rectangle, the step between cells, the counts, y0 y1 and the shape
struct GRow {
    vec4 r;
    vec2 pitch;
    vec2 n;
    vec3 yS;
    float skip;     // the cells the row leaves out (SceneGeometry ROW `skip`), a mask: the sum of 2^i over their indices
};
GRow gRow(vec4 a, vec4 b, vec4 c) {
    return GRow(a, b.xy, b.zw, c.xyz, c.w);
}
vec2 gCenter(GRow w) {
    return (w.r.xy + w.r.zw) * 0.5;
}
vec2 gHalf(GRow w) {
    return (w.r.zw - w.r.xy) * 0.5;
}
// the cell of a row nearest to xz (its index along x and z; a row runs along one of them)
vec2 gIndex(vec2 xz, GRow w) {
    return clamp(floor((xz - gCenter(w)) / max(w.pitch, vec2(0.001)) + 0.5), vec2(0.0), max(w.n - 1.0, vec2(0.0)));
}
// signed distance (board mm) in a horizontal plane to the row's nearest cell: a rounded rectangle, or the circle a cylinder's cell is
float gCellSd(vec2 xz, GRow w, vec2 idx, float rad) {
    vec2 l = xz - gCenter(w) - idx * w.pitch;
    vec2 h = gHalf(w);
    return w.yS.z > 0.5 ? length(l) - min(h.x, h.y) : sdBox2(l, h - vec2(rad)) - rad;
}
// a cell the row leaves out (no bit operations in GLSL 1.20: the mask is read with floor / mod / exp2)
bool gSkipped(GRow w, vec2 idx) {
    return w.skip > 0.5 && mod(floor(w.skip / exp2(idx.x + idx.y * max(w.n.x, 1.0))), 2.0) > 0.5;
}
// Where the nearest cell is one the row leaves out (the card's MLCCs behind its caps), its neighbours along the row are the nearest that are there.
// Only the outlines take the skip: a row with left-out cells has no vertical edges in the ghost (gEdgeRow / gSilRow draw every cell).
float gRowSd(vec2 xz, GRow w, float rad) {
    vec2 idx = gIndex(xz, w);
    if (!gSkipped(w, idx))
        return gCellSd(xz, w, idx, rad);
    vec2 ax = vec2(w.n.x > 1.5 ? 1.0 : 0.0, w.n.y > 1.5 ? 1.0 : 0.0);
    vec2 lo = max(idx - ax, vec2(0.0));
    vec2 hi = min(idx + ax, max(w.n - 1.0, vec2(0.0)));
    float d = 1e3;
    if (any(notEqual(lo, idx)) && !gSkipped(w, lo))
        d = min(d, gCellSd(xz, w, lo, rad));
    if (any(notEqual(hi, idx)) && !gSkipped(w, hi))
        d = min(d, gCellSd(xz, w, hi, rad));
    return d;
}
// A vertical edge at e = (x, z) from height yb to yt, as a line `hw` screen mm wide. The ray over the pixel is closest to it at height
// y = (e.x - g.x + e.y - g.y) / 2; (g.x - g.y) - (e.x - e.y) is 1.414 x the pixel's distance from the edge's line on the screen, and a length of
// the edge is 0.8165 x as long there (its ends are soft).
float gEdgeAt(vec2 g, vec2 e, float yb, float yt, float hw) {
    float y = 0.5 * ((e.x - g.x) + (e.y - g.y));
    float d = length(vec2(((g.x - g.y) - (e.x - e.y)) * G_FS, max(max(yb - y, y - yt), 0.0) * G_V));
    return strokeCov(d, hw);
}
// the same edge of every cell of a row (the corner is the FIRST cell's): the cell whose edge is nearest on the screen is the one drawn
float gEdgeRow(vec2 g, GRow w, vec2 corner, float yb, float yt, float hw) {
    float st = w.pitch.x - w.pitch.y;
    float k = abs(st) > 0.001 ? clamp(floor(((g.x - g.y) - (corner.x - corner.y)) / st + 0.5), 0.0, max(w.n.x, w.n.y) - 1.0) : 0.0;
    return gEdgeAt(g, corner + k * w.pitch, yb, yt, hw);
}
// a vertical cylinder's two outline edges (the ray grazes it at 1.414 x its radius from the axis in g.x - g.y), every cylinder of a row
float gSilRow(vec2 g, GRow w, float yb, float yt, float hw) {
    vec2 c0 = gCenter(w);
    float st = w.pitch.x - w.pitch.y;
    float k = abs(st) > 0.001 ? clamp(floor(((g.x - g.y) - (c0.x - c0.y)) / st + 0.5), 0.0, max(w.n.x, w.n.y) - 1.0) : 0.0;
    vec2 c = c0 + k * w.pitch;
    float y = 0.5 * ((c.x - g.x) + (c.y - g.y));
    float r = min(gHalf(w).x, gHalf(w).y);
    float d = length(vec2(abs(abs((g.x - g.y) - (c.x - c.y)) * G_FS - r), max(max(yb - y, y - yt), 0.0) * G_V));
    return strokeCov(d, hw);
}

// one mark of the ghost: a translucent fill, a soft halo and an outline, from a signed distance in board mm (negative inside)
vec4 gMark(float d, float fillA, float rimA, float haloA, vec3 body, vec3 rim) {
    float ds = d * G_FS;
    float inside = fillCov(ds);
    float outline = strokeCov(abs(ds), G_LINE);
    float halo = exp(-max(d, 0.0) / 1.2) * haloA * (1.0 - inside);
    vec4 acc = inkOver(vec4(0.0), body, inside * fillA);
    acc = inkOver(acc, body, halo);
    return inkOver(acc, rim, outline * rimA);
}

// a row of parts standing on the card: the footprint it stands on, the edges up to the top (the three that face the camera: a box's, or a
// cylinder's two sides) and the top face. `baseA` and `edgeA` are 0 for a part too low to need them.
vec4 gRowMarks(vec2 g, GRow w, float lift, float rad, float fillA, float rimA, float baseA, float edgeA, vec3 body, vec3 rim) {
    vec4 acc = vec4(0.0);
    if (w.n.x < 0.5)
        return acc;
    float yb = w.yS.x + lift;
    float yt = w.yS.y + lift;
    if (baseA > 0.0) {
        float dB = gRowSd(g + vec2(yb), w, rad);
        acc = over(gMark(dB, 0.0, baseA, 0.0, body, rim), acc);
        float e = w.yS.z > 0.5 ? gSilRow(g, w, yb, yt, G_LINE)
                  : max(gEdgeRow(g, w, w.r.zw, yb, yt, G_LINE), max(gEdgeRow(g, w, vec2(w.r.x, w.r.w), yb, yt, G_LINE), gEdgeRow(g, w, vec2(w.r.z, w.r.y), yb, yt, G_LINE)));
        acc = inkOver(acc, rim, e * edgeA);
    }
    return over(gMark(gRowSd(g + vec2(yt), w, rad), fillA, rimA, 0.0, body, rim), acc);
}

// the whole ghost card, premultiplied; `lift` is how far it hovers above its place
vec4 ghostCard(vec2 g, float lift, vec3 body, vec3 ink) {
    vec4 acc = vec4(0.0);
    // the PCB: the underside's outline, then the top face with a faint projection grid and the gold fingers
    float yU = cardH.x + lift;
    float yP = cardH.y + lift;
    acc = over(gMark(rectSd(g + vec2(yU), cardPcb, GHOST_PCB_R), 0.0, 0.40, 0.16, body, ink), acc);
    vec2 xzP = g + vec2(yP);
    float dPcb = rectSd(xzP, cardPcb, GHOST_PCB_R);
    vec4 top = gMark(dPcb, 0.13, 0.85, 0.16, body, ink);
    vec2 gq = abs(fract(xzP / 4.0) - 0.5) * 4.0;
    top = inkOver(top, ink, strokeCov(min(gq.x, gq.y) * G_FS, 0.05) * fillCov((dPcb + 0.6) * G_FS) * 0.10);
    float fz = abs(fract((xzP.y - r3hFing.y) / r3hTops.z) - 0.5) * r3hTops.z;
    float inBand = step(r3hFing.x, xzP.x) * step(xzP.x, r3hFing.z) * step(r3hFing.y, xzP.y) * step(xzP.y, r3hFing.w);
    top = inkOver(top, ink, strokeCov(fz * G_FS, r3hTops.w * 0.5 * G_FS) * inBand * 0.55);
    acc = over(top, acc);
    // the die's substrate and the heatsink's base, flat on the PCB
    acc = over(gMark(rectSd(g + vec2(cardH.z + lift), cardSub, 0.8), 0.06, 0.55, 0.16, body, ink), acc);
    acc = over(gMark(rectSd(g + vec2(r3hTops.y + lift), r3hSink, 0.4), 0.08, 0.55, 0.0, body, ink), acc);
    // the four GDDR chips
    vec2 xzM = g + vec2(r3hTops.x + lift);
    float dM = min(min(rectSd(xzM, cardM0, 0.5), rectSd(xzM, cardM1, 0.5)), min(rectSd(xzM, cardM2, 0.5), rectSd(xzM, cardM3, 0.5)));
    acc = over(gMark(dM, 0.14, 0.75, 0.16, body, ink), acc);
    // the VRM's MOSFETs and the MLCCs (flat), its chokes and the capacitors (tall), the heatsink's fins (the tallest): five rows, one after the other over what is
    // under them, through ONE call of gRowMarks in a loop whose bound comes from a uniform (r3hBeam.z, kept 0: the rows beyond the five) so the compiler cannot unroll
    // it -- Mesa inlines every call, and gRowMarks is some 280 lines of inlined source a copy: five copies are a third of the whole shader's compile
    int nr = 5 + int(r3hBeam.z);
    for (int i = 0; i < nr; i++) {
        GRow w = i == 0 ? gRow(r3hFet0, r3hFet1, r3hFet2)
               : (i == 1 ? gRow(r3hMlc0, r3hMlc1, r3hMlc2)
               : (i == 2 ? gRow(r3hChk0, r3hChk1, r3hChk2)
               : (i == 3 ? gRow(r3hCap0, r3hCap1, r3hCap2) : gRow(r3hFin0, r3hFin1, r3hFin2))));
        // corner radius, fill, rim, base, edge
        vec4 rowA = i == 0 ? vec4(0.2, 0.14, 0.50, 0.0) : (i == 1 ? vec4(0.1, 0.14, 0.45, 0.0) : (i == 2 ? vec4(0.3, 0.10, 0.65, 0.30) : (i == 3 ? vec4(0.0, 0.10, 0.65, 0.30) : vec4(0.0, 0.12, 0.80, 0.35))));
        float edgeA = i < 2 ? 0.0 : 0.45;
        acc = over(gRowMarks(g, w, lift, rowA.x, rowA.y, rowA.z, rowA.w, edgeA, body, ink), acc);
    }
    // the die, on top: a bright fill and outline and an inner line
    vec2 xzD = g + vec2(cardH.w + lift);
    float dDie = rectSd(xzD, cardDie, 0.5);
    vec4 die = gMark(dDie, 0.28, 1.0, 0.16, body, ink);
    die = inkOver(die, ink, strokeCov(abs(dDie + 1.6) * G_FS, G_LINE * 0.73) * 0.7);
    return over(die, acc);
}

// the fan of light: integrated through a slab of the board's airspace, in 16 steps. It fades in at the tile over the first few mm and out into the
// die the same way (BEAM_RAMP), so it has no end to see.
float fanLight(vec3 ro, vec3 rd, vec3 A, vec3 T, float arch, float pulsePh) {
    vec2 Dh = T.xz - A.xz;
    float Lh = length(Dh);
    vec2 D = Dh / Lh;
    vec2 N = vec2(-D.y, D.x);
    float yTop = 16.0 + arch;
    float tTop = (yTop - ro.y) / rd.y;
    float tBot = (0.0 - ro.y) / rd.y;
    vec3 pm = ro + rd * (0.5 * (tTop + tBot));
    float sm = dot(pm.xz - A.xz, D);
    float lm = dot(pm.xz - A.xz, N);
    // the samples of one ray lie within 18 mm of the slab's middle along the beam; the density ends at the die and begins 3 % of the length behind the tile
    if (sm < -BEAM_FAN_BACK * Lh - 18.0 || sm > Lh + 18.0 || abs(lm) > 58.0)
        return 0.0;
    // THE DATA STREAM. A slow swell of light runs down the core from the tile to the card at 2.4 mm/s: an 8-cell word (5 mm cells,
    // so it wraps without a jump) of smoothly blended levels, the core's own brightness varying by +-22 % about its rest and nothing with an edge (dashes of 6 mm/s, 1.45 x and
    // 0.45 x with hard-edged cells are too busy: the stream is subtle and serene). Read ONCE at the slab's middle, not per sample: the ray crosses the slab
    // slantwise, and a per-sample pattern smeared into stairs. A motion: `live` takes it out at halt like the pulses; 0 or halted, `strm` is exactly 1.
    float cw = sm / 5.0 - 8.0 * phD.w;
    float ci = floor(cw);
    float cf = cw - ci;
    cf = cf * cf * (3.0 - 2.0 * cf);
    float lvl = mix(hash11(mod(ci, 8.0)), hash11(mod(ci + 1.0, 8.0)), cf);
    float strm = 1.0 + fxOn.x * liveP.x * 0.44 * (lvl - 0.5);
    float dt = (tBot - tTop) / 16.0;
    float acc = 0.0;
    for (int i = 0; i < 16; i++) {
        vec3 p = ro + rd * (tTop + (float(i) + 0.5) * dt);
        float s = dot(p.xz - A.xz, D);
        float l = dot(p.xz - A.xz, N);
        float q = s / Lh;
        float qc = clamp(q, 0.0, 1.0);
        float yAxis = mix(A.y, T.y, qc) + arch * 4.0 * qc * (1.0 - qc);
        float W = BEAM_FAN_W0 + BEAM_FAN_W1 * qc;
        float H = r3hBeam.x + r3hBeam.y * qc;
        float dy = (p.y - yAxis) / H;
        float rl = l / W;
        float dens = exp(-2.3 * rl * rl) * exp(-2.6 * dy * dy);
        dens *= smoothstep(-BEAM_FAN_BACK, BEAM_RAMP, q) * (1.0 - smoothstep(1.0 - BEAM_RAMP, 1.0 + BEAM_FAN_BACK, q));
        dens *= 0.50 + 0.50 * (1.0 - qc);
        // pulses of light running down the axis (they are a motion: the idle ladder's `live` takes them out at halt)
        float pls = 0.0;
        for (int k = 0; k < 3; k++) {
            float u = (q - fract(pulsePh + float(k) / 3.0)) / 0.045;
            pls += exp(-u * u);
        }
        float lc = l / 0.9;
        float core = exp(-lc * lc) * exp(-3.0 * dy * dy) * smoothstep(0.0, BEAM_CORE_RAMP, q) * (1.0 - smoothstep(1.0 - BEAM_CORE_RAMP, 1.0, q));
        core *= strm;
        dens += core * (1.5 + 3.2 * pls * liveP.x);
        acc += dens * abs(dt);
    }
    return acc;
}

vec4 holoBeam(vec2 scr, vec2 px) {
    float hp = look.z;
    float energy = targetP.w;
    float presence = anchorP.w;
    float lift = r3hHover.x + r3hHover.y * sin(TAU * phB.x);           // the ghost hovers a little above its place
    vec3 A = anchorP.xyz;
    vec3 T = vec3(targetP.x, targetP.y + lift, targetP.z);             // the die's centre, at the height its top hovers at
    vec3 ro = rayOrigin(scr);
    vec3 rd = -CAM_C;
    Glitch g = glitchOf(vec2(scr.x, scr.y / PLANE_V), 0.0, presence);
    vec3 cm = colA.rgb;
    vec3 body = bodyOf(cm);
    vec3 ink = inkOf(cm);
    float sc = scanlines(scr.y / PLANE_V);
    // ---- the fan ----
    float acc = fanLight(ro, rd, A, T, quad.w, phC.w);
    float haze = 1.0 - exp(-acc * 0.10);
    vec4 beam = inkOver(vec4(0.0), body, haze * mix(0.80, 0.50, gDark) * (plane.w / 1.8));      // 1.8 = the default strength
    float lens = lensGlow(ro, rd, A, LENS_BEAM, 0.55, 0.8);
    beam = inkOver(beam, ink, lens * 0.55);
    // ---- the ghost of the card: the ground-plane point of this pixel's ray, and every part drawn from it ----
    vec4 ghost = vec4(0.0);
    vec2 gp = vec2(G_FS * scr.x - 1.22474487 * scr.y, -G_FS * scr.x - 1.22474487 * scr.y);
    // only where this pixel's ray passes through the box the ghost hangs in (r3hBox over r3hHover.z .. .w, lifted by the hover): at height y the ray is at
    // gp + y in x and z, so it is inside while y is in all three of its ranges
    if (max(max(r3hBox.x - gp.x, r3hBox.y - gp.y), r3hHover.z + lift) <= min(min(r3hBox.z - gp.x, r3hBox.w - gp.y), r3hHover.w + lift))
        ghost = ghostCard(gp, lift, body, ink);
    // the ghost shimmers a little, scans, flickers; the fan is light, so only the flicker touches it
    float gain = (0.80 + 0.45 * energy) * mix(0.40, 1.0, colA.a);
    ghost *= mix(1.0, sc, 0.7);
    ghost *= g.keep * flicker() * powerCurve(hp) * gain;
    beam *= flicker() * powerCurve(min(hp * 1.25, 1.0)) * presence * (0.85 + 0.3 * energy);
    return over(ghost, beam);
}

void main() {
    int kind = int(frame.z + 0.5);
    gDark = frame.w;
    float pxDev = view.z * max(quad.z, 1.0);
    gAA = 0.62 / pxDev;                                   // 0.6 device px, in mm
    vec2 px = quad.xy + qt_TexCoord0 * view.xy;
    vec2 scr = vec2((px.x - frame.x) / view.z, (frame.y - px.y) / view.z);   // screen mm: right, up
    vec4 c;
    if (kind == 0)
        c = holoCpu(scr);
    else if (kind == 1)
        c = holoGpu(scr, px);
    else
        c = holoBeam(scr, px);
    // dark ground: hand part of the alpha back (an additive share) so the ink glows
    c.a *= 1.0 - 0.55 * gDark;
    fragColor = c * qt_Opacity;
}

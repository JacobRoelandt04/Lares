        // block pixelation, staggered by slice
        float blockOn = smoothstep(0.30 + 0.30 * h2, 0.58 + 0.30 * h2, amp);
        float blk = mix(0.05, 2.6, blockOn * blockOn);
        g.uv = (floor(g.uv / blk) + 0.5) * blk;

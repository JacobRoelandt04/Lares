    if (id == 5) return vec4(3.0, 0.0, 0.0, 1.0);
    if (id == 6) return vec4(2.0, 0.0, 0.0, 1.0);
    if (id == 7) return vec4(1.0, 1.0, 42.5, 66.5);
    if (id == 8) return vec4(1.0, 1.0, 42.5, 66.5);
    if (id == 9) return vec4(1.0, 1.0, 42.5, 66.5);
    if (id == 10) return vec4(1.0, 1.0, 42.5, 66.5);
    if (id == 11) return vec4(1.0, 0.0, 0.0, 1.0);

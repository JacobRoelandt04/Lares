#version 440

// =============================================================================
// silicon_particles.frag -- one particle: a tapered streak with a soft head, or a dot. Premultiplied
// (Qt's blend is ONE, ONE_MINUS_SRC_ALPHA). The uniform block is particles_ubo.glsl's, shared with
// the vertex stage.
//
// The ground can be light (the white solder mask, the paper, the shell's #EAEDF5) or dark, so the
// colour is chosen for it: on light the core is a DEEPER version of the colour (a light colour at
// low alpha vanishes on a light ground) and nothing is added; on dark the core runs toward white and
// the blend leans toward an add, which a dark ground can take. Never an additive white-out.
// =============================================================================

layout(location = 0) in vec2 vQuad;
layout(location = 1) in vec4 vCol;
layout(location = 2) in vec4 vFx;
layout(location = 3) in vec2 vSize;
layout(location = 0) out vec4 fragColor;

// @@INCLUDE particles_ubo.glsl

void main() {
    vec2 q = vec2(vQuad.x * vSize.x, vQuad.y * vSize.y);      // px: along the travel (the head at +x) and across it
    float L = vFx.x;
    float R = vFx.y;
    float H = max(vFx.z, 0.3);
    float heat = vFx.w;
    bool dk = cfgLook.x > 0.5;
    float aa = 0.5 / max(cfgLook.y, 1.0);                     // half a device pixel, in item px

    // the spine runs tail -> head; the radius tapers from half of R at the tail to R at the head, the
    // head is round
    float t = L > 0.01 ? clamp((q.x + L) / (2.0 * L), 0.0, 1.0) : 1.0;
    float rad = R * mix(0.45, 1.0, t);
    float d = length(q - vec2(clamp(q.x, -L, L), 0.0)) - rad;
    float body = 1.0 - smoothstep(-aa, aa, d);
    float inten = mix(0.22, 1.0, t * t);
    float halo = exp(-max(d, 0.0) / H) * mix(0.05, 0.30, t);

    vec3 base = vCol.rgb;
    vec3 coreCol = dk ? mix(base, vec3(1.0), 0.20 + 0.55 * heat) : mix(base, base * 0.66, 0.30 + 0.70 * heat);
    float aBody = body * inten;
    float aHalo = halo * (1.0 - aBody);
    float a = clamp((aBody + aHalo) * 1.2, 0.0, 1.0);
    vec3 col = (coreCol * aBody + base * aHalo) / max(aBody + aHalo, 1e-4);
    a *= vCol.a;
    float add = dk ? 0.50 : 0.0;
    fragColor = vec4(col * a, a * (1.0 - add * aBody)) * qt_Opacity;
}

#version 440

// =============================================================================
// silicon_board.vert -- Qt Quick's own ShaderEffect vertex shader, written out (the same two lines: the texture coordinate through, the
// corner through qt_Matrix), for ONE reason: a ShaderEffect with no vertex shader of its own takes Qt's built-in one, which exists in GLSL
// 100 es / 120 / 150 only, and Qt 6.12 links a pipeline at the highest GLSL ES version EVERY stage has -- so on NVIDIA's OpenGL ES 3.2 context
// (dGPU-only mode, where Qt takes ES on purpose) the board was linked at GLSL ES 1.00: no `textureLod` without GL_EXT_shader_texture_lod, no
// constant array, no indexing a local array by a loop's arithmetic, and it drew nothing at all (the 2026-11-11 screenshot: the glows, no board).
// With a vertex shader that has a 300 es variant the pair links at GLSL ES 3.00, where all of that is the language. Where the pipeline was
// not ES (the Intel GPU: 150 / 120) the picture is the same bytes: the vertex math is the built-in's.
// The uniform block is the fragment stage's, copied whole by tools/dev/silicon_shader_gen.js (the fragment stage's template is the one place).
// =============================================================================

layout(location = 0) in vec4 qt_Vertex;
layout(location = 1) in vec2 qt_MultiTexCoord0;

layout(location = 0) out vec2 qt_TexCoord0;

// @@BOARD_UBO

out gl_PerVertex { vec4 gl_Position; };

void main() {
    qt_TexCoord0 = qt_MultiTexCoord0;
    gl_Position = qt_Matrix * qt_Vertex;
}

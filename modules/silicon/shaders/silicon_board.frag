    return anyHit(ro, inv, mn + vec3(clamp(ka, k0, k1) * px, 0.0, 0.0), mn + vec3(clamp(ka, k0, k1) * px, 0.0, 0.0) + sz) || anyHit(ro, inv, mn + vec3(clamp(ka + 1.0 * st, k0, k1) * px, 0.0, 0.0), mn + vec3(clamp(ka + 1.0 * st, k0, k1) * px, 0.0, 0.0) + sz) || anyHit(ro, inv, mn + vec3(clamp(ka + 2.0 * st, k0, k1) * px, 0.0, 0.0), mn + vec3(clamp(ka + 2.0 * st, k0, k1) * px, 0.0, 0.0) + sz);
}
void gridHitX3C(vec3 ro, vec3 rd, vec3 inv, vec3 mn, vec3 sz, float px, float n, float info) {
    vec3 tmin = (mn + vec3((n - 1.0) * px + sz.x, sz.y, sz.z) - ro) * inv;
    vec3 tmax = (mn - ro) * inv;
    float tn = max(max(tmin.x, tmin.y), tmin.z);
    float tf = min(min(tmax.x, tmax.y), tmax.z);
    if (!(tn <= tf) || tn >= hT)
        return;
    float k0; float k1; float ka;
    float st = rd.x < 0.0 ? -1.0 : 1.0;
    rowSpan(ro.x + rd.x * tf - mn.x, ro.x + rd.x * tn - mn.x, sz.x, px, n, st, k0, k1, ka);
    float ya = (mn.y + sz.y - ro.y) * inv.y;
    float yb = (mn.y - ro.y) * inv.y;
    float za = (mn.z + sz.z - ro.z) * inv.z;
    float zb = (mn.z - ro.z) * inv.z;
    float sa = max(ya, za);
    float sb = min(yb, zb);
    {
        float ci = clamp(ka, k0, k1);
        float cv = mn.x + ci * px;
        float xa = (cv + sz.x - ro.x) * inv.x;
        float xb = (cv - ro.x) * inv.x;
        float tnc = max(xa, sa);
        if (tnc <= min(xb, sb) && tnc < hT) {
            hT = tnc;
            hInfo = info + (xa >= ya && xa >= za ? 0.0 : (ya >= za ? 1.0 : 2.0));
            hMin = vec3(cv, mn.y, mn.z);
            hMax = vec3(cv + sz.x, mn.y + sz.y, mn.z + sz.z);
        }
    }
    {
        float ci = clamp(ka + 1.0 * st, k0, k1);
        float cv = mn.x + ci * px;
        float xa = (cv + sz.x - ro.x) * inv.x;
        float xb = (cv - ro.x) * inv.x;
        float tnc = max(xa, sa);
        if (tnc <= min(xb, sb) && tnc < hT) {
            hT = tnc;
            hInfo = info + (xa >= ya && xa >= za ? 0.0 : (ya >= za ? 1.0 : 2.0));
            hMin = vec3(cv, mn.y, mn.z);
            hMax = vec3(cv + sz.x, mn.y + sz.y, mn.z + sz.z);
        }
    }
    {
        float ci = clamp(ka + 2.0 * st, k0, k1);
        float cv = mn.x + ci * px;
        float xa = (cv + sz.x - ro.x) * inv.x;
        float xb = (cv - ro.x) * inv.x;
        float tnc = max(xa, sa);
        if (tnc <= min(xb, sb) && tnc < hT) {
            hT = tnc;
            hInfo = info + (xa >= ya && xa >= za ? 0.0 : (ya >= za ? 1.0 : 2.0));
            hMin = vec3(cv, mn.y, mn.z);
            hMax = vec3(cv + sz.x, mn.y + sz.y, mn.z + sz.z);
        }
    }
}



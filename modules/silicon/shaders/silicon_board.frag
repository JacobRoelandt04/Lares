        return;
    float k0; float k1; float ka;
    float st = rd.z < 0.0 ? -1.0 : 1.0;
    rowSpan(ro.z + rd.z * tf - mn.z, ro.z + rd.z * tn - mn.z, sz.z, pz, n, st, k0, k1, ka);
    float xa = (mn.x + sz.x - ro.x) * inv.x;

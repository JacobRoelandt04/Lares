// (ao at p, ao with the lamp-ward point `sh` away) -- the second only when `two` is 2. ONE loop over the rows and, when asked, the second sample's rows after the first's:
// no loop inside a loop, and the rows are read where they are used
vec2 sceneAo(vec2 p, vec2 sh, int lvl, int two) {
    vec2 a = vec2(1.0);
    int i0 = lvl == 0 ? 0 : (lvl == 1 ? 31 : (lvl == 2 ? 62 : 71));
    int n = (lvl == 0 ? 31 : (lvl == 1 ? 31 : (lvl == 2 ? 9 : 4)));
    for (int j = 0; j < n * two; j++) {
        int k = j >= n ? 1 : 0;
        int i = i0 + j - k * n;
        vec4 r = AO_R[i];
        vec3 c = AO_C[i];
        vec2 pS = k == 0 ? p : p + sh;
        // the point each class takes (aoSize): the middle and the small class 1.2 mm toward the lamp (the shadow a 2 mm part casts), the tall class all of the shift;
        // the package's own frame turns its contact shadow with it. Made where they are asked: held across the loop they were registers the loop spilled
        vec2 at = c.z < 0.5 ? p : (c.z < 1.5 ? mix(p, pS, 0.55) : (c.z < 3.5 && c.z > 2.5 ? rotYAbout(vec3(pS.x, 0.0, pS.y), -gPkgTurn).xz : pS));
        float v = aoRect(at, r, c.x, c.y);
        if (c.z > 2.5)
            v = mix(v, 1.0, c.z < 3.5 ? clamp(gPkgLift / 12.0, 0.0, 1.0) : clamp(max(gCardLift / 30.0, 1.0 - gCardA), 0.0, 1.0));
        if (k == 0)
            a.x *= v;
        else
            a.y *= v;
    }
    return a;
}

// ---- traces: nearest signed distance (mm, < 0 inside), its kind, its arc length from `from`, its half width there ----
float tD; int tKind; int tId; float tArc; float tHalf; float tLr;
float tNear;      // the nearest SINGLE stretch's distance: it names the trace (tKind, tId, tArc, tHalf); tD may be a blend of several
// dl is a trace's own field: x the signed distance, yz its gradient direction (away from the copper's centre line)
void seg(vec2 p, vec2 a, vec2 b, float hw0, float hw1, float cum, int kind, int id, inout vec3 dl) {
    vec2 ab = b - a;
    float l2 = max(dot(ab, ab), 1e-6);
    float t = clamp(dot(p - a, ab) / l2, 0.0, 1.0);
    float hw = mix(hw0, hw1, t);                     // a stretch may narrow along itself
    vec2 r = p - a - ab * t;
    float lr = length(r);
    float dd = lr - hw;
    if (dd < dl.x) dl = vec3(dd, lr > 1e-5 ? r / lr : vec2(0.0, 1.0));
    if (dd < tNear) { tNear = dd; tKind = kind; tLr = lr; tId = id; tArc = cum + t * sqrt(l2); tHalf = hw; }
}
void segB(vec2 p, vec2 a, vec2 b, float hw0, float hw1, inout vec4 dl, inout float dh) {
    vec2 ab = b - a;
    float l2 = max(dot(ab, ab), 1e-6);
    float t = clamp(dot(p - a, ab) / l2, 0.0, 1.0);
    float hw = mix(hw0, hw1, t);                     // a stretch may narrow along itself
    vec2 r = p - a - ab * t;
    float lr = length(r);
    float dd = lr - hw;
    if (dd < dl.x) { dl = vec4(dd, r, lr); dh = hw; }
}
// The smooth union of two traces' fields over k mm (a polynomial smooth minimum; BLEND_K, or a group's own: the T's fillets reach further):
// traces that come closer
// than that melt into one body, and where they are farther apart nothing changes. A fillet belongs in a CROTCH,
// where the two contours face one another; where they run the same way (lanes that start on top of one another,
// or one landing in another) a plain smooth minimum would swell the body, so the fillet scales with how far
// apart the two gradients point: 0 when they agree, 1 when they oppose.
vec3 blendUnion(vec3 A, vec3 B, float k) {
    float h = max(k - abs(A.x - B.x), 0.0) / k;
    float opp = 0.5 * (1.0 - dot(A.yz, B.yz));
    return vec3(min(A.x, B.x) - h * h * k * 0.25 * opp, A.x < B.x ? A.yz : B.yz);
}

        float zb = (cv - ro.z) * inv.z;
        float tnc = max(sa, za);
        if (tnc <= min(sb, zb) && tnc < hT) {
            hT = tnc;
            hInfo = info + (xa >= ya && xa >= za ? 0.0 : (ya >= za ? 1.0 : 2.0));
            hMin = vec3(mn.x, mn.y, cv);
            hMax = vec3(mn.x + sz.x, mn.y + sz.y, cv + sz.z);

            nrm = vec3(0.0, 1.0, 0.0);
        }
    }
    if (found) {
        hT = best; hN = nrm; hInfo = info + 3.0; hMin = bmin; hMax = bmax;
    }
}
// does anything of the cylinder lie between ro and (a long way along) rd
bool anyHitCylY(vec3 ro, vec3 rd, float cx, float cz, float r, float y0, float y1) {
    vec2 oc = ro.xz - vec2(cx, cz);
    float a = dot(rd.xz, rd.xz);
    float bq = dot(oc, rd.xz);
    float cq = dot(oc, oc) - r * r;
    float tn = -1e9, tf = 1e9;
    if (a < 1e-8) {
        if (cq > 0.0) return false;
    } else {
        float D = bq * bq - a * cq;
        if (D <= 0.0) return false;
        float sq = sqrt(D);
        tn = (-bq - sq) / a;
        tf = (-bq + sq) / a;
    }
    float t0 = (y0 - ro.y) / rd.y, t1 = (y1 - ro.y) / rd.y;
    tn = max(tn, min(t0, t1));
    tf = min(tf, max(t0, t1));
    return tn <= tf && tf > 0.02;
}

// A ROW: identical boxes ('n' cells at 'pitch' along ONE axis, the first at 'mn', each 'sz' big) as ONE primitive. The ray's footprint over the
// row's box names the cells it can touch (k0 .. k1); the first K it meets are tested, K fixed (rowCells: how many one ray can touch -- its path through the
// row's box is as long sideways as the box is high), straight-line code with no loop: a shader compiles control flow dearly and straight-line arithmetic cheaply.
// The Z functions take a row along z, the X functions one along x; the Cyl ones draw each cell as its inscribed cylinder.
void rowSpan(float lo, float hi, float sz, float pitch, float n, float step, out float k0, out float k1, out float ka) {
    k0 = max(ceil((lo - sz) / pitch), 0.0);
    k1 = min(floor(hi / pitch), n - 1.0);
    ka = step < 0.0 ? k1 : k0;                       // the end the ray enters at
}
// the ray's span in a box (tn, tf); false when it misses (or it is behind us)
bool rowBox(vec3 ro, vec3 inv, vec3 mn, vec3 mx, out float tn, out float tf) {
    vec3 t1 = (mn - ro) * inv;
    vec3 t2 = (mx - ro) * inv;
    vec3 tmin = min(t1, t2);
    vec3 tmax = max(t1, t2);
    tn = max(max(tmin.x, tmin.y), tmin.z);
    tf = min(min(tmax.x, tmax.y), tmax.z);
    return tn <= tf && tf > 0.0;
}
void gridHitZ1C(vec3 ro, vec3 rd, vec3 inv, vec3 mn, vec3 sz, float pz, float n, float info) {
    vec3 tmin = (mn + vec3(sz.x, sz.y, (n - 1.0) * pz + sz.z) - ro) * inv;
    vec3 tmax = (mn - ro) * inv;
    float tn = max(max(tmin.x, tmin.y), tmin.z);
    float tf = min(min(tmax.x, tmax.y), tmax.z);
    if (!(tn <= tf) || tn >= hT)
        return;
    float k0; float k1; float ka;
    float st = rd.z < 0.0 ? -1.0 : 1.0;
    rowSpan(ro.z + rd.z * tf - mn.z, ro.z + rd.z * tn - mn.z, sz.z, pz, n, st, k0, k1, ka);
    float xa = (mn.x + sz.x - ro.x) * inv.x;
    float xb = (mn.x - ro.x) * inv.x;
    float ya = (mn.y + sz.y - ro.y) * inv.y;
    float yb = (mn.y - ro.y) * inv.y;
    float sa = max(xa, ya);
    float sb = min(xb, yb);
    {
        float ci = clamp(ka, k0, k1);
        float cv = mn.z + ci * pz;
        float za = (cv + sz.z - ro.z) * inv.z;
        float zb = (cv - ro.z) * inv.z;
        float tnc = max(sa, za);
        if (tnc <= min(sb, zb) && tnc < hT) {
            hT = tnc;
            hInfo = info + (xa >= ya && xa >= za ? 0.0 : (ya >= za ? 1.0 : 2.0));
            hMin = vec3(mn.x, mn.y, cv);
            hMax = vec3(mn.x + sz.x, mn.y + sz.y, cv + sz.z);
        }
    }
}
void gridHitX1C(vec3 ro, vec3 rd, vec3 inv, vec3 mn, vec3 sz, float px, float n, float info) {
    vec3 tmin = (mn + vec3((n - 1.0) * px + sz.x, sz.y, sz.z) - ro) * inv;
    vec3 tmax = (mn - ro) * inv;
    float tn = max(max(tmin.x, tmin.y), tmin.z);
    float tf = min(min(tmax.x, tmax.y), tmax.z);
    if (!(tn <= tf) || tn >= hT)
        return;
    float k0; float k1; float ka;
    float st = rd.x < 0.0 ? -1.0 : 1.0;
    rowSpan(ro.x + rd.x * tf - mn.x, ro.x + rd.x * tn - mn.x, sz.x, px, n, st, k0, k1, ka);
    float ya = (mn.y + sz.y - ro.y) * inv.y;
    float yb = (mn.y - ro.y) * inv.y;
    float za = (mn.z + sz.z - ro.z) * inv.z;
    float zb = (mn.z - ro.z) * inv.z;
    float sa = max(ya, za);
    float sb = min(yb, zb);
    {
        float ci = clamp(ka, k0, k1);
        float cv = mn.x + ci * px;
        float xa = (cv + sz.x - ro.x) * inv.x;
        float xb = (cv - ro.x) * inv.x;
        float tnc = max(xa, sa);
        if (tnc <= min(xb, sb) && tnc < hT) {
            hT = tnc;
            hInfo = info + (xa >= ya && xa >= za ? 0.0 : (ya >= za ? 1.0 : 2.0));
            hMin = vec3(cv, mn.y, mn.z);
            hMax = vec3(cv + sz.x, mn.y + sz.y, mn.z + sz.z);
        }
    }
}



    inv = 1.0 / d;
    if (slabHit(o, inv, vec3(-29.61, -0.01, -25.61), vec3(30.01, 4.61, 23.01))) {
        r = max(r, anyHitCylY(o, d, -8.0, -24.0, 1.6, 0.0, 1.6) ? 1.0 : 0.0);

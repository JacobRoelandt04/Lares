        { // jackLine, 5.1 mm
            vec3 dl = vec3(1e9, 0.0, 1.0);
            if (p.x > 15.1 && p.x < 27.0 && p.y > -7.2 && p.y < -0.4) {
                segF(p, vec2(18.5, -3.8), vec2(23.6, -3.8), 0.4, 0.4, 0.0, 2, 1, vec2(24.25, 0.0), vec2(29.35, 0.0), vec2(1.0, 1.0), dl);
            }
            dg = blendUnion(dg, dl, 0.6);
        }
        { // memLine, 3.4 mm
            vec3 dl = vec3(1e9, 0.0, 1.0);
            if (p.x > 4.0 && p.x < 10.8 && p.y > -1.3 && p.y < 8.9) {
                segF(p, vec2(7.4, 5.5), vec2(7.4, 2.1), 0.4, 0.4, 0.0, 2, 2, vec2(3.85, 0.0), vec2(7.25, 0.0), vec2(1.0, 1.0), dl);

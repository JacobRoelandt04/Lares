// ---- the 7-segment displays (AerialGeometry SEG7) ----
const float SEG_H = 1.3;
const vec2 SEG_CELL = vec2(2.3, 4.6);            // a digit's width and height, mm
const float SEG_STROKE = 0.62;
const float SEG_GAP = 0.27;
const float SEG_PITCH = 3.35;
const float SEG_COLON_GAP = 1.5;
const float SEG_PAD = 0.8;
#define SEG_COUNT 2
int segIndexOf(int part) {

        { // busRight, 40.2228 mm
            vec3 dl = vec3(1e9, 0.0, 1.0);
            if (p.x > 0.15 && p.x < 22.8 && p.y > -22.8 && p.y < 8.9) {
                segF(p, vec2(3.55, 5.5), vec2(18.5, 5.5), 0.4, 0.4, 0.0, 2, 0, vec2(0.0, 0.0), vec2(14.95, 0.0), vec2(1.0, 0.0), dl);
                segF(p, vec2(18.5, 5.5), vec2(18.5, -18.5), 0.4, 0.4, 14.95, 2, 0, vec2(14.95, 0.0), vec2(38.95, 0.0), vec2(0.0, 0.0), dl);
                segF(p, vec2(18.5, -18.5), vec2(19.4, -19.4), 0.4, 0.4, 38.95, 2, 0, vec2(38.95, 0.0), vec2(40.2228, 0.0), vec2(0.0, 1.0), dl);

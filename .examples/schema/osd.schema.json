    },
    "layout": {
     "type": "object",
     "additionalProperties": false,
     "properties": {
      "route": {
       "enum": [
        "osd",
        "notification",
        "off"
       ],
       "default": "osd",
       "x-wants": "\"osd\", \"notification\" or \"off\"",

       "x-wants": "a list of words (\"connected\", \"lost\", \"failed\" or \"wired\")",
       "description": "Takes a list of words (\"connected\", \"lost\", \"failed\" or \"wired\")."
      }
     }
    },
    "vpn": {
     "type": "object",
     "additionalProperties": false,
     "properties": {

       "minimum": 0,
       "maximum": 600000,
       "default": 0,
       "x-wants": "a whole number 0 .. 600000",
       "description": "Takes a whole number 0 .. 600000. Default: 0."
      }
     },
     "description": "aerial's two cards: the tunnel it raised by itself on a Public network (auto-tunnel), and a Bluetooth device's battery at 20 % / 10 % (a card only: nothing is posted)"
    },
    "btLow": {
     "type": "object",
     "additionalProperties": false,
     "properties": {
      "route": {
       "enum": [
        "osd",
        "notification",

     "type": "object",
     "additionalProperties": false,
     "properties": {
      "route": {
       "enum": [
        "osd",
        "notification",
        "off"
       ],
       "default": "osd",
       "x-wants": "\"osd\", \"notification\" or \"off\"",
       "description": "Takes \"osd\", \"notification\" or \"off\". Default: \"osd\"."
      },
      "ms": {
       "type": "integer",
       "minimum": 0,
       "maximum": 600000,
       "default": 0,
       "x-wants": "a whole number 0 .. 600000",
       "description": "Takes a whole number 0 .. 600000. Default: 0."
      }
     }
    },
    "lockkeys": {
     "type": "object",
     "additionalProperties": false,
     "properties": {
      "route": {
       "enum": [
        "osd",
        "notification",
        "off"
       ],
       "default": "osd",
       "x-wants": "\"osd\", \"notification\" or \"off\"",
       "description": "Takes \"osd\", \"notification\" or \"off\". Default: \"osd\"."
      },
      "ms": {
       "type": "integer",
       "minimum": 0,
       "maximum": 600000,
       "default": 0,
       "x-wants": "a whole number 0 .. 600000",
       "description": "Takes a whole number 0 .. 600000. Default: 0."
      }

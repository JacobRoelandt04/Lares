{ "format": "llm-tool-family/1",
  "name": "hyprctl",
  "label": "Hyprland: windows, workspaces, monitors",
  "kind": "read",
  "description": "The Hyprland compositor on this machine: workspaces, windows, monitors. Read actions return JSON and run freely; dispatch actions ask the user. A window is named by its address from clients (e.g. 0x55e7a8b64190). A reply other than 'ok' from a dispatch action is a failure.",
  "glyph": "",
  "exec": ["hyprctl"],
  "readForbidden": ["dispatch", "keyword", "setprop", "kill", "reload", "output", "plugin", "seterror", "setcursor", "switchxkblayout", "eval", "notify", "dismissnotify"],
  "timeoutMs": 5000, "outputCap": 32768,
  "actions": {
    "clients":          { "kind": "read", "argv": ["-j", "clients"],          "description": "every open window: address, class, title, workspace {id,name}, pid, floating, fullscreen, focusHistoryID (0 = focused)", "summary": "list the open windows", "progress": "listing windows", "outputCap": 65536 },
    "active_window":    { "kind": "read", "argv": ["-j", "activewindow"],     "description": "the focused window", "summary": "look at the focused window", "progress": "reading the focused window" },
    "workspaces":       { "kind": "read", "argv": ["-j", "workspaces"],       "description": "every workspace: id, name, monitor, windows count, lastwindow", "summary": "list the workspaces", "progress": "listing workspaces" },
    "active_workspace": { "kind": "read", "argv": ["-j", "activeworkspace"],  "description": "the active workspace", "summary": "look at the active workspace", "progress": "reading the workspace" },
    "monitors":         { "kind": "read", "argv": ["-j", "monitors"],         "description": "every monitor: name, width, height, refreshRate, x, y, scale, activeWorkspace", "summary": "list the monitors", "progress": "listing monitors" },
    "focus_workspace":  { "kind": "act", "allow": "action",
                          "parameters": { "n": { "type": "integer", "minimum": 1, "maximum": 10, "description": "workspace number" } }, "required": ["n"],
                          "argv": ["dispatch", "hl.dsp.focus({ workspace = {n} })"],
                          "description": "switch to workspace n", "summary": "switch to workspace {n}", "progress": "switching workspace" },
    "move_window_to_workspace": { "kind": "act", "allow": "action",
                          "parameters": { "n": { "type": "integer", "minimum": 1, "maximum": 10, "description": "workspace number" }, "follow": { "type": "boolean", "default": false, "description": "also switch to that workspace" } }, "required": ["n"],
                          "argv": ["dispatch", "hl.dsp.window.move({ workspace = {n}, follow = {follow=false} })"],
                          "description": "move the FOCUSED window to workspace n (focus a window first with focus_window)", "summary": "move the focused window to workspace {n}", "progress": "moving a window" },
    "focus_window":     { "kind": "act", "allow": "action",
                          "parameters": { "address": { "type": "string", "pattern": "^0x[0-9a-f]{6,16}$", "description": "the window's address from clients" } }, "required": ["address"],
                          "argv": ["dispatch", "hl.dsp.focus({ window = \"address:{address}\" })"],
                          "description": "focus the window with this address", "summary": "focus window {address}", "progress": "focusing a window" },
    "close_window":     { "kind": "act", "allow": "never",
                          "argv": ["dispatch", "hl.dsp.window.close()"],
                          "description": "close the FOCUSED window (asks every time)", "summary": "close the focused window", "progress": "closing a window" },
    "toggle_floating":  { "kind": "act", "allow": "action", "argv": ["dispatch", "hl.dsp.window.float()"],
                          "description": "toggle floating on the focused window", "summary": "toggle floating on the focused window", "progress": "toggling floating" },
    "fullscreen":       { "kind": "act", "allow": "action", "argv": ["dispatch", "hl.dsp.window.fullscreen()"],
                          "description": "toggle fullscreen on the focused window", "summary": "toggle fullscreen", "progress": "toggling fullscreen" },
    "toggle_special":   { "kind": "act", "allow": "action", "argv": ["dispatch", "hl.dsp.workspace.toggle_special(\"default\")"],
                          "description": "show or hide the special (scratch) workspace", "summary": "toggle the special workspace", "progress": "toggling the scratchpad" },
    "notify":           { "kind": "act", "allow": "tool",
                          "parameters": { "text": { "type": "string", "maxLength": 200, "description": "the text to show" } }, "required": ["text"],
                          "argv": ["notify", "-1", "4000", "0", "{text}"],
                          "description": "show a short Hyprland on-screen notification", "summary": "show \"{text}\" on screen", "progress": "notifying" }
  } }

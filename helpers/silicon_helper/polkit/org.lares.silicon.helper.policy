<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<!-- Installed by silicon's install.sh. pkexec picks this action by the program's path
     (org.freedesktop.policykit.exec.path), whatever its arguments are: the helper validates
     every argument itself. Without the companion rule (50-lares-silicon-helper.rules)
     this asks for an administrator, as any pkexec program does. -->
<policyconfig>
  <vendor>Lares silicon</vendor>
  <action id="org.lares.silicon.helper">
    <description>Change the CPU power profile, the battery charge limit or the GPU mode</description>
    <message>Authentication is required to change the power settings of this computer</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/libexec/silicon-helper</annotate>
  </action>
</policyconfig>
